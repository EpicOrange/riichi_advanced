set display_name, "Shenyang"
set tutorial_link, "https://peterish.com/riichi-docs/shenyang-mahjong-rules/"

define_global han, "Fan"
define_global ankan_name, "Angang"
define_global chii_name, "Chi"
define_global pon_name, "Peng"
define_global kan_name, "Gang"
define_global ron_name, "Hu"
define_global tsumo_name, "Zimo"
define_global chankan_name, "Hu"

require "value_honors"
