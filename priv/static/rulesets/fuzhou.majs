set display_name, "Fuzhou"
set tutorial_link, "https://github.com/EpicOrange/riichi_advanced/blob/main/documentation/fuzhou.md"
define_global han, ""
define_global ankan_name, "Self Kong"
define_global chankan_name, "Hu"
define_global chii_name, "Chow"
define_global pon_name, "Pung"
define_global kan_name, "Kong"
define_global flower_name, "Flower"
define_global ron_name, "Hu"
define_global tsumo_name, "Zimo"
require "standard_sets"
require "base"
require "standard_wall"
require "framed_5z"
require "global_mods"
require "default_auto_buttons"
require "chii"
require "pon"
require "kan", %{hide_ankans: false, replace_from_dead_wall: true, shift_dead_wall: true}
require "ron", %{scoring_key: "win"}
require "tsumo", %{scoring_key: "win"}
require "agarirenchan"
require "head_bump"
require "default_flowers", %{draw_after_flower_phase: true, auto_flower_by_default: true, undiscardable: true, replace_from_dead_wall: true, shift_dead_wall: true}

on after_initialization do
  add_rule("Rules", "Win Condition", "You may win with one of the following:", -100)
  add_rule("Rules", "Win Condition", "- Five sets (sequences or triplets) and a pair.", -100)
  add_rule("Rules", "Gold", "After all flowers have been declared, the \"gold tile\" is revealed (top left).")
  add_rule("Rules", "Gold", "When the gold tile is revealed, if it is your winning tile, you may instantly declare a win off it (Qiangjin).")
  add_rule("Rules", "Gold", "Otherwise, the gold tile is a joker for any tile, but it cannot be used in calls.")
  add_rule("Rules", "Gold", "If you discard a gold tile, you may only win by self-draw.")
  add_rule("Rules", "Flowers", "All honour tiles are flowers.")
  add_rule("2", "Flower Points", "You get 2 points per flower tile.")
  add_rule("2", "Gold Points", "You get 2 points per gold tile.")
  add_rule("2", "Dealer Continuation", "The dealer gets 2 points for each dealer continuation.")
  add_rule("2", "Open Kong", "You get 2 points per open kong.")
  add_rule("10", "Base", "You get 10 points for winning.")
  add_rule("10", "All Sequences", "You have five sequences and a pair.")
  add_rule("12", "Full Bloom", "Declaring all four of a given type of flower gives 12 points per set.")
  add_rule("15", "One Flower", "Your hand has exactly one flower.")
  add_rule("20", "Golden Pair", "Your pair is made of two gold tiles.")
  add_rule("30", "Three Gold Knockdown", "Your hand contains all three gold tiles.")
  add_rule("40", "Golden Dragon", "Your hand contains three gold tiles as a triplet.")
  add_rule("40", "Blessing of Earth", "A non-dealer player won on their first draw.")
  add_rule("50", "Robbing the Gold", "You declared a win off the gold tile when it was revealed.")
  add_rule("50", "Blessing of Heaven", "The dealer won on their first draw.")
end

set interruptible_actions, ["play_tile", "draw", "advance_turn", "upgrade_call"]
set display_honba, true
set display_wall, true
set initial_score, 0
set initial_dead_wall_length, 18
set starting_tiles, 16

apply merge, "dora_indicators", %{
  "1m": ["1m"], "2m": ["2m"], "3m": ["3m"], "4m": ["4m"], "5m": ["5m"], "6m": ["6m"], "7m": ["7m"], "8m": ["8m"], "9m": ["9m"], "0m": ["5m"],
  "1p": ["1p"], "2p": ["2p"], "3p": ["3p"], "4p": ["4p"], "5p": ["5p"], "6p": ["6p"], "7p": ["7p"], "8p": ["8p"], "9p": ["9p"], "0p": ["5p"],
  "1s": ["1s"], "2s": ["2s"], "3s": ["3s"], "4s": ["4s"], "5s": ["5s"], "6s": ["6s"], "7s": ["7s"], "8s": ["8s"], "9s": ["9s"], "0s": ["5s"],
  "1z": ["1z"], "2z": ["2z"], "3z": ["3z"], "4z": ["4z"], "0z": ["0z"], "6z": ["6z"], "7z": ["7z"],
  "1f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "2f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "3f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "4f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "1g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "2g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "3g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "4g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
}

on after_initialization do
  add_rule("Rules", "Win Condition", "- Five sets (sequences or triplets) and a pair.", -100)
end

# # we don't use this since jokers are expensive with 5 possible mentsu, see below
# define_const standard_tenpai, ~m"exhaustive, mentsu:4, taatsu:1, pair:1 | exhaustive, mentsu:5"
# define_const standard_win, ~m"exhaustive, mentsu:5, pair:1"
# apply set_append, "tenpai_definition", +@standard_tenpai
# apply set_append, "win_definition", +@standard_win

# optimization so we don't have to actually calculate jokers to match hands with them
# based on goal reduction theory: https://injusticejudge.com/2026/07/22/joker-theory
define_const gold_win, ~m"exhaustive, any@jin:-1, mentsu:5, taatsu:1"
define_const gold_tenpai, ~m"""
    exhaustive, any@jin:1, any@jin:-1, mentsu:5
  | exhaustive, any@jin:1, any@jin:-1, mentsu:4, taatsu:1, pair:1
  """
define_const gold_iishanten, ~m"""
    exhaustive, any@jin:2, any@jin:-1, mentsu:4, taatsu:1
  | exhaustive, any@jin:2, any@jin:-1, mentsu:3, taatsu:2, pair:1
  """
define_const gold_ryanshanten, ~m"""
    exhaustive, any@jin:3, any@jin:-1, mentsu:4
  | exhaustive, any@jin:3, any@jin:-1, mentsu:3, taatsu:2 
  | exhaustive, any@jin:3, any@jin:-1, mentsu:2, taatsu:3, pair:1
  """
# define_const gold_sanshanten, ~m"""
#     exhaustive, any@jin:4, any@jin:-1, mentsu:3, pair:1
#   | exhaustive, any@jin:4, any@jin:-1, mentsu:2, taatsu:3
#   | exhaustive, any@jin:4, any@jin:-1, mentsu:1, taatsu:4, pair:1
#   """
apply set_append, "win_definition", +@gold_win
apply set_append, "win_definition", +@gold_tenpai
apply set_append, "win_definition", +@gold_iishanten
apply set_append, "win_definition", +@gold_ryanshanten
# replace tenpai check with a stub
define_match tenpai, ~m""
# qiangjin is just regular win
define_match qiangjin, ~m"exhaustive, mentsu:5, pair:1"

# to check for all sequences, do a similar thing
define_set pinghu_wait, ~s"0 1 | 0 2"
define_const pinghu_win, ~m"exhaustive, any@jin:-1, shuntsu:5, pair:1"
define_const pinghu_tenpai, ~m"""
    exhaustive, any@jin:1, any@jin:-1, shuntsu:5
  | exhaustive, any@jin:1, any@jin:-1, shuntsu:4, pinghu_wait:1, pair:1
  """
define_const pinghu_iishanten, ~m"""
    exhaustive, gold_pair:-1, any@jin:2, any@jin:-1, shuntsu:4, taatsu:1
  | exhaustive, gold_pair:-1, any@jin:2, any@jin:-1, shuntsu:3, pinghu_wait:2, pair:1
  """
define_const pinghu_ryanshanten, ~m"""
    exhaustive, gold_pair:-1, gold_koutsu:-1, any@jin:3, any@jin:-1, shuntsu:4
  | exhaustive, gold_pair:-1, gold_koutsu:-1, any@jin:3, any@jin:-1, shuntsu:3, pinghu_wait:1, taatsu:1 
  | exhaustive, gold_pair:-1, gold_koutsu:-1, any@jin:3, any@jin:-1, shuntsu:2, pinghu_wait:3, pair:1
  """
# define_const pinghu_sanshanten, ~m"""
#     exhaustive, any@jin:3, any@jin:-1, shuntsu:3, taatsu:1
#   | exhaustive, any@jin:3, any@jin:-1, shuntsu:2, pinghu_wait:2, taatsu:1
#   | exhaustive, any@jin:3, any@jin:-1, shuntsu:1, pinghu_wait:4, pair:1
#   """
apply set_append, "pinghu_definition", +@pinghu_win
apply set_append, "pinghu_definition", +@pinghu_tenpai
apply set_append, "pinghu_definition", +@pinghu_iishanten
apply set_append, "pinghu_definition", +@pinghu_ryanshanten

# Yaku

define_yaku yaku, "Base Points", [10, ""], true

on before_win do
  if seat_is("east") do dealer_continuation = honba end
  set_counter("flower_count", "count_matches", ["flowers"], ~m"any_flower:1")
  set_counter("gold_count", "count_matches", ["hand", "calls", "winning_tile", "flowers"], ~m"nojoker, any@jin:1")
  dealer_continuation_bonus = dealer_continuation * 2
  flower_bonus = flower_count * 2
  gold_bonus = gold_count * 2
end

define_yaku yaku, "Flowers", ["flower_bonus", ""], flower_count >= 1
define_yaku yaku, "Gold", ["gold_bonus", ""], gold_count >= 1
define_yaku yaku, "Three Gold Knockdown", [30, ""], gold_count >= 3
define_yaku yaku, "Dealer Continuation", ["dealer_continuation_bonus", ""], seat_is("east") and dealer_continuation_bonus >= 1

on before_win do
  if seat_is("east") do dealer_continuation = honba end
  set_counter("flower_count", "count_matches", ["flowers"], ["any_flower"])
  set_counter("gold_count", "count_matches", ["hand", "calls", "winning_tile", "flowers"], ~m"nojoker, any@jin:1")
end

on before_win do
  set_counter("minkans", "count_matches", ["calls"], ~m"(daiminkan kakan):1")
  set_counter("ankans", "count_matches", ["calls"], ~m"ankan:1")
  minkan_bonus = minkans * 2
  ankan_bonus = ankans * 2
end
define_yaku yaku, "Open Kongs", ["minkan_bonus", ""], minkan_bonus > 0
define_yaku yaku, "Concealed Kongs", ["ankan_bonus", ""], ankan_bonus > 0

define_yaku yaku, "Full Bloom (Flowers)", [12, ""], match(["flowers"], ~m"nojoker, unique, (1f 2f 3f 4f):4")
define_yaku yaku, "Full Bloom (Seasons)", [12, ""], match(["flowers"], ~m"nojoker, unique, (1g 2g 3g 4g):4")
define_yaku yaku, "Full Bloom (East)", [12, ""], match(["flowers"], ~m"nojoker, 1z:4")
define_yaku yaku, "Full Bloom (South)", [12, ""], match(["flowers"], ~m"nojoker, 2z:4")
define_yaku yaku, "Full Bloom (West)", [12, ""], match(["flowers"], ~m"nojoker, 3z:4")
define_yaku yaku, "Full Bloom (North)", [12, ""], match(["flowers"], ~m"nojoker, 4z:4")
define_yaku yaku, "Full Bloom (White)", [12, ""], match(["flowers"], ~m"nojoker, 0z:4")
define_yaku yaku, "Full Bloom (Green)", [12, ""], match(["flowers"], ~m"nojoker, 6z:4")
define_yaku yaku, "Full Bloom (Red)", [12, ""], match(["flowers"], ~m"nojoker, 7z:4")

define_yaku yaku, "All Sequences", [10, ""], match(["hand", "calls", "winning_tile"], ["pinghu"])

define_const all_flowers, ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g", "1z", "2z", "3z", "4z", "0z", "6z", "7z"]
define_set all_flowers, ~s"1f 2f 3f 4f 1g 2g 3g 4g 1z 2z 3z 4z 0z 6z 7z"
define_set any_flower, ~s"1f|2f|3f|4f|1g|2g|3g|4g|1z|2z|3z|4z|0z|6z|7z"
define_yaku yaku, "Only One Flower", [15, ""], match(["flowers"], ~m"nojoker, any_flower:1, any_flower:-1")

# old version
# define_set gold_pair, ~s"0@is_jin 0@is_jin"
# define_set gold_koutsu, ~s"0@is_jin 0@is_jin 0@is_jin"
# define_match golden_pair, ~m"exhaustive, (nojoker gold_pair):1, mentsu:5"
# define_match golden_dragon, ~m"exhaustive, (nojoker gold_koutsu):1, mentsu:4, pair:1"
# define_yaku yaku, "Golden Pair", [20, ""], match(["hand", "calls", "winning_tile"], ["golden_pair"])
