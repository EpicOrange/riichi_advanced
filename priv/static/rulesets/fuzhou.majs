define_set gold_pair, ~s"0@jin 0@jin"
define_set gold_koutsu, ~s"0@jin 0@jin 0@jin"
define_match golden_pair, ~m"exhaustive, gold_pair:1, mentsu:5"
define_match golden_dragon, ~m"exhaustive, gold_koutsu:1, mentsu:4, pair:1"
define_yaku yaku, "Golden Pair", [20, ""], match(["hand", "calls", "winning_tile"], ["golden_pair"])
define_yaku yaku, "Golden Dragon", [40, ""], match(["hand", "calls", "winning_tile"], ["golden_dragon"])

define_yaku yaku, "Robbing the Gold", [50, ""], status("qiangjin")

require "yaku/tenhou", %{tenhou_name: "Blessing of Heaven", tenhou_value: 50, chiihou_name: "Blessing of Earth", chiihou_value: 40, chiihou_is_tsumo: true}

apply merge, "yaku_precedence", %{
  "Golden Pair": ["Gold"],
  "Golden Dragon": ["All Sequences", "Three Gold Knockdown", "Golden Pair", "Gold"],
  "Three Gold Knockdown": ["Golden Pair", "Gold"],
  "Robbing the Gold": ["Blessing of Heaven", "Blessing of Earth"]
}

set score_calculation, %{
  "yaku_lists": ["yaku"],
  "agarirenchan": true,
  "point_name": "",
  "win_by_discard_label": "Hu",
  "win_by_draw_label": "Zimo",
  "win_by_discard_name": "Hu",
  "win_by_draw_name": "Zimo",
  "exhaustive_draw_name": "Draw"
}

# can't discard flowers
define_play_restriction flower, false
define_play_restriction "1z", false
define_play_restriction "2z", false
define_play_restriction "3z", false
define_play_restriction "4z", false
define_play_restriction "0z", false
define_play_restriction "6z", false
define_play_restriction "7z", false

define_play_effect dora, set_status("tsumo_only")

on after_start do
  # flip gold tile
  tag_dora("jin", -2)
  reveal_tile(-2)
  copy_tiles(%{dead_wall: [-2]}, %{atop_wall: [-9]})
  add_attr([-2], ["_skip_draw", "_hidden"])

  # check for qiangjin for all players
  as everyone do
    if match(["hand", "revealed_tiles"], ["qiangjin"]) do
      set_status("qiangjin")
    end
  end

  # add the "dora" attribute to tiles tagged with "jin", which should make them shiny
  # also adds the "jin" attribute needed to make it a joker upon a win
  add_attr_tagged("jin", ["_dora", "jin"])
end

on before_win, prepend: true do
  # sets any tile with attribute "jin" to be an any-joker with attribute "is_jin"
  # set_tile_alias_all([%{tile: "any", attrs: ["jin"]}], [%{tile: "any", attrs: ["is_jin"]}])
  # nvm turns out you can implement this without any joker logic :)
end

apply append, "buttons.start_flower.show_when", status("initial_flowers") and status_missing("qiangjin")
apply append, "buttons.flower.show_when", status_missing("initial_flowers") and status_missing("qiangjin")

apply append, "buttons.chii.call_conditions", not_call_contains(%{tile: "any", attrs: ["jin"]}, 1)
apply append, "buttons.pon.call_conditions", not_call_contains(%{tile: "any", attrs: ["jin"]}, 1)
apply append, "buttons.daiminkan.call_conditions", not_call_contains(%{tile: "any", attrs: ["jin"]}, 1)

# ankan moves two tiles
apply append, "buttons.ankan.actions" do shift_tile_to_dead_wall(1) end

apply append, "buttons.ron.show_when", status_missing("initial_flowers", "tsumo_only") and not_match(["last_discard"], ~m"any@jin:1")
apply append, "buttons.chankan.show_when", status_missing("initial_flowers", "tsumo_only") and not_match(["last_discard"], ~m"any@jin:1")
apply append, "buttons.tsumo.show_when", status_missing("initial_flowers")

on before_win do
  cond do
    won_by_draw -> make_responsible_for("others")
    won_by_discard -> make_responsible_for("last_discarder")
    won_by_call -> make_responsible_for("last_caller")
  end
end
define_scoring win do
  total = points :: "Score"
  set_counter_all("total", "total")
end

define_button qiangjin,
  display_name: "Qiangjin",
  show_when: status("initial_flowers", "qiangjin") and status_missing("flower"),
  precedence_over: ["start_flower", "start_no_flower"],
  unskippable: true
  do
    big_text("Qiangjin")
    pause(1000)
    move_tiles("revealed_tile", "draw")
    reveal_hand
    win_by_draw("win")
  end

define_button qiangjin_skip,
  display_name: "Skip",
  show_when: status("initial_flowers", "qiangjin") and status_missing("flower"),
  unskippable: true
  do
    unset_status("qiangjin")
    recalculate_buttons
  end

set default_mods, ["show_waits"]

define_mod forced_flowers, conflicts: ["discardable_flowers"], name: "Forced Flowers", desc: "Every drawn flower must be replaced immediately."
define_mod discardable_flowers, conflicts: ["forced_flowers"], name: "Discardable Flowers", desc: "You may discard flower tiles like normal tiles."
define_mod forbid_golden_flowers, name: "No Gold Flowers", desc: "The gold tile is determined by checking each tile in the dead wall until you find a non-flower tile. Flowers revealed in this process are given to the player whose wall is broken. If all nine tiles on the dead wall are flowers, then there is no gold tile for the round."
define_mod fuzhou_everyone_pays, name: "Everyone Pays On Discard", desc: "Non-discarders also pay for a win by discard."
define_mod reset_honba_on_draw, name: "Draws Reset Dealer Bonus", desc: "Reset the dealer continuation bonus on exhaustive draws. (The default behavior is to increase the bonus on a draw.)"
