set display_name, "Ningbo Mahjong"
set tutorial_link, "https://mahjongpros.com/blogs/how-to-play/beginners-guide-to-ningbo-mahjong-rules"

require "value_honors"
require "standard_sets"

define_global pon_name, "Pon"
define_global kan_name, "Kong"
define_global ankan_name, "Kong"
define_global flower_name, "Hua"
define_global ron_name, "Hu"
define_global chankan_name, "Hu"
define_global tsumo_name, "Zimo"
define_global han, "Tai"

require "base"
require "standard_wall"
require "framed_5z"
require "global_mods"
require "default_auto_buttons"
require "standard_win"
require "pon"
require "kan", %{hide_ankans: true}
require "ron", %{scoring_key: "win"}
require "tsumo", %{scoring_key: "win"}
require "min_han", %{min: 4}
require "yaku/chankan", %{name: "Robbing a Kong", value: 5, han: "×", scoring_key: "win"}
require "default_flowers", %{auto_flower_by_default: true, undiscardable: true, eight_value: 10, win_on: "8 flowers"}
require "yaku/honitsu", %{hon_name: "Half Flush", hon_value: 2, chin_name: "Pure Flush", chin_value: 4}
require "yaku/toitoi", %{name: "All Triplets", value: 2}
require "yaku/haitei", %{haitei_name: "Last Tile Win", houtei_name: "Last Tile Win", haitei_value: 1, houtei_value: 1}
require "yaku/rinshan", %{value: 1, name: "Kong Win"}
replace_yaku "yaku", "Kong Win", [1, "Tai", 2, "×"]
require "yaku/tsumo", %{name: "Self Draw", value: 1}
require "yaku/yakuhai", %{rules_name: "Value Pung"}
require "yaku/tsuuiisou", %{name: "All Honours", value: 10}
require "yaku/tenhou", %{chiihou_is_tsumo: false, chiihou_name: "Earthly Hand", chiihou_value: 10, tenhou_name: "Heavenly Hand", tenhou_value: 10}

define_match edge_wait, ~m"exhaustive, penchan:1, mentsu:3, pair:1"
define_match closed_wait, ~m"exhaustive, kanchan:1, mentsu:3, pair:1"
define_match single_wait, ~m"exhaustive, tanki:1, mentsu:4"
define_yaku yaku, "Edge Wait", [1, "Tai"], match(["hand", "calls", "winning_tile"], ["edge_wait"]), ["Single Wait"]
define_yaku yaku, "Closed Wait", [1, "Tai"], match(["hand", "calls", "winning_tile"], ["closed_wait"])
define_yaku yaku, "Single Wait", [1, "Tai"], match(["hand", "calls", "winning_tile"], ["single_wait"]), ["Closed Wait"]

define_yaku yaku, "Three Meld Penalty", [5, "×"],
  calls_from_shimocha >= 3 or
  calls_from_toimen >= 3 or
  calls_from_kamicha >= 3

define_yaku_precedence "All Honours", ["All Triplets", "Half Flush"]
define_yaku_precedence "Heavenly Hand", ["Self Draw"]

set score_calculation, %{
  yaku_lists: ["yaku", "yaku_multiplier"],
  point_name: "Tai",
  point2_name: "×",
  right_display: "points2",
  score_denomination: "",
  agarirenchan: true,
  win_by_discard_label: "Hu",
  win_by_discard_name: "Hu",
  win_by_draw_label: "Zimo",
  win_by_draw_name: "Zimo",
  exhaustive_draw_name: "Draw",
}

def flip_baida do
  tag_tiles("baida", [-2])
  tag_dora("baida", -2)
  reveal_tile(-2)
  add_attr([-2], ["_skip_draw", "_hidden"])
  add_attr_tagged("baida", ["_dora", "baida"])
  set_tile_alias_all([["any", "baida"]], [["any", "is_baida"]])
end
on after_start do flip_baida end

on after_call do
  # can't use e.g. shimocha_discarded or else flower calls will increment counter
  if seat_is("callee", as: "shimocha") do calls_from_shimocha += 1 end
  if seat_is("callee", as: "toimen") do calls_from_toimen += 1 end
  if seat_is("callee", as: "kamicha") do calls_from_kamicha += 1 end
end

on before_win do
  cond do
    calls_from_shimocha >= 3 -> make_responsible_for("shimocha", "all")
    calls_from_toimen >= 3 -> make_responsible_for("toimen", "all")
    calls_from_kamicha >= 3 -> make_responsible_for("kamicha", "all")
  end
end

define_const baida, [%{"tile": "any", "attrs": ["baida"]}]
apply set, "buttons.daiminkan.call_conditions", not_call_contains(@baida, 1)
apply set, "buttons.kakan.call_conditions", not_call_contains(@baida, 1)
apply set, "buttons.pon.call_conditions", not_call_contains(@baida, 1)

apply set, "buttons.daiminkan.call_priority_list", not_call_choice_contains(@baida, 1)
apply set, "buttons.pon.call_priority_list", not_call_choice_contains(@baida, 1)

apply set, "buttons.ankan.call_conditions",
  (not_call_contains(@baida, 1) or call_contains(@baida, 4))
  and not_call_contains(["1f","2f","3f","4f","1g","2g","3g","4g"], 4)

apply append, "buttons.ron.show_when", 
  has_yaku_with_discard(4, "Tai")
  or (has_yaku_with_discard(2, "Tai") and has_yaku_with_discard(2, "×"))
  or (has_yaku_with_discard(1, "Tai") and has_yaku_with_discard(4, "×"))

apply append, "buttons.chankan.show_when", 
  has_yaku_with_call(4, "Tai")
  or (has_yaku_with_call(2, "Tai") and has_yaku_with_call(2, "×"))
  or (has_yaku_with_call(1, "Tai") and has_yaku_with_call(4, "×"))

apply append, "buttons.tsumo.show_when", 
  has_yaku_with_hand(4, "Tai")
  or (has_yaku_with_hand(2, "Tai") and has_yaku_with_hand(2, "×"))
  or (has_yaku_with_hand(1, "Tai") and has_yaku_with_hand(4, "×"))

set dora_indicators, %{
  "1m": ["1m", "2m"], "2m": ["2m", "3m"], "3m": ["3m", "4m"], "4m": ["4m", "5m"], "5m": ["5m", "6m"], "6m": ["6m", "7m"], "7m": ["7m", "8m"], "8m": ["8m", "9m"], "9m": ["9m", "1m"], "0m": ["5m", "6m"],
  "1p": ["1p", "2p"], "2p": ["2p", "3p"], "3p": ["3p", "4p"], "4p": ["4p", "5p"], "5p": ["5p", "6p"], "6p": ["6p", "7p"], "7p": ["7p", "8p"], "8p": ["8p", "9p"], "9p": ["9p", "1p"], "0p": ["5p", "6p"],
  "1s": ["1s", "2s"], "2s": ["2s", "3s"], "3s": ["3s", "4s"], "4s": ["4s", "5s"], "5s": ["5s", "6s"], "6s": ["6s", "7s"], "7s": ["7s", "8s"], "8s": ["8s", "9s"], "9s": ["9s", "1s"], "0s": ["5s", "6s"],
  "1z": ["1z", "2z"], "2z": ["2z", "3z"], "3z": ["3z", "4z"], "4z": ["4z", "1z"], "0z": ["0z", "6z"], "6z": ["6z", "7z"],  "7z": ["7z", "0z"],
  "1f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "2f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "3f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "4f": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "1g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "2g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "3g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
  "4g": ["1f", "2f", "3f", "4f", "1g", "2g", "3g", "4g"],
}

set interruptible_actions, ["play_tile", "draw", "call", "self_call", "upgrade_call"]
set initial_score, 0
set starting_tiles, 13
set max_rounds, 16
set display_honba, true
set display_wall, true
set initial_dead_wall_length, 14

# welcome to the baida zone
define_set baida, ~s"any@is_baida"
define_set baida_pair, ~s"0@is_baida, 0@is_baida"
define_set baida_reuse, ~s"0@is_baida, 0@baida"
define_set baida_pair_win, ~s"0@is_baida&winning_tile, 0@is_baida"
on before_scoring do
  add_counter("baida_reuse", "count_matches", ["orig_hand", "hand", "orig_winning_tile", "winning_tile"], ~m"nojoker, baida_reuse:1")
end
define_yaku yaku, "No Baida", [1, "Tai"], not_match(["hand", "calls", "winning_tile"], ~m"baida:1")
define_yaku yaku, "Win On Baida", [1, "Tai"], match(["winning_tile"], ~m"baida:1")
define_yaku yaku, "Baida Reuse", ["baida_reuse", "Tai"], baida_reuse >= 1
define_yaku yaku, "Baida Pair Win", [1, "Tai"], won_by_draw and match(["hand", "calls", "winning_tile"], ~m"nojoker, baida_pair_win:1")

define_scoring win do
  total = points :: "Tai"
  if points2 > 0 do
    total *= points2 :: "×"
  end
end

on after_initialization do
  add_rule("Tiles", "Base Tiles", "By default, Ningbo mahjong uses the following 144 tiles:", -100)
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of circles %{pinzu}", %{pinzu: ~t"123456789p"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of bamboo %{souzu}", %{souzu: ~t"123456789s"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of characters %{manzu}", %{manzu: ~t"123456789m"})
  add_rule("Tiles", "Base Tiles", "- Four each of the four winds (East, South, West, North) %{winds}", %{winds: ~t"1234z"})
  add_rule("Tiles", "Base Tiles", "- Four each of the three dragons (White, Green, Red) %{dragons}", %{dragons: ~t"067z"})
  add_rule("Tiles", "Base Tiles", "- Four flowers %{flowers}", %{flowers: ~t"1234f"})
  add_rule("Tiles", "Base Tiles", "- Four seasons %{seasons}", %{seasons: ~t"1234g"})
  add_rule("Rules", "Instant Payouts", "Declaring kongs and declaring certain flower combinations award instant payouts.", -50)
  add_rule("Rules", "Baida", "Before the round begins, a tile in the wall is flipped to indicate the Baida tile for the round, i.e. the three other copies of the revealed tile. Baida tiles are wildcards. Using Baida tiles as their original tile value (not as a wildcard) scores 1 Tai each.")
  add_rule("1 Tai", "Edge Wait", "1 Tai for winning on an edge wait (12 waiting for 3, or 89 waiting for 7).")
  add_rule("1 Tai", "Closed Wait", "1 Tai for winning on an closed wait (e.g. 35 waiting for 4).")
  add_rule("1 Tai", "Single Wait", "1 Tai for winning on a pair wait (e.g. 3 waiting for 3).")
  add_rule("1 Tai", "Win On Baida", "1 Tai for the winning shape containing a Baida tile.")
  add_rule("1 Tai", "No Baida", "1 Tai for winning without any Baida tiles.")
  add_rule("1 Tai", "Win On Baida", "1 Tai for the winning shape containing a Baida tile.")
  add_rule("1 Tai", "Baida Reuse", "1 Tai for using a Baida tile as its original tile.")
  add_rule("1 Tai", "Baida Pair Win", "1 Tai for winning on a pair wait by drawing a Baida tile.")
end
