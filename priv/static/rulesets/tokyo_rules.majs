define_base_ruleset riichi
set display_name, "Tokyo Rules (c. 1957)"
set tutorial_link, "https://riichi.wiki/Tokyo_rules"
require "ryuukyokurenchan"
require "pao_standard"
require "pao_suukantsu"
require "pao_tsuuiisou"
require "pao_chinroutou"
require "min_han", %{min: 1}
require_after "partial_furiten", %{check_ryanmen: true}
require_after "tokyo_scoring"

set display_honba, true
set always_east_round, true
set max_rounds, 8
set initial_score, 20000

on after_initialization do
  add_rule("Rules", "Tontonsen", "The game consists of two east rounds.")
  delete_rule("Rules", "Multiple Ron")
  add_rule("Rules", "Head Bump", "If there are multiple winners, then the earliest winner in turn order gets the full payment for the hand, and the other winners get half each. As for riichi sticks, each winner first takes back their own riichi stick (if any) and any leftover riichi sticks is given to the first winner in turn order.")
  add_rule("Rules", "Fu", "(Tokyo Rules) Fu is not rounded.")
  add_rule("Rules", "Scoring", "Scores are rounded to the nearest 10, maxing out at 1000 points (considered kazumangan, 4000/6000). Having 7+ han qualifies you for hanemangan (8000/12000). Some hands are shoumangan (6000/9000). Hands that are yakuman in riichi are daimangan (12000/18000), with the exception of chuurenpoutou, which is choumangan (16000/24000)")
  add_rule("Rules", "Minimum Han", "Winning requires a minimum of 1 han.")
  add_rule("Rules", "Zoroba (unimplemented)", "Each 1 or 6 die rolled in the beginning adds 1 han to the winning hand. It is guaranteed that one of the dice is a 1 or 6. This does not count towards the 1 han minimum.")
end

# yaku differences are:
# - no ippatsu
# - pinfu can be open
# - chiitoitsu is 30 fu tsumo or 40 fu ron
# - honitsu is always 2 han
# - ittsuu, sanshoku, chanta are 2/3 han
# - sanshoku doukou is 3 han
# - junchan is 3/4 han
# - ryuuiisou is 2 han plus honitsu
# - shousangen is 2 han plus yakuhai
# - ryanpeikou is 4 han
# - chinitsu, honroutou, renhou are shoumangan
# - chinroutou, daisangen, suushiihou, suuankou, suukantsu are daimangan
# - tenhou is daimangan
# - chiihou is daimangan, ronning dealer
# - tsuuiisou is daimangan, and cannot be daichiishin (which is shoumangan)
# - kokushi musou is daimangan
# - chuuren poutou is choumangan
# plus a bunch of new yaku
# - shiiaru raotai is 1 han
# - ketsupaihou is 1 han
# - sanshoku ittsuu is 2 han
# - shiisanpuutaa is 3 han
# - isshoku sanjun, is 3/4 han
# - sanrenkou is 3 han
# - renkaihou is 3 han
# - choupaikou/sujipaikou/chousankou is 3 han
# - otakaze sankou is 3 han
# - uushin tsuukan is 4 han
# - ryandoukou, is 2 han plus toitoi
# - iipin mouyue is 4 han
# - uupin kaihou is 4 han
# - ryansou chankan is 4 han
# - chinchii toushii is 4 han
# - isshoku yonjun is shoumangan
# - rentsuu honitsu is shoumangan
# - dorahairi chinroutou chiitoitsu is shoumangan
# - daichiishin is shoumangan

# TODO:
# - furiten should also forbid ryanmen and nobetan waits
# - zoroba rules with the dice



