set display_name, "Minefield"
set tutorial_link, "https://riichi.wiki/Minefield_mahjong"
define_base_ruleset riichi
require "yaku/riichi", %{bet: 1000, drawless: false}
require "tobi", %{below: 1000}
require "min_han", %{min: "Mangan"}
define "minefield"

set starting_tiles, 34
set num_players, 2
set display_riichi_sticks, false
set display_round_marker, false
set display_wall, false
set four_rows_discards, true # this is just to make aside clickable
set display_riichi_sticks, true

apply subtract, "default_mods", [
  "riichi_kan",
  "lib/yaku/riichi",
  "kandora",
  "aka",
  "yaku/renhou_yakuman",
  %{name: "kyuushu_kyuuhai", config: %{name: "Kyuushu Kyuuhai"}},
  "pao",
  %{name: "suufon_renda", config: %{name: "Suufon Renda"}},
  "suucha_riichi",
  "suukaikan",
  "show_waits"
]
apply append, "default_mods", [
  "kiriage_mangan"
]

remove_mod "riichi_kan"
remove_mod "lib/yaku/riichi"

define_const can_draw_condition, false

def discard_passed, append: true do
  if status("match_start") and aside_tile_count(4) do
    as toimen do
      if status("match_start") and aside_tile_count(4) do
        ryuukyoku("Ryuukyoku", "ryuukyoku")
      end
    end
  end
end

define_play_restriction any, not_is_drawn_tile

remove_yaku yaku, "Round Wind"

# remove all calls except for ron
apply delete_key, "buttons", "chii"
apply delete_key, "buttons", "pon"
apply delete_key, "buttons", "daiminkan"
apply delete_key, "buttons", "kakan"
apply delete_key, "buttons", "ankan"
apply delete_key, "buttons", "riichi"
apply delete_key, "buttons", "chankan"
apply delete_key, "buttons", "tsumo"

on after_start do set_status_all("building") end

define_button build,
  display_name: "Choose 13 tiles to form a mangan+ hand",
  show_when: status("building"),
  unskippable: true,
  cancellable: false
  do
    mark([["hand", 13, ["self"]]])
    move_tiles(%{hand: ["marked"]}, "aside")
    clear_marking
    swap_tiles("hand", "aside")
    unset_status("building")
    if not_anyone_status("building") do
      set_status_all("match_start", "just_reached", "riichi", "ippatsu")
      as everyone do place_riichi_stick end
      recalculate_buttons
    end
  end

define_button discard,
  display_name: "Select a tile to discard",
  show_when: our_turn and status("match_start") and not_has_draw and not_just_discarded,
  unskippable: true,
  cancellable: false
  do
    mark([["aside", 1, ["self"]]])
    move_tiles(%{aside: ["marked"]}, "discard")
    register_last_discard
    if not_last_discard_matches("yaochuuhai") do unset_status("nagashi") end
    clear_marking
    unset_status("discards_empty")
    recalculate_buttons # allow for ron to pop up
    discard_passed
    advance_turn
  end

def calculate_dora, append: true do
  if not_won do ura = 0 end
end

apply prepend, "buttons.ron.show_when", status("match_start")
apply append, "interruptible_actions", ["recalculate_buttons"]

apply set, "auto_buttons._2_auto_ron.enabled_at_start", true
apply delete_key, "auto_buttons", "_3_auto_no_call"
apply append, "auto_buttons._4_auto_discard.actions" do
  if buttons_include("discard") and not_buttons_include("ron") do
    press_button("discard")
  end
end
apply set, "auto_buttons._4_auto_discard.enabled_at_start", true

# dora counts towards mangan"
apply subtract, "score_calculation.extra_yaku_lists", ["extra_yaku"]
