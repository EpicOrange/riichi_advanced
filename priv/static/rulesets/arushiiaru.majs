define_base_ruleset riichi
set display_name, "Arushiiaru"
set tutorial_link, "https://riichi.wiki/Arushiiaru_mahjong"

set initial_score, 2000

apply subtract, "default_mods", [
  "honba", "lib/yaku/riichi", "dora", "ura", "kandora", "aka",
  "yaku/ippatsu",
  "nagashi",
  %{name: "lib/tobi", config: %{below: 0}},
  "uma",
  "lib/kuikae_nashi",
  "lib/min_han",
  %{name: "suufon_renda", config: %{name: "Suufon Renda"}},
  "suucha_riichi",
  "lib/suukaikan",
  "tenpairenchan",
  %{name: "kyuushu_kyuuhai", config: %{name: "Kyuushu Kyuuhai"}},
  "yaku/riichi_renhou", "pao", "kokushi_ankan_chankan",
  "cancellable_riichi"
]

# furiten is basically the same,
# except furiten on one wait doesn't invalidate another wait
# implement this by removing furiten status when a non-furiten discard appears
define_play_effect any do
  as everyone do
    if status("tenpai", "furiten") do
      if match(["hand", "calls", "last_discard"], ["win"]) and
         not_match(["last_discard", "any_discard"], ~m"pair:1") do
        unset_status("furiten")
        recalculate_buttons
      end
    end
  end
end

# remove noten payments
def setup_noten_payments do end
def execute_noten_payments do end

# open pinfu is 20 fu, pinfu tsumo is 22 fu
define_const closed_tsumo_20_fu, false
define_const open_30_fu, false

# round to nearest 10 instead
define_const riichi_score_rounding, 10

def calculate_base_score do
  cond do
    points2 > 0 ->
      # not sure if mangans stack
      # total = points2 * 2000 :: "Mangan base"
      total = 2000 :: "Mangan base"
      modify_winner("score_name", "Mangan", as: "winner")
    points >= 5 ->
      total = 2000 :: "Mangan base"
      modify_winner("score_name", "Mangan", as: "winner")
    points >= 4 and minipoints >= @mangan_4_han_fu ->
      total = minipoints :: "Fu"
      total = 2000 :: "Mangan base"
      modify_winner("score_name", "Mangan", as: "winner")
    points >= 3 and minipoints >= @mangan_3_han_fu ->
      total = minipoints :: "Fu"
      total = 2000 :: "Mangan base"
      modify_winner("score_name", "Mangan", as: "winner")
    true ->
      han_mult = 2 ** points :: "Han mult."
      total = minipoints :: "Fu"
      total *= han_mult :: "Base"
  end
  base_score = total
end

# Yaku differences can be summarized as follows:

# Chiitoitsu: not a thing
define_match tenpai, "standard_tenpai", "kokushi_tenpai"
define_match win, "standard_win", "kokushi_win"
remove_yaku yaku, "Chiitoitsu"

# Pinfu: does not require closed (since open pinfu is 20 fu now)
replace_yaku yaku, "Pinfu", [1, "Han"], minipoints_equals(20)

# Some yaku are always 1 han (and no +1 for closed)
replace_yaku yaku, "Honitsu", [1, "Han"]
replace_yaku yaku, "Toitoi", [1, "Han"]
replace_yaku yaku, "Ittsuu", [1, "Han"]
replace_yaku yaku, "Chanta", [1, "Han"]
replace_yaku yaku, "Sanankou", [1, "Han"]
replace_yaku yaku, "Shousangen", [1, "Han"]
remove_yaku meta_yaku, "Ittsuu"
remove_yaku meta_yaku, "Chanta"
remove_yaku meta_yaku, "Honitsu"

# Chinitsu is always 3 han (no +1 for closed)
replace_yaku yaku, "Chinitsu", [3, "Han"]
remove_yaku meta_yaku, "Chinitsu"

# All yakuman are mangan (same score, because we'll just interpret ★ as mangan)
# only difference is that chuurenpoutou must be junsei
replace_yaku yakuman, "Suuankou", [1, "★"]
replace_yaku yakuman, "Daisangen", [1, "★"]
replace_yaku yakuman, "Kokushi Musou", [1, "★"]
replace_yaku yakuman, "Shousuushii", [1, "★"]
replace_yaku yakuman, "Daisuushii", [1, "★"]
replace_yaku yakuman, "Tsuuiisou", [1, "★"]
replace_yaku yakuman, "Chinroutou", [1, "★"]
replace_yaku yakuman, "Chuurenpoutou", [1, "★"], match(["hand"], ~m"chuurenpoutou:1")
replace_yaku yakuman, "Tenhou", [1, "★"]
replace_yaku yakuman, "Chiihou", [1, "★"]

# And these yaku do not exist
remove_yaku yaku, "Tsumo"
remove_yaku yaku, "Iipeikou"
remove_yaku yaku, "Junchan"
remove_yaku meta_yaku, "Junchan"
remove_yaku yaku, "Sanshoku"
remove_yaku meta_yaku, "Sanshoku"
remove_yaku yaku, "Sanshoku Doukou"
remove_yaku yaku, "Honroutou"
remove_yaku yaku, "Ryanpeikou"
remove_yaku yaku, "Sankantsu"
remove_yaku yakuman, "Suuankou Tanki"
remove_yaku yakuman, "Ryuuiisou"
remove_yaku yakuman, "Kokushi Musou Juusan Menmachi"
remove_yaku yakuman, "Junsei Chuurenpoutou"
remove_yaku yakuman, "Suukantsu"
remove_yaku meta_yakuman, "Suuankou Tanki"
remove_yaku meta_yakuman, "Junsei Chuurenpoutou"
remove_yaku meta_yakuman, "Kokushi Musou Juusan Menmachi"

# update all the rules text to match
define_const closed_tsumo_20_fu, false
define_const open_30_fu, false
on after_initialization do
  delete_rule("Rules", "Furiten")
  add_rule("Rules", "Furiten", "You cannot win on a discarded tile that you yourself have discarded (or skipped a win on). You can still win on such tiles by tsumo (self-draw).")
  delete_rule("Rules", "Tenpai Payments")
  delete_rule("2 Han", "Chiitoitsu")
  delete_rule("1 Han", "Tsumo")
  delete_rule("1 Han", "Iipeikou")
  delete_rule("2 Han", "Junchan")
  delete_rule("1 Han", "Sanshoku")
  delete_rule("2 Han", "Sanshoku Doukou")
  delete_rule("2 Han", "Honroutou")
  delete_rule("3+ Han", "Ryanpeikou")
  delete_rule("2 Han", "Sankantsu")
  delete_rule("3+ Han", "Chinitsu")
  delete_rule("Yakuman", "Suuankou Tanki")
  delete_rule("Yakuman", "Ryuuiisou")
  delete_rule("Yakuman", "Kokushi Musou Juusan Menmachi")
  delete_rule("Yakuman", "Junsei Chuurenpoutou")
  rename_rule_tab("Yakuman", "Mangan")

  delete_rule("1 Han", "Ittsuu")
  add_rule("1 Han", "Ittsuu", "1 han if your hand contains the sequences 123 456 789 in one suit.")
  update_rule("1 Han", "Ittsuu", "%{example_hand}", %{example_hand: ~t"234p4567779s 12s3S 8s"})

  delete_rule("2 Han", "Toitoi")
  add_rule("1 Han", "Toitoi", "1 han if your hand is all triplets.")
  update_rule("2 Han", "Toitoi", "%{example_hand}", %{example_hand: ~t"888m222p33s22z 1z1Z1z 3s"})

  delete_rule("2 Han", "Sanankou")
  add_rule("1 Han", "Sanankou", "1 han if your hand has three closed triplets. A triplet formed by a self-draw win counts as closed.")
  update_rule("2 Han", "Sanankou", "%{example_hand}", %{example_hand: ~t"222888m444p123s1z 1z"})

  delete_rule("2 Han", "Shousangen")
  add_rule("1 Han", "Shousangen", "1 han on top of yakuhai if you have two dragon triplets/kans and a dragon pair.")
  update_rule("2 Han", "Shousangen", "%{example_hand}", %{example_hand: ~t"123m23s66777z 55z5Z 4s"})

  delete_rule("2 Han", "Honitsu")
  add_rule("1 Han", "Honitsu", "1 han if your hand is comprised of one suit plus honor tiles.")
  update_rule("2 Han", "Honitsu", "%{example_hand}", %{example_hand: ~t"123345888p11z22z 2z"})

  delete_rule("3 Han", "Chinitsu")
  add_rule("3 Han", "Chinitsu", "3 han if your hand is comprised of one suit only (no honor tiles).")
  update_rule("3 Han", "Chinitsu", "%{example_hand}", %{example_hand: ~t"1233445568889s 7s"})

  add_rule("Mangan", "Chuurenpoutou", "Mangan if your hand was 1112345678999 in one suit, and you won via its nine-sided wait.", 2)
  update_rule("Mangan", "Chuurenpoutou", "%{example_hand}", %{example_hand: ~t"1112345678999s 7s"})
end


# now you have arushiiaru!
