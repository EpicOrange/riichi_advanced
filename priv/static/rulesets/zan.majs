define_base_ruleset kansai
set display_name, "Zan Sanma"
set tutorial_link, "https://github.com/EpicOrange/riichi_advanced/blob/main/documentation/Zansanma.md"
require_after "riichi_fix_rules_tabs"

apply subtract, "default_mods", [
  %{name: "honba", config: %{value: 100}},
  %{name: "nagashi", config: %{counts_as: "draw", is: "Mangan"}},
  %{name: "lib/tobi", config: %{below: 1}},
  %{name: "uma", config: %{_1st: 10, _2nd: 5, _3rd: -5, _4th: -10}},
  %{name: "aka", config: %{man: 1, pin: 1, sou: 1}},
  "kansai_30_fu",
]
apply set_append, "default_mods", [
  %{name: "honba", config: %{value: 1000}},
  %{name: "nagashi", config: %{is: "Yakuman", counts_as: "draw"}},
  %{name: "lib/tobi", config: %{below: 1}},
  %{name: "uma", config: %{_4th: -30, _3rd: -10, _2nd: 10, _1st: 30}},
  %{name: "tenpaiyame", config: %{round: "all_last", first_place_only: true, may_choose: false}},
  "first_gets_riichi_sticks",
  "sanchahou",
  "yaku/open_riichi",
  %{name: "lib/shuugi", config: %{worth: 1000, pao_pays_all: true, starting_shuugi: 100}},
  %{name: "shuugi/ippatsu", config: %{chips: 1}},
  %{name: "shuugi/ura", config: %{chips: 1}},
  %{name: "shuugi/yakuman", config: %{allow_kazoe: false, per_yakuman: false, ron_chips: 10, tsumo_chips: 5}},
  %{name: "shiro_pocchi", config: %{ippatsu_only: false}},
  %{name: "aka", config: %{pin: 4, sou: 4, man: 4}},
  %{name: "shuugi/aka", config: %{chips: 1, closed_only: false}},
  "kansai_40_fu",
  "kansai_shuugi",
  "lib/zan_scoring",
  "lib/kansai_draw",
]
