on before_scoring do
  add_scoring_attrs
  calculate_fu
end

on before_win, prepend: true do
  if won_by_draw do
    make_responsible_for("others", "remaining")
  else
    if won_by_discard do
      make_responsible_for("last_discarder", "all")
    else
      make_responsible_for("last_caller", "all")
    end
  end
end

# for kiriage mod to modify
define_const mangan_4_han_fu, 40
define_const mangan_3_han_fu, 70

def calculate_base_score do
  if total == 0 and points2 > 0 do
    total = points2 * 8000 :: "Yakuman base"
    modify_winner("score_name", "Yakuman", as: "winner")
  end
  if total == 0 and points >= 13 do
    total = 8000 :: "Yakuman base"
    modify_winner("score_name", "Kazoe Yakuman", as: "winner")
  end
  if total == 0 and points >= 11 do
    total = 6000 :: "Sanbaiman base"
    modify_winner("score_name", "Sanbaiman", as: "winner")
  end
  if total == 0 and points >= 8 do
    total = 4000 :: "Baiman base"
    modify_winner("score_name", "Baiman", as: "winner")
  end
  if total == 0 and points >= 6 do
    total = 3000 :: "Haneman base"
    modify_winner("score_name", "Haneman", as: "winner")
  end
  if total == 0 and points >= 5 do
    total = 2000 :: "Mangan base"
    modify_winner("score_name", "Mangan", as: "winner")
  end
  if total == 0 and points >= 4 and minipoints >= @mangan_4_han_fu do
    total = minipoints :: "Fu"
    total = 2000 :: "Mangan base"
    modify_winner("score_name", "Mangan", as: "winner")
  end
  if total == 0 and points >= 3 and minipoints >= @mangan_3_han_fu do
    total = minipoints :: "Fu"
    total = 2000 :: "Mangan base"
    modify_winner("score_name", "Mangan", as: "winner")
  end
  if total == 0 do
    han_mult = 2 ** (points + 2) :: "Han mult."
    total = minipoints :: "Fu"
    total *= han_mult :: "Base"
  end
  base_score = total # save base_score for mods to use
end

def apply_ron_scoring do
  if seat_is("east", as: "winner") do
    total *= 6 :: "Dealer ron"
  else
    total *= 4 :: "Nondealer ron"
  end
  if mod(total, 100) > 0 do
    total = round_up(total, 100) :: "Round up"
  end
end

def apply_tsumo_scoring do
  if seat_is("east", as: "winner") or seat_is("east") do
    total *= 2 :: "Dealer tsumo"
  else
    total *= 1 :: "Nondealer tsumo"
  end
  if mod(total, 100) > 0 do
    total = round_up(total, 100) :: "Round up"
  end
end

define_scoring ron do
  total = 0
  if points2 > 0 do points2 = points2 :: "★" else points = points :: "Han" end
  calculate_base_score
  apply_ron_scoring
  if mod(total, 100) > 0 do
    total = round_up(total, 100) :: "Round up"
  end
  finalize_score
end

define_scoring tsumo do
  total = 0
  if points2 > 0 do points2 = points2 :: "★" else points = points :: "Han" end
  calculate_base_score
  apply_tsumo_scoring
  if mod(total, 100) > 0 do
    total = round_up(total, 100) :: "Round up"
  end
  finalize_score
end

define_const honba_mult, 3
def finalize_score do
  if display_total == 0 do
    # store total winnings without honba, for display
    cond do
      won_by_draw and seat_is("east", as: "winner") -> display_total = total * 3
      won_by_draw and seat_is("east") -> display_total = total * 2
      true -> display_total = total
    end
    set_counter_all("display_total", "display_total")
  end
  if honba > 0 do
    if won_by_draw do
      total += honba * @honba_value :: "Honba"
    else
      total += honba * @honba_mult * @honba_value :: "Honba"
    end
  end
end

on after_win do
  modify_winner("score", "display_total") # before honba and riichi sticks
  # gather riichi sticks for the first winner
  as winners do
    riichi_stick_payment = pot
    if riichi_stick_payment > 0 do
      total += riichi_stick_payment :: "Riichi sticks"
      riichi_stick_payment *= -1
      add_to_pot("riichi_stick_payment") # zero out pot
    end
  end
end
