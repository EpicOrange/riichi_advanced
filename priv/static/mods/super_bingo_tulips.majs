def flip_next_tile do
  unless status("stop_arisu") do
    cond do
      tier == 1 -> flip_next_top_tile; score_flip(%{key: "$key"})
      tier == 2 -> flip_next_top_tile; score_flip(%{key: "$key"}); flip_next_bottom_tile; score_flip(%{key: "$key"})
      tier == 3 -> flip_next_top_tile; score_flip(%{key: "$key"}); flip_next_bottom_tile; score_flip(%{key: "$key"})
    end
    process_post_flip(%{key: "$key"})
  end
end
define_set arisu_adjacent, ~s"0 0|0 1"

def score_flip do
  prev_arisu_matches = arisu_matches
  matches = 0
  cond do
    tiles_match(["flipped"], ["9z"]) ->
      # shiro pocchi: choose what tile it is, must not be visible. unimplemented, just get 10 chips for now
      arisu_matches += 10
    tiles_match(["flipped"], ["pinzu", "souzu", "jihai"]) ->
      # number tile: 1 shuugi per tile on or adjacent to it in dora indicator order
      add_counter("matches", "count_matching_ways", ["hand_any", "last_scryed_tile"], ~m"arisu_adjacent:1")
      add_counter("matches", "count_matching_ways", ["call_tiles_any", "last_scryed_tile"], ~m"arisu_adjacent:1")
      cond do
        equals("$key", "tsumo")   -> if match(["draw", "last_scryed_tile"], ~m"arisu_adjacent:1") do matches += 1 end
        equals("$key", "ron")     -> if match(["last_discard", "last_scryed_tile"], ~m"arisu_adjacent:1") do matches += 1 end
        equals("$key", "chankan") -> if match(["last_called_tile", "last_scryed_tile"], ~m"arisu_adjacent:1") do matches += 1 end
      end
      arisu_matches += matches
      if tier < 3 and matches >= 6 do
        push_message("advances to tier $tier for matching $diff distinct tiles", %{tier: "tier", diff: "diff"})
        tier += 1
      end
    tiles_match(["flipped"], ["flower"]) ->
      # flower tile: 3 shuugi per called flower
      set_counter("flowers", "count_matches", ["flowers"], ~m"(1f 2f 3f 4f):1")
      arisu_matches += 3 * flowers
      flowers = 0
    true ->
      print("warning, tile didn't match anything")
  end
  diff = arisu_matches - prev_arisu_matches

  # TODO rainbow sevens mod:
  # if you have both rainbow 7s, +1 tier
  # revealing a rainbow 7 is the same as regular 7 but doubles the shuugi gained
  # shiro pocchi can select rainbow 7
end

def process_post_flip do
  untag_tiles("flipped", "scryed_tiles")
  cond do
    tiles_in_wall < 2 ->
      cond do
        equals("$key", "tsumo") -> push_message("has run out of 2-stacks in wall to flip, ending with a total payment of $chips extra chips from the discarder", %{chips: "arisu_matches"})
        true -> push_message("has run out of 2-stacks in wall to flip, ending with a total payment of $chips extra chips from all other players", %{chips: "arisu_matches"})
      end
      set_status("stop_arisu")
    prev_arisu_matches == arisu_matches ->
      if lives > 1 do
        lives -= 1
        push_message("loses one life")
      else
        cond do
          equals("$key", "tsumo") -> push_message("has run out of lives, ending with a total payment of $chips extra chips from the discarder", %{chips: "arisu_matches"})
          true -> push_message("has run out of lives, ending with a total payment of $chips extra chips from all other players", %{chips: "arisu_matches"})
        end
        set_status("stop_arisu")
      end
    true ->
      push_message("adds $diff chip(s) to the payment for matching $matches tile(s)", %{diff: "diff", matches: "matches"})
  end
end

apply set_append, "shown_statuses", ["arisu_matches"]

