on after_initialization do
  add_rule("Rules", "Tulips: Flipping", """
    If you win with riichi, flip the top tile of the wall after revealed dora indicators.
    - Gain one chip for each matching tile, and if any tiles did match (is the same tile or either adjacent tile in dora indicator order), repeat the process by flipping over the next top tile of the next 2-stack in the wall.
    - Flipped flowers match all your flowers and add 3 chips per flower you have declared.
    - The shiro pocchi is supposed to be a wildcard of your choice, as long as it is a tile that exists but is not visible to you. Unfortunately, this is not yet implemented, so you get 10 chips instead.
    """, -95)
  add_rule("Rules", "Tulips: Lives", """
    If you matched any tile from the last flip, continue by flipping over the next top tile of a 2-stack in the wall, stopping only once you lose all your lives OR if there are no more 2-stacks in the wall to flip over.
    You start with one life, and lose one life every time a match is not found.
    You gain +1 extra life if you win with ippatsu, and +1 extra life if you win with sanbaiman (11+ Han) or yakuman.
    """, -94)
  add_rule("Rules", "Tulips: Tiers", """
    In addition, if your winning hand contains three sevens of the same suit, you start at "tier 2" meaning you flip over both tiles in every 2-stack, and gain chips for both tiles if they match. You lose a life only if neither tile matches.
    If your winning hand contains three sevens of both suits, you start at "tier 3" which is tier 2 except it simply doubles the number of chips you win from this process.
    Every time the flipped wall tile(s) match 6+ distinct tiles in your hand at once, your tier increases by 1, to a maximum of 3.
    """, -93)
end

replace 1, "buttons.ron", ["win_by_discard", "zan_ron"], perform_arisu(%{key: "ron"})
replace 1, "buttons.tsumo", ["win_by_draw", "zan_tsumo"], perform_arisu(%{key: "tsumo"})
replace 1, "buttons.chankan", ["win_by_call", "zan_ron"], perform_arisu(%{key: "chankan"})
apply append, "buttons.chii.show_when", status_missing("performing_arisu")
apply append, "buttons.pon.show_when", status_missing("performing_arisu")
apply append, "buttons.daiminkan.show_when", status_missing("performing_arisu")
apply append, "buttons.ankan.show_when", status_missing("performing_arisu")
apply append, "buttons.kakan.show_when", status_missing("performing_arisu")
apply append, "buttons.riichi.show_when", status_missing("performing_arisu")
apply append, "buttons.ron.show_when", status_missing("performing_arisu")
apply append, "buttons.tsumo.show_when", status_missing("performing_arisu")
apply append, "buttons.chankan.show_when", status_missing("performing_arisu")

define_yaku shuugi, "Tulips", ["arisu_matches", "⛀"], arisu_matches >= 1

define_set seven, ~s"7p|7s"
def perform_arisu do
  cond do
    status("riichi")                                      -> set_status("performing_arisu"); push_message("won with a closed hand, and will flip tiles on the wall from the dora indicator onward, scoring shuugi for every matching tile in hand")
    equals("$key", "tsumo")   and has_yaku_with_hand(1, "★")    -> set_status("performing_arisu"); yakuman = 1; push_message("won with yakuman, and will flip tiles on the wall from the dora indicator onward, scoring shuugi for every matching tile in hand")
    equals("$key", "ron")     and has_yaku_with_discard(1, "★") -> set_status("performing_arisu"); yakuman = 1; push_message("won with yakuman, and will flip tiles on the wall from the dora indicator onward, scoring shuugi for every matching tile in hand")
    equals("$key", "chankan") and has_yaku_with_call(1, "★")    -> set_status("performing_arisu"); yakuman = 1; push_message("won with yakuman, and will flip tiles on the wall from the dora indicator onward, scoring shuugi for every matching tile in hand")
  end
  if status("performing_arisu") do
    # if you have shiro pocchi, revert its wildcard status (no-op otherwise)
    load_tile_behavior("before_shiro_pocchi")
    save_revealed_tiles("before flips")
    save_tile_behavior("before wrap")

    # temporarily wrap tiles like space mahjong (exclude nonexistent manzu suit)
    set_tile_ordering(["9p", "1p"])
    set_tile_ordering(["9s", "1s"])
    set_tile_ordering(["1z", "2z", "3z", "4z", "1z"])
    set_tile_ordering(["5z", "6z", "7z", "5z"])

    lives = 1
    # ippatsu gives +1 extra life
    if status("ippatsu") do lives += 1; push_message("gets an extra life for winning with ippatsu") end
    # sanbaiman+ gives +1 extra life
    cond do
      yakuman == 1 -> lives += 1; push_message("gets an extra life for winning with yakuman")
      equals("$key", "tsumo")   and has_yaku_with_hand(11, "Han")    -> lives += 1; push_message("gets an extra life for winning with sanbaiman")
      equals("$key", "ron")     and has_yaku_with_discard(11, "Han") -> lives += 1; push_message("gets an extra life for winning with sanbaiman")
      equals("$key", "chankan") and has_yaku_with_call(11, "Han")    -> lives += 1; push_message("gets an extra life for winning with sanbaiman")
    end

    # count sevens in hand to get starting tier
    calculate_tulips_tier(%{key: "$key"})

    pause(2000)
    arisu_50(%{key: "$key"})
    arisu_50(%{key: "$key"})
    arisu_50(%{key: "$key"})
    arisu_50(%{key: "$key"})
    if tier == 3 do
      pause(1000)
      push_message("doubles their chip payment for being in tier 3")
      arisu_matches *= 2
    end
    pause(3000)
    remove_attr([-18, -16, -14, -12, -10, -8, -6], ["inactive"])
    clear_scry
    load_revealed_tiles
    load_tile_behavior("before wrap")
    save_revealed_tiles("after flips")
    load_revealed_tiles("before flips")
  end
  cond do
    equals("$key", "tsumo")   -> win_by_draw("zan_tsumo")
    equals("$key", "ron")     -> win_by_discard("zan_ron")
    equals("$key", "chankan") -> win_by_call("zan_ron")
  end
end

on after_win do
  load_revealed_tiles("after flips")
end

def calculate_tulips_tier do
  cond do
    equals("$key", "tsumo")   -> add_counter("seven_pins", "count_matches", ["hand", "calls", "draw"], ~m"nojoker, seven:1")
    equals("$key", "ron")     -> add_counter("seven_pins", "count_matches", ["hand", "calls", "last_discard"], ~m"nojoker, seven:1")
    equals("$key", "chankan") -> add_counter("seven_pins", "count_matches", ["hand", "calls", "last_called_tile"], ~m"nojoker, seven:1")
  end
  cond do
    equals("$key", "tsumo")   and has_yaku_with_hand(3, "★")    -> tier = 3; push_message("starts in tier 3 for achieving triple yakuman")
    equals("$key", "ron")     and has_yaku_with_discard(3, "★") -> tier = 3; push_message("starts in tier 3 for achieving triple yakuman")
    equals("$key", "chankan") and has_yaku_with_call(3, "★")    -> tier = 3; push_message("starts in tier 3 for achieving triple yakuman")
    equals("$key", "tsumo")   and has_yaku_with_hand(2, "★")    -> tier = 2; push_message("starts in tier 2 for achieving double yakuman")
    equals("$key", "ron")     and has_yaku_with_discard(2, "★") -> tier = 2; push_message("starts in tier 2 for achieving double yakuman")
    equals("$key", "chankan") and has_yaku_with_call(2, "★")    -> tier = 2; push_message("starts in tier 2 for achieving double yakuman")
    seven_pins >= 3 and seven_sous >= 3 -> tier = 3; push_message("starts in tier 3 for having 3 sevens of both suits")
    seven_pins >= 3 or  seven_sous >= 3 -> tier = 2; push_message("starts in tier 2 for having 3 sevens in one suit")
    true                                -> tier = 1
  end
end

