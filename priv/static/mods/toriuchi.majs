if defined("shuugi") do
  on after_initialization do
    update_rule("Rules", "Shuugi", "(Toriuchi) On ron, each 1s (bird) tile is worth 1 shuugi, unless the discarder's hand contains 7p (pistol) which would shoot the birds dead. That is, unless the winner's hand contains 8s (birdcage) which would protect the birds from gunfire.")
  end

  on before_win do
    if won_by_discard do
      as last_discarder do reveal_hand end
      if not_match(["hand", "calls", "winning_tile"], ~m"7p:1", as: "last_discarder")
          or match(["hand", "calls", "winning_tile"], ~m"8s:1") do
        add_counter("toriuchi", "count_matches", ["hand", "calls", "winning_tile"], ~m"1s:1")
      end
    end
    if won_by_call do
      as last_caller do reveal_hand end
      if not_match(["hand", "calls", "winning_tile"], ~m"7p:1", as: "last_caller")
          or match(["hand", "calls", "winning_tile"], ~m"8s:1") do
        add_counter("toriuchi", "count_matches", ["hand", "calls", "winning_tile"], ~m"1s:1")
      end
    end
  end

  define_yaku shuugi, "Toriuchi", ["toriuchi", "⛀"], toriuchi >= 1

  apply append, "functions.announce_shuugi_payment" do
    if toriuchi >= 1 do
      push_system_message("Discarder pays 1 chip for each bird tile (1s) in winner's hand")
    end
  end
end