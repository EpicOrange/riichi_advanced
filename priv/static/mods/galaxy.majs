        "19t": ["10m", "10p", "10s", "10t"],
        "110t": ["1m", "1p", "1s", "1t"],
      }
    end
  else # 9 -> 1
    apply merge, "dora_indicators", %{
      "11m": ["2m", "2p", "2s"],
      "12m": ["3m", "3p", "3s"],
      "13m": ["4m", "4p", "4s"],
      "14m": ["5m", "5p", "5s"],
