on after_initialization do
  add_rule("Tiles", "Galaxy Mahjong", "One of each tile is replaced with a blue 'galaxy' tile that acts as a wildcard of its number. For example, %{galaxy_3s} can be used as any of %{threes}. Galaxy winds are wind wildcards, and galaxy dragons are dragon wildcards.", %{galaxy_3s: ["13s"], threes: ["3s", "3p", "3m"]}, -99)
  add_rule("Rules", "Win Condition", "- (Galaxy Mahjong) You have 14 galaxy tiles.", -100)
  add_rule("Yakuman", "Milky Way", "(Galaxy Mahjong) Having any 14 galaxy tiles awards the Milky Way yakuman.")
  update_rule("Yakuman", "Milky Way", "%{example_hand}", %{example_hand: ["11m", "15m", "16m", "19m", "12p", "14p", "17p", "11s", "13s", "17s", "12z", "14z", "3x", "17z"]})
end

# first, replace one of each tile in the wall with a galaxy tile

replace 1, "wall", "1m", "11m"
replace 1, "wall", "2m", "12m"
replace 1, "wall", "3m", "13m"
replace 1, "wall", "4m", "14m"
replace 1, "wall", "5m", "15m"
replace 1, "wall", "6m", "16m"
replace 1, "wall", "7m", "17m"
replace 1, "wall", "8m", "18m"
replace 1, "wall", "9m", "19m"
replace 1, "wall", "1p", "11p"
replace 1, "wall", "2p", "12p"
replace 1, "wall", "3p", "13p"
replace 1, "wall", "4p", "14p"
replace 1, "wall", "5p", "15p"
replace 1, "wall", "6p", "16p"
replace 1, "wall", "7p", "17p"
replace 1, "wall", "8p", "18p"
replace 1, "wall", "9p", "19p"
replace 1, "wall", "1s", "11s"
replace 1, "wall", "2s", "12s"
replace 1, "wall", "3s", "13s"
replace 1, "wall", "4s", "14s"
replace 1, "wall", "5s", "15s"
replace 1, "wall", "6s", "16s"
replace 1, "wall", "7s", "17s"
replace 1, "wall", "8s", "18s"
replace 1, "wall", "9s", "19s"
replace 1, "wall", "1z", "11z"
replace 1, "wall", "2z", "12z"
replace 1, "wall", "3z", "13z"
replace 1, "wall", "4z", "14z"
replace 1, "wall", "5z", "15z"
replace 1, "wall", "6z", "16z"
replace 1, "wall", "7z", "17z"
if defined("star_suit") do
  replace 1, "wall", "1t", "11t"
  replace 1, "wall", "2t", "12t"
  replace 1, "wall", "3t", "13t"
  replace 1, "wall", "4t", "14t"
  replace 1, "wall", "5t", "15t"
  replace 1, "wall", "6t", "16t"
  replace 1, "wall", "7t", "17t"
  replace 1, "wall", "8t", "18t"
  replace 1, "wall", "9t", "19t"
end
if defined("ten") do
  replace 1, "wall", "10m", "110m"
  replace 1, "wall", "10p", "110p"
  replace 1, "wall", "10s", "110s"
  if defined("star_suit") do
    replace 1, "wall", "10t", "110t"
  end
end
if defined("blue_dragon") do
  replace 1, "wall", "0z", "10z"
end

# add joker rules
on after_start do
  set_tile_alias_all(["11m"], [["1m","original"],"1p","1s"])
  set_tile_alias_all(["12m"], [["2m","original"],"2p","2s"])
  set_tile_alias_all(["13m"], [["3m","original"],"3p","3s"])
  set_tile_alias_all(["14m"], [["4m","original"],"4p","4s"])
  set_tile_alias_all(["15m"], [["5m","original"],"5p","5s"])
  set_tile_alias_all(["16m"], [["6m","original"],"6p","6s"])
  set_tile_alias_all(["17m"], [["7m","original"],"7p","7s"])
  set_tile_alias_all(["18m"], [["8m","original"],"8p","8s"])
  set_tile_alias_all(["19m"], [["9m","original"],"9p","9s"])
  set_tile_alias_all(["11p"], ["1m",["1p","original"],"1s"])
  set_tile_alias_all(["12p"], ["2m",["2p","original"],"2s"])
  set_tile_alias_all(["13p"], ["3m",["3p","original"],"3s"])
  set_tile_alias_all(["14p"], ["4m",["4p","original"],"4s"])
