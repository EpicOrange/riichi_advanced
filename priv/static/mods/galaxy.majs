        "17t": ["8m", "8p", "8s", "8t"],
        "18t": ["9m", "9p", "9s", "9t"],
        "19t": ["1m", "1p", "1s", "1t"],
      }
    end
  end

  # then do honor tiles
  apply merge, "dora_indicators", %{
    "11z": ["1z", "2z", "3z", "4z"],
    "12z": ["1z", "2z", "3z", "4z"],
    "13z": ["1z", "2z", "3z", "4z"],
    "14z": ["1z", "2z", "3z", "4z"],
    "15z": ["5z", "6z", "7z", "0z"],
    "16z": ["5z", "6z", "7z", "0z"],
    "17z": ["5z", "6z", "7z", "0z"]
  }
  if defined("blue_dragon") do
    apply merge, "dora_indicators", %{"10z": ["5z", "6z", "7z", "0z"]}
  end
  if defined("sanma") do
    if defined("ten") do
      apply merge, "dora_indicators", %{"11m": ["10m", "10p", "10s"]}
      if defined("star_suit") do
        apply merge, "dora_indicators", %{"11t": ["10t"]}
      end
    else
      apply merge, "dora_indicators", %{"11m": ["9m", "9p", "9s"]}
      if defined("star_suit") do
        apply merge, "dora_indicators", %{"11t": ["10t"]}
      end
    end
  end
end

# tile indices
if defined("star_suit") do
  apply merge, "custom_style.tile_indices", %{
    "11t": "1",
    "12t": "2",
    "13t": "3",
    "14t": "4",
    "15t": "5",
    "16t": "6",
    "17t": "7",
    "18t": "8",
    "19t": "9",
  }
  if defined("ten") do
    apply merge, "custom_style.tile_indices", %{"110t": "T"}
  end
end
if defined("ten") do
  apply merge, "custom_style.tile_indices", %{
    "110m": "T",
    "110p": "T",
    "110s": "T",
  }
end
if defined("blue_dragon") do
  apply merge, "custom_style.tile_indices", %{"10z": "B"}
end

# define the set of galaxy tiles
define_set galaxy_tile, ~s"11m|12m|13m|14m|15m|16m|17m|18m|19m|110m|11p|12p|13p|14p|15p|16p|17p|18p|19p|110p|11s|12s|13s|14s|15s|16s|17s|18s|19s|110s|10z|11z|12z|13z|14z|15z|16z|17z"
if defined("star_suit") do
  apply append, "set_definitions.galaxy_tile", ~s"11t|12t|13t|14t|15t|16t|17t|18t|19t"
  if defined("ten") do
    apply append, "set_definitions.galaxy_tile", ~s"110t"
  end
end
if defined("ten") do
  apply append, "set_definitions.galaxy_tile", ~s"110m|110p|110s"
end
if defined("blue_dragon") do
  apply append, "set_definitions.galaxy_tile", ~s"10z"
end

# finally done populating the wall with galaxy tiles

# milky way
define_const milky_way_tenpai, ~m"nojoker, galaxy_tile:13"
define_const milky_way_tenpai_14, ~m"nojoker, galaxy_tile:13"
define_const milky_way_win, ~m"nojoker, galaxy_tile:14"
apply set_append, "tenpai_definition", +@milky_way_tenpai
apply set_append, "tenpai_14_definition", +@milky_way_tenpai_14
apply set_append, "win_definition", +@milky_way_win
define_yaku yakuman, "Milky Way", [1, "★"], non_galaxy_jokers == 0

# ankans are displayed all-face-up
apply set, "buttons.ankan.call_style.self", [0, 1, 2, 3]

on before_win do
  add_counter("galaxy_jokers", "count_matches", ["hand", "calls", "winning_tile"], ~m"galaxy_tile:1")
  set_counter("non_galaxy_jokers", "count_matches", ["hand", "calls", "winning_tile"], ~m"any:1") # count num of tiles in hand
  non_galaxy_jokers -= galaxy_jokers
  if non_galaxy_jokers == 0 do
    fu = 30
  end
end

# there is a rule that you gain shuugi equal to the number of galaxy tiles used as their own value,
# but our current joker solver does not try to maximize galaxy tiles used as their own value
# so this is not currently possible to implement
if defined("shuugi") do
  on after_initialization do
    update_rule("Rules", "Shuugi", "(Galaxy Mahjong) Every galaxy tile used as its original tile awards one shuugi.")
  end
  on before_scoring do
    set_counter("galaxy_shuugi", "count_matches", ["hand", "calls", "winning_tile"], ~m"any@original:1")
  end
  define_yaku shuugi, "Original Galaxy Tile", ["galaxy_shuugi", "⛀"], galaxy_shuugi >= 1
end
