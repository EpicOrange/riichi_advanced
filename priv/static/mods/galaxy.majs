    set_tile_alias_all(["12t"], ["2m","2p","2s",["2t","original"]])
    set_tile_alias_all(["13t"], ["3m","3p","3s",["3t","original"]])
    set_tile_alias_all(["14t"], ["4m","4p","4s",["4t","original"]])
    set_tile_alias_all(["15t"], ["5m","5p","5s",["5t","original"]])
    set_tile_alias_all(["16t"], ["6m","6p","6s",["6t","original"]])
