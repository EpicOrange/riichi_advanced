        "110s": ["1t"],
        "11t": ["2m", "2p", "2s", "2t"],
        "12t": ["3m", "3p", "3s", "3t"],
        "13t": ["4m", "4p", "4s", "4t"],
        "14t": ["5m", "5p", "5s", "5t"],
        "15t": ["6m", "6p", "6s", "6t"],
        "16t": ["7m", "7p", "7s", "7t"],
