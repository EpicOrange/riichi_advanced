  end
end
if defined("ten") do
  on after_start do
    set_tile_alias_all(["110m"], [["10m","original"],"10s","10p"])
    set_tile_alias_all(["110p"], ["10m",["10s","original"],"10p"])
    set_tile_alias_all(["110s"], ["10m","10s",["10p","original"]])
  end
  if defined("star_suit") do
    on after_start do
      set_tile_alias_all(["110m"], ["10t"])
      set_tile_alias_all(["110p"], ["10t"])
      set_tile_alias_all(["110s"], ["10t"])
      set_tile_alias_all(["110t"], ["10m", "10p", "10s", ["10t","original"]])
    end
  end
end
if defined("blue_dragon") do
  on after_start do
    set_tile_alias_all(["10z"], [["0z","original"],"6z","7z","5z"])
  end
end

# expand dora indicator map, if it exists
if defined("dora") do
  # first do suited tiles
  if defined("ten") do # 10 -> 1
    apply merge, "dora_indicators", %{
      "11m": ["2m", "2p", "2s"],
      "12m": ["3m", "3p", "3s"],
      "13m": ["4m", "4p", "4s"],
      "14m": ["5m", "5p", "5s"],
      "15m": ["6m", "6p", "6s"],
      "16m": ["7m", "7p", "7s"],
      "17m": ["8m", "8p", "8s"],
      "18m": ["9m", "9p", "9s"],
