  set_tile_alias_all(["19p"], ["9m",["9p","original"],"9s"])
  set_tile_alias_all(["11s"], ["1m","1p",["1s","original"]])
  set_tile_alias_all(["12s"], ["2m","2p",["2s","original"]])
  set_tile_alias_all(["13s"], ["3m","3p",["3s","original"]])
  set_tile_alias_all(["14s"], ["4m","4p",["4s","original"]])
  set_tile_alias_all(["15s"], ["5m","5p",["5s","original"]])
  set_tile_alias_all(["16s"], ["6m","6p",["6s","original"]])
  set_tile_alias_all(["17s"], ["7m","7p",["7s","original"]])
  set_tile_alias_all(["18s"], ["8m","8p",["8s","original"]])
  set_tile_alias_all(["19s"], ["9m","9p",["9s","original"]])
  set_tile_alias_all(["11z"], [["1z","original"],"2z","3z","4z"])
  set_tile_alias_all(["12z"], ["1z",["2z","original"],"3z","4z"])
  set_tile_alias_all(["13z"], ["1z","2z",["3z","original"],"4z"])
  set_tile_alias_all(["14z"], ["1z","2z","3z",["4z","original"]])
  set_tile_alias_all(["15z"], [["5z","original"],"6z","7z","0z"])
  set_tile_alias_all(["16z"], ["5z",["6z","original"],"7z","0z"])
  set_tile_alias_all(["17z"], ["5z","6z",["7z","original"],"0z"])
end
if defined("star_suit") do
  on after_start do
    set_tile_alias_all(["11m"], ["1t"])
    set_tile_alias_all(["12m"], ["2t"])
    set_tile_alias_all(["13m"], ["3t"])
    set_tile_alias_all(["14m"], ["4t"])
