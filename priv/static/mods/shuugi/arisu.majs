on after_initialization do
  add_rule("Rules", "Arisu", """
    If you win with a concealed hand, flip the top tile of the wall after revealed dora indicators. Gain one chip for each matching tile, and if any tiles did match, repeat the process by flipping over the next top tile. This process stops once a match is not found OR if the end of the wall is reached (no more top tiles).
    """)
end

# replace the win action on each win button to introduce a wall-flipping phase before actually winning

replace 1, "buttons.ron", ["win_by_discard", "ron"], perform_arisu(%{key: "ron"})
replace 1, "buttons.tsumo", ["win_by_draw", "tsumo"], perform_arisu(%{key: "tsumo"})
replace 1, "buttons.chankan", ["win_by_call", "ron"], perform_arisu(%{key: "chankan"})
apply append, "buttons.chii.show_when", status_missing("performing_arisu")
apply append, "buttons.pon.show_when", status_missing("performing_arisu")
apply append, "buttons.daiminkan.show_when", status_missing("performing_arisu")
apply append, "buttons.ankan.show_when", status_missing("performing_arisu")
apply append, "buttons.kakan.show_when", status_missing("performing_arisu")
apply append, "buttons.riichi.show_when", status_missing("performing_arisu")
apply append, "buttons.ron.show_when", status_missing("performing_arisu")
apply append, "buttons.tsumo.show_when", status_missing("performing_arisu")
apply append, "buttons.chankan.show_when", status_missing("performing_arisu")

def perform_arisu do
  if @closed_hand do
    set_status("performing_arisu")
    push_message("won with a closed hand, and will flip tiles on the wall from the dora indicator onward, scoring shuugi for every matching tile in hand")
    save_revealed_tiles

    pause(2000); matching = 0; flip_next_tile(%{key: "$key"})
    arisu_50(%{key: "$key"})
    arisu_50(%{key: "$key"})
    arisu_50(%{key: "$key"})
    arisu_50(%{key: "$key"})
    pause(3000)
    remove_attr([-18, -16, -14, -12, -10, -8, -6], ["inactive"])
    clear_scry
    load_revealed_tiles
    pause(0)
    cond do
      "$key" == "tsumo"   -> win_by_draw("tsumo")
      "$key" == "ron"     -> win_by_discard("ron")
      "$key" == "chankan" -> win_by_call("ron")
    end
  else
    cond do
      "$key" == "tsumo"   -> win_by_draw("tsumo")
      "$key" == "ron"     -> win_by_discard("ron")
      "$key" == "chankan" -> win_by_call("ron")
    end
  end
end

define_yaku shuugi, "Arisu", ["arisu_matches", "⛀"], arisu_matches >= 1

