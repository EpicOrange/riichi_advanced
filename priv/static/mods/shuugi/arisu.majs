    prev_arisu_matches = arisu_matches
    add_counter("arisu_matches", "count_matching_ways", ["hand_any", "last_scryed_tile"], ~m"pair:1")
    add_counter("arisu_matches", "count_matching_ways", ["call_tiles_any", "last_scryed_tile"], ~m"pair:1")
    cond do
      "$key" == "tsumo"   -> if match(["draw", "last_scryed_tile"], ~m"pair:1") do arisu_matches += 1 end
      "$key" == "ron"     -> if match(["last_discard", "last_scryed_tile"], ~m"pair:1") do arisu_matches += 1 end
      "$key" == "chankan" -> if match(["last_called_tile", "last_scryed_tile"], ~m"pair:1") do arisu_matches += 1 end
    end
    cond do
      prev_arisu_matches == arisu_matches ->
        cond do
          "$key" == "tsumo" -> push_message("does not have any more tiles in hand matching the last revealed tile, and so will be paid $chips extra chips from the discarder", %{chips: "arisu_matches"})
          true -> push_message("does not have any more tiles in hand matching the last revealed tile, and so will be paid $chips extra chips from all other players", %{chips: "arisu_matches"})
        end
        set_status("stop_arisu")
      tiles_in_wall < 2 ->
        cond do
          "$key" == "tsumo" -> push_message("does not have any more top-stack tiles in wall to flip, and will be paid $chips extra chips from the discarder", %{chips: "arisu_matches"})
          true -> push_message("does not have any more top-stack tiles in wall to flip, and will be paid $chips extra chips from all other players", %{chips: "arisu_matches"})
        end
        set_status("stop_arisu")
    end
  end
end
