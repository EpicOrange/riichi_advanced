
if defined("shuugi") do
  on after_initialization do
    add_rule("Shuugi", "Ippatsu", "(Ippatsu) Winning by ippatsu adds %{chips} shuugi to the payment.", %{chips: !chips})
  end
  define_yaku shuugi, "Ippatsu", [1, "⛀"], has_existing_yaku("Ippatsu")
  def announce_shuugi_payment, append: true do
    if status("ippatsu") and status_missing("call_made") do
      if won_by_draw do
        if !chips == 1 do
          push_system_message("Everyone pays 1 chip for ippatsu")
        else
          push_system_message("Everyone pays %{chips} chips for ippatsu", %{chips: !chips})
        end
      else
        if !chips == 1 do
          push_system_message("Discarder pays 1 chip for ippatsu")
        else
          push_system_message("Discarder pays %{chips} chips for ippatsu", %{chips: !chips})
        end
      end
    end
  end
end
