define "kazoe_yakuman_nashi"

on after_initialization do
  add_rule("Rules", "No Kazoe Yakuman", "13+ han is worth sanbaiman, not yakuman.")
end

def calculate_base_score, prepend: true do
  if total == 0 and points2 == 0 and points >= 13 do
    total = 6000 :: "Sanbaiman base"
    modify_winner("score_name", "Sanbaiman", as: "winner")
  end
end
