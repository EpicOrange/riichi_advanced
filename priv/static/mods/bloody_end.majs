default hide_winning_hands, true

set bloody_end, true
apply set, "score_calculation.bloody_end_name", "Bloody End"

# winners shouldn't have to pay for tsumo
on before_win do
  if won_by_draw do
    as others do
      if is_winner do
        clear_responsibilities("prev_seat")
      end
    end
  end
end

# TODO should winners be responsible for nagashi mangan?

on before_continue do
  as everyone do
    take_back_riichi_stick
    subtract_from_pot("pot") # clear pot
  end
end

if !hide_winning_hands do
  # don't show hand when we win
  replace 1, "buttons.ron.actions", "reveal_hand", "noop"
  replace 1, "buttons.tsumo.actions", "reveal_hand", "noop"
  # show winning hands at the end
  on before_exhaustive_draw do
    as winners do
      reveal_hand
    end
  end
  on after_win do
    if not_anyone_status("first_winner") do
      set_status("first_winner", as: "winner") # will be next dealer
    end
    if num_winners == num_players - 1 do
      as winners do
        reveal_hand
      end
    end
  end
end

# noten payments are always 1000
# (setup_noten_payments is defined in riichi_scoring)
def setup_noten_payments, append: true do
  if noten_payment > 0 do
    noten_penalty = 1000 * tenpai_count
    noten_payment = 1000
    set_counter_all("noten_payment", "noten_payment")
    set_counter_all("noten_penalty", "noten_penalty")
  end
end

on after_scoring do
  # deny kan payments after a win
  unset_status_all("kan", "daiminkan", "kakan", "ankan")
end

# the below is to change the dealer to the first winner

on after_scoring do
  as east do
    if status("ended_by_draw") do
      before_bloody_end
    else
      if num_winners >= 3 do
        before_bloody_end
      end
    end
  end
end

def before_bloody_end do
  if anyone_status("first_winner") do
    # change dealership to first winner
    as everyone do
      if status("first_winner") do
        change_dealership("self")
      end
    end
  else
    change_dealership("self")
  end
end
