on after_initialization do
  add_rule("Rules", "Chombo", "The tsumo and ron (and riichi) buttons are enabled on every draw and discard. If you make an incorrect win call, your hand is dead and you cannot make a win call for the remainder of the round.")
end

define_yaku chombo, "Chombo", [1, "★"], others_status("dead_hand"), ["Han", "yakuman", "meta_yakuman"]
apply set_append, "score_calculation.yaku_lists", ["chombo"]

def chombo do
  set_status("dead_hand")
  unset_status("nagashi")
  pause(500)
  big_text("Chombo")
  pause(500)
  uninterruptible_advance_turn
end

apply initialize, "constants.min_han_check_discard", true
apply initialize, "constants.min_han_check_call", true
apply initialize, "constants.min_han_check_hand", true

replace 1, "buttons.ron.actions", ["win_by_discard", "ron"] do
  if match(["hand", "calls", "last_discard"], ["win"]) and +@min_han_check_discard do
    win_by_discard("ron")
  else chombo end
end

replace 1, "buttons.chankan.actions", ["win_by_call", "ron"] do
  if match(["hand", "calls", "last_called_tile"], ["win"]) and +@min_han_check_call do
    win_by_call("ron")
  else chombo end
end

replace 1, "buttons.tsumo.actions", ["win_by_draw", "tsumo"] do
  if match(["hand", "calls", "draw"], ["win"]) and +@min_han_check_hand do
    win_by_draw("tsumo")
  else chombo end
end

apply append, "buttons.ankan.show_when", status_missing("dead_hand")
apply append, "buttons.ron.show_when", status_missing("dead_hand")
apply append, "buttons.tsumo.show_when", status_missing("dead_hand")
apply append, "buttons.chankan.show_when", status_missing("dead_hand")

on after_turn_change do
  if everyone_status("dead_hand") do
    abortive_draw("Chombo Game")
  else
    if status("dead_hand") do
      uninterruptible_advance_turn
    end
  end
end

# make riichi always available
replace 1, "buttons.riichi.show_when", %{"name": "match", "opts": [["hand", "calls", "draw"], ["win"]]}, true
# make win buttons always available
replace 1, "buttons.ron.show_when", %{"name": "match", "opts": [["hand", "calls"], ["tenpai"]]}, true
replace 1, "buttons.ron.show_when", %{"name": "match", "opts": [["hand", "calls", "last_discard"], ["win"]]}, true
replace 1, "buttons.chankan.show_when", %{"name": "match", "opts": [["hand", "calls"], ["tenpai"]]}, true
replace 1, "buttons.chankan.show_when", %{"name": "match", "opts": [["hand", "calls", "last_called_tile"], ["win"]]}, true
replace 1, "buttons.tsumo.show_when", %{"name": "match", "opts": [["hand", "calls"], ["tenpai"]]}, true
replace 1, "buttons.tsumo.show_when", %{"name": "match", "opts": [["hand", "calls", "draw"], ["win"]]}, true

# you can riichi discard any tile
apply append, "buttons.riichi.actions" do unset_status("just_reached") end

# if you noten riichi, pay 8000 to everyone, and don't increase honba
# TODO make this payment configurable
on before_exhaustive_draw do
  as everyone do
    if status("riichi") and status_missing("tenpai") do
      push_message("must pay 8000 to every player for being noten riichi")
      subtract_score(8000); add_score(8000, "shimocha")
      subtract_score(8000); add_score(8000, "toimen")
      subtract_score(8000); add_score(8000, "kamicha")
      add_honba(-1)
    end
  end
end
