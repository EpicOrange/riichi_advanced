on after_initialization do
  update_rule("Rules", "Chankan", "You may also call ron on concealed kans, but only if you are tenpai for kokushi musou.")
end

replace 1, "buttons.ankan.actions", set_status("kan"), set_status("kan", "can_chankan")
apply append, "buttons.ankan.actions" do unset_status("can_chankan") end

define_const can_chankan,
  status("can_chankan", as: "caller")
  or (print("a") and last_call_is("ankan") and match(["hand", "calls"], ["kokushi_tenpai"]))

apply set_append, "interruptible_actions", ["self_call"]
