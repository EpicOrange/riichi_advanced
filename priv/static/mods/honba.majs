define "honba"

apply initialize, "constants.honba_mult", 3
on after_initialization do
  cond do
    @honba_mult == 3 -> add_rule("Rules", "Honba", "The 100 point sticks in the middle count honba. Each adds %{value} extra points to the winning value. One honba stick is added for every drawn round, and reset to 0 on a win.", %{value: !value * 3})
    @honba_mult == 2 -> add_rule("Rules", "Honba", "The 100 point sticks in the middle count honba. Each adds %{value} extra points to the winning value. One honba stick is added for every drawn round, and reset to 0 on a win.", %{value: !value * 2})
  end
end

define_const honba_value, !value

set display_honba, true
apply set, "score_calculation.honba_value", !value
