define_const round_fu, false
define_const riichi_bet, 100
define_const riichi_score_rounding, 1 # turn off basic rounding
define_const chiitoitsu_tsumo_fu, 30
define_const chiitoitsu_ron_fu, 40
# open pinfu is 20 fu, pinfu tsumo is 22 fu
define_const closed_tsumo_20_fu, false
define_const open_30_fu, false

# disable noten payments
def setup_noten_payments do end
def execute_noten_payments do end

on after_initialization do
  rename_rule_tab("1 ★", "Shoumangan")
  rename_rule_tab("1.5 ★", "Daimangan")
  rename_rule_tab("2 ★", "Choumangan")
  rename_rule_tab("2 Han", "2+ Han")
  rename_rule_tab("3 Han", "2+ Han")
  rename_rule_tab("4 Han", "2+ Han")
  rename_rule_tab("Shoumangan", "Shoumangan")
  rename_rule_tab("Daimangan", "Daimangan")
  rename_rule_tab("Choumangan", "Choumangan")
  delete_rule("1 Han", "Pinfu")
  add_rule("1 Han", "Pinfu", "You won off a double-sided sequence wait, with an all-sequence hand whose pair is not yakuhai.")
  update_rule("1 Han", "Pinfu", "%{example_hand}", %{example_hand: ~t"345789m45p99s 2S34s 6p"})

  add_rule("Rules", "Tontonsen", "The game consists of two east rounds.")
  delete_rule("Rules", "Multiple Ron")
  add_rule("Rules", "Head Bump", "If there are multiple winners, then the earliest winner in turn order gets the full payment for the hand, and the other winners get half each. As for riichi sticks, each winner first takes back their own riichi stick (if any) and any leftover riichi sticks are evenly divided among winners.")
  add_rule("Rules", "Fu", "(Tokyo Rules) Fu is not rounded.")
  add_rule("Rules", "Scoring", "Scores are rounded to the nearest 10, maxing out at 1000 points (considered shoumangan, 4000/6000). Hands that are yakuman in riichi are daimangan (6000/9000), with the exception of chuurenpoutou, which is baimangan (8000/12000)")
  add_rule("Rules", "Minimum Han", "After 1 or more repeats, winning requires a minimum of 1 han.")
  update_rule("2 Han", "Ryuuiisou", "Stacks with Honitsu (2 han), so it is effectively worth 4 han.")

end
define_yaku_precedence "Daichiishin", ["Tsuuiisou"] # for some reason.



