define_const round_fu, false
define_const riichi_bet, 100
define_const riichi_score_rounding, 1 # turn off basic rounding
define_const chiitoitsu_tsumo_fu, 30
define_const chiitoitsu_ron_fu, 40
# open pinfu is 20 fu, pinfu tsumo is 22 fu
define_const closed_tsumo_20_fu, false
define_const open_30_fu, false
define_const open_pinfu, false

on after_initialization do
  rename_rule_tab("1 ★", "Shoumangan")
  rename_rule_tab("1.5 ★", "Daimangan")
  rename_rule_tab("2 ★", "Choumangan")
  rename_rule_tab("2 Han", "2+ Han")
  rename_rule_tab("3 Han", "2+ Han")
  rename_rule_tab("4 Han", "2+ Han")
  rename_rule_tab("Shoumangan", "Shoumangan")
  rename_rule_tab("Daimangan", "Daimangan")
  rename_rule_tab("Choumangan", "Choumangan")

  add_rule("Rules", "Tontonsen", "The game consists of two east rounds.")
  delete_rule("Rules", "Multiple Ron")
  add_rule("Rules", "Head Bump", "If there are multiple winners, then the earliest winner in turn order gets the full payment for the hand, and the other winners get half each. As for riichi sticks, each winner first takes back their own riichi stick (if any) and any leftover riichi sticks are evenly divided among winners.")
  add_rule("Rules", "Fu", "(Tokyo Rules) Fu is not rounded.")
  add_rule("Rules", "Scoring", "Scores are rounded to the nearest 10, maxing out at 1000 points (considered shoumangan, 4000/6000). Hands that are yakuman in riichi are daimangan (6000/9000), with the exception of chuurenpoutou, which is baimangan (8000/12000)")
  add_rule("Rules", "Minimum Han", "After 1 or more repeats, winning requires a minimum of 1 han.")
  update_rule("2 Han", "Ryuuiisou", "Stacks with Honitsu (2 han), so it is effectively worth 4 han.")

end
define_yaku_precedence "Daichiishin", ["Tsuuiisou"] # for some reason.

# disable noten payments
def setup_noten_payments do end
def execute_noten_payments do end

def calculate_base_score do
  cond do
    total > 0 -> noop
    points2 >= 2 ->
      total = 4000 :: "Choumangan base"
      modify_winner("score_name", "Choumangan")
    points2 >= 1.5 ->
      total = 3000 :: "Daimangan base"
      modify_winner("score_name", "Daimangan")
    points >= 7 and dora > 0 ->
      total = 2000 :: "Hanemangan base"
      modify_winner("score_name", "Hanemangan")
    points2 >= 1 ->
      total = 1500 :: "Shoumangan base"
      modify_winner("score_name", "Shoumangan")
    true ->
      han_mult = 2 ** points :: "Han mult."
      total = minipoints :: "Fu"
      total *= han_mult :: "Base"
      if total >= 1000 do
        total = 1000 :: "Shoumangan limit"
      end
      modify_winner("score_name", "Kazumangan")
  end
  base_score = total # save base_score for mods to use
end

def finalize_score, prepend: true do
  # round to nearest 10, which could be up or down
  if mod(total, 10) > 0 do
    total = round(total, 10) :: "Round"
  end
end

def apply_ron_scoring, append: true do
  # in the event of multiple ron, only get half
  if status("win_half", as: "winner") do
    total /= 2 :: "Partial head bump"
  end
end

def check_multiple_ron do
  num_winners += 1
  set_counter_all("num_winners", "num_winners")
  if num_winners > 1 do
    set_status("win_half", as: "prev_seat")
  end
end

apply prepend, "buttons.ron.actions" do check_multiple_ron end
apply prepend, "buttons.chankan.actions" do check_multiple_ron end

def apply_ron_scoring, append: true do
  # in the event of multiple ron, only get half
  if status("win_half", as: "winner") do
    total /= 2 :: "Partial head bump"
  end
end

def precalculate_riichi_payments do
  # winners get their own riichi stick back
  as winners do
    if status("riichi") do
      riichi_bet = @riichi_bet
      subtract_from_pot("riichi_bet")
    end
  end
end

on after_win, prepend: true do
  modify_winner("score", "display_total") # before honba and riichi sticks
  if pot > 0 do precalculate_riichi_payments end
  if status("riichi") do
    total += @riichi_bet :: "Reclaim riichi bet"
  end
  if pot > 0 do
    total += pot :: "Take remaining bets"
    subtract_from_pot("pot") # zero out pot so other players don't get it
  end
end



# to calculate fu, we need to know which sets are sequences and which are triplets
# unfortunately, we can only determine this by comparing yaku
# the relevant sequences yaku are:
# - pinfu (1 han)
# - iipeikou (1 han)
# - ryanpeikou (4 han)
# - isshoku sanjun (3/4 han)
# - ittsuu (2/3 han)
# - sanshoku doujun (2/3 han)
# - isshoku yonjun (★)
# the relevant triplets yaku are:
# - toitoi (2 han)
# - sanshoku doukou (2 han)
# - sanankou (2 han)
# - sanrenkou (3 han)
# - chinchii toushii (4 han)
# - suuankou (★)
# - suuankou tanki (★★)
# obtaining any triplet yaku invalidates all of the sequences yaku, but only if the triplets yaku are worth more

on before_scoring do
  triplet_points = 0
  sequence_points = 0
  if @closed_hand do set_status("closed") end
  # toitoi
  if match(["hand", "calls", "winning_tile"], ~m"koutsu:4, pair:1") do
    triplet_points += 2
  end
  # sanshoku doukou
  if match(["hand", "calls", "winning_tile"], ~m"exhaustive, sanshoku_doukou:1, mentsu:1, pair:1") do
    triplet_points += 3
  end
  # sanankou
  if (won_by_draw and match(["hand", "calls", "winning_tile"], ["sanankou_tsumo"])) or (not_won_by_draw and match(["hand", "calls", "winning_tile"], ["sanankou_ron"])) do
    triplet_points += 2
  end
  # sanrenkou
  if match(["hand", "calls", "winning_tile"], ~m"sanrenkou:1, mentsu:1, pair:1") do
    triplet_points += 3
  end
  # suuankou tanki
  if status("closed") and match(["hand", "calls"], ~m"koutsu:4") and match(["hand", "calls", "winning_tile"], ~m"koutsu:4, pair:1") do
    if triplet_points < 2000 do triplet_points = 0 end
    triplet_points += 2000
  else
    # suuankou
    if won_by_draw and status("closed") and match(["hand", "calls"], ~m"koutsu:3, pair:2") do
      if triplet_points < 1000 do triplet_points = 0 end
      triplet_points += 1000
    end
  end

  # pinfu
  if status("closed")
      and match(["hand", "calls", "winning_tile"], ["standard_win"])
      and ((won_by_draw and minipoints_equals(22)) or (not_won_by_draw and minipoints_equals(20))) do
    sequence_points += 1
  end
  # ryanpeikou
  if status("closed") and match(["hand", "calls", "winning_tile"], ~m"exhaustive, iipeikou:2, pair:1") do
    sequence_points += 4
  else
    # iipeikou
    if status("closed") and match(["hand", "calls", "winning_tile"], ~m"exhaustive, iipeikou:1, mentsu:2, pair:1") do
      sequence_points += 1
    end
  end
  # ittsuu
  if match(["hand", "calls", "winning_tile"], ~m"exhaustive, ittsuu:1, mentsu:1, pair:1") do
    sequence_points += 2
    if status("closed") do
      sequence_points += 1
    end
  end
  # sanshoku doujun
  if match(["hand", "calls", "winning_tile"], ~m"exhaustive, sanshoku_doujun:1, mentsu:1, pair:1") do
    sequence_points += 2
    if status("closed") do
      sequence_points += 1
    end
  end
  # isshoku yonjun
  if match(["hand", "calls", "winning_tile"], ~m"exhaustive, iishoku_yonjun:1, pair:1") do
    sequence_points += 3
    if status("closed") do
      sequence_points += 1
    end
  else
    # isshoku sanjun
    if match(["hand", "calls", "winning_tile"], ~m"exhaustive, iishoku_sanjun:1, mentsu:1, pair:1") do
      sequence_points += 3
      if status("closed") do
        if sequence_points < 1000 do sequence_points = 0 end
        sequence_points += 1000
      end
    end
  end
  # recalculate minipoints based on whether triplet_points >= sequence_points
  calculate_fu_with_maximums
end

# now forbid certain yaku based on the above
define_yaku meta_yaku, "_triplets_win", [0, "Han"], triplet_points >= sequence_points, [
  "_triplets_win",
  "Iipeikou",
  "Ryanpeikou",
  "Isshoku Sanjun",
  "Ittsuu",
  "Sanshoku Doujun",
  "Isshoku Yonjun",
]
define_yaku meta_yaku, "_sequences_win", [0, "Han"], triplet_points < sequence_points, [
  "_sequences_win",
  "Toitoi",
  "Sanshoku Doukou",
  "Sanankou",
  "Sanrenkou",
  "Chinchii Toushii",
  "Suuankou",
  "Suuankou Tanki",
]

define_const triplets_fu, [
  %{groups: ~s"0@tanyao 0@tanyao 0@tanyao", value: 4},
  %{groups: ~s"0@yaochuu 0@yaochuu 0@yaochuu", value: 8},
  %{groups: ~s""} # no-op
]
def calculate_fu_with_maximums do
  # only recalculate fu for a standard win
  if match(["hand", "calls", "winning_tile"], ["standard_win"]) do
    set_counter("fu", "minipoints") do
      # score calls
      convert_calls(@calls_fu)
      remove_calls(["tanyaohai"])
      convert_calls(@calls_fu)
      remove_calls

      remove_groups(@winning_groups_fu)

      # only remove triplets if we're doing triplets
      remove_groups(@triplets_fu, triplet_points >= sequence_points)
      remove_groups(@triplets_fu, triplet_points >= sequence_points)
      remove_groups(@triplets_fu, triplet_points >= sequence_points)
      remove_groups(@triplets_fu, triplet_points >= sequence_points)

      # now remove all closed groups
      remove_groups(@groups_fu)
      prune(method: "tile_count", num_tiles: [1,4,7,10])
      remove_groups(@groups_fu)
      prune(method: "tile_count", num_tiles: [1,4,7,10])
      remove_groups(@groups_fu)
      prune(method: "tile_count", num_tiles: [1,4,7,10])
      remove_groups(@groups_fu)
      prune(method: "tile_count", num_tiles: [1,4,7,10])

      # only retain configurations with 0 tiles remaining
      retain_empty_hands

      # add 1000 to pinfu hands so we prioritize pinfu later
      add(1000, minipoints_equals(0))

      # base 20
      add(20)

      # tsumo +2 always
      add(2, won_by_draw)

      # closed ron +10
      add(10, not_won_by_draw and @closed_hand)

      # take max, then subtract 1000 from pinfu hands
      take_maximum
      add(-1000, minipoints_at_least(1000))
    end
  end
end
