on after_initialization do
  add_rule("Rules", "Furiten", "(Temporary Furiten) If you discard your winning tile, or skip winning on someone else's discard, you cannot win off the same tile until your next draw. You can still win on other tiles, or by self-drawing your winning tile.")
end

on after_turn_change do
  # unset temporary furiten
  # can't check tenpai status rn, since tenpai_check would set it before turn change
  cond do
    seat_is("east")  -> untag_tiles("east_furiten")
    seat_is("south") -> untag_tiles("south_furiten")
    seat_is("west")  -> untag_tiles("west_furiten")
    seat_is("north") -> untag_tiles("north_furiten")
  end
end

def discard_passed, prepend: true do
  # furiten check for everyone including last discarder
  as everyone do
    if match(["hand", "calls", "last_discard"], ["win"]) do
      cond do
        seat_is("east")  -> tag_tiles("east_furiten", "last_discard")
        seat_is("south") -> tag_tiles("south_furiten", "last_discard")
        seat_is("west")  -> tag_tiles("west_furiten", "last_discard")
        seat_is("north") -> tag_tiles("north_furiten", "last_discard")
      end
    end
  end
end

apply prepend, "buttons.ron.show_when", not_seat_is("east") or not_tagged("east_furiten", "last_discard")
apply prepend, "buttons.ron.show_when", not_seat_is("south") or not_tagged("south_furiten", "last_discard")
apply prepend, "buttons.ron.show_when", not_seat_is("west") or not_tagged("west_furiten", "last_discard")
apply prepend, "buttons.ron.show_when", not_seat_is("north") or not_tagged("north_furiten", "last_discard")
apply prepend, "buttons.chankan.show_when", not_seat_is("east") or not_tagged("east_furiten", "last_called_tile")
apply prepend, "buttons.chankan.show_when", not_seat_is("south") or not_tagged("south_furiten", "last_called_tile")
apply prepend, "buttons.chankan.show_when", not_seat_is("west") or not_tagged("west_furiten", "last_called_tile")
apply prepend, "buttons.chankan.show_when", not_seat_is("north") or not_tagged("north_furiten", "last_called_tile")
apply prepend, "buttons.tsumo.show_when", not_seat_is("east") or not_tagged("east_furiten", "draw")
apply prepend, "buttons.tsumo.show_when", not_seat_is("south") or not_tagged("south_furiten", "draw")
apply prepend, "buttons.tsumo.show_when", not_seat_is("west") or not_tagged("west_furiten", "draw")
apply prepend, "buttons.tsumo.show_when", not_seat_is("north") or not_tagged("north_furiten", "draw")
