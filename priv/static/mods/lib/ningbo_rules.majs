on after_initialization do
  add_rule("Tiles", "Base Tiles", "By default, Ningbo mahjong uses the following 144 tiles:", -100)
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of circles %{pinzu}", %{pinzu: ~t"123456789p"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of bamboo %{souzu}", %{souzu: ~t"123456789s"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of characters %{manzu}", %{manzu: ~t"123456789m"})
  add_rule("Tiles", "Base Tiles", "- Four each of the four winds (East, South, West, North) %{winds}", %{winds: ~t"1234z"})
  add_rule("Tiles", "Base Tiles", "- Four each of the three dragons (White, Green, Red) %{dragons}", %{dragons: ~t"067z"})
  add_rule("Tiles", "Base Tiles", "- Four flowers %{flowers}", %{flowers: ~t"1234f"})
  add_rule("Tiles", "Base Tiles", "- Four seasons %{seasons}", %{seasons: ~t"1234g"})
  add_rule("Rules", "Win Condition", "You may win with one of the following:", -100)
  add_rule("Rules", "Win Condition", "- Four sets (sequences or triplets) and a pair.", -100)
  add_rule("Rules", "Minimum Tai", "A winning hand must be worth at least 4 Tai, which can include flowers/seasons/animals.")
  add_rule("Rules", "Instant Payouts", "Declaring kongs and declaring certain flower combinations award instant payouts.", -50)
  add_rule("Rules", "Baida", "Before the round begins, a tile in the wall is flipped to indicate the Baida tile for the round, i.e. the three other copies of the revealed tile. Baida tiles are wildcards. Using Baida tiles as their original tile value (not as a wildcard) scores 1 Tai each.")
  add_rule("1 Tai", "Edge Wait", "1 Tai for winning on an edge wait (12 waiting for 3, or 89 waiting for 7).")
  add_rule("1 Tai", "Closed Wait", "1 Tai for winning on an closed wait (e.g. 35 waiting for 4).")
  add_rule("1 Tai", "Single Wait", "1 Tai for winning on a pair wait (e.g. 3 waiting for 3).")
  add_rule("1 Tai", "Wild Tile/Baida Win", "1 Tai for the winning shape containing a Baida tile.")
  add_rule("1 Tai", "No Wild Tile/Baida", "1 Tai for winning without any Baida tiles.")
  add_rule("1 Tai", "Kong Win", "1 Tai for winning on the replacement tile after declaring a kong (not flower).")
  add_rule("1 Tai", "Last Tile Win", "1 Tai for winning on the last tile drawn from the live wall (so replacement tiles do not count).")
  add_rule("1 Tai", "Self-Draw Win", "1 Tai for winning by drawing the winning tile yourself.")
  add_rule("1 Tai", "Wild Tile Reuse", "1 Tai for using a Baida tile as its original tile.")
  add_rule("1 Tai", "Wild Tile Pair Win", "1 Tai for winning on a pair wait by drawing a Baida tile.")
  add_rule("1 Tai", "Dragon Pung", "1 Tai for any dragon triplet/kong.")
  add_rule("1 Tai", "Round Wind Pung", "1 Tai for a round wind triplet/kong.")
  add_rule("1 Tai", "Seat Wind Pung", "1 Tai for a seat wind triplet/kong.")
  add_rule("2 Tai", "Half Pure Suit", "2 Tai for having only one suit in hand, plus honor tiles.")
  add_rule("2 Tai", "All Triplets", "2 Tai for having 4 triplets and a pair.")
  add_rule("4 Tai", "Pure Suit", "4 Tai for having only one suit in hand.")
  add_rule("5 Tai", "All Honours", "5 Tai for having only honor tiles.")
  add_rule("10 Tai", "Eight Flowers", "10 Tai for having seven flowers and winning by someone else calling an eighth or drawing the eighth yourself.")
  add_rule("10 Tai", "Heavenly Hand", "10 Tai for winning immediately with your initial hand and drawn tile.")
  add_rule("10 Tai", "Earthly Hand", "10 Tai for winning immediately with your initial hand and the dealer's first discard.")
end
