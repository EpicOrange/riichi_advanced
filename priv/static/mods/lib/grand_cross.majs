on after_initialization do
  add_rule("Rules", "Grand Cross", "You can declare NEWS (one of each wind) as a concealed kan, worth 16 fu, and you draw a replacement tile from the live wall.")
end

define_set grand_cross, ~s"1z 2z 3z 4z"
define_button grand_cross,
  display_name: "Grand Cross",
  show_when: our_turn
    and not_no_tiles_remaining
    and not_just_discarded
    and not_just_called
    and status_missing("initial_flowers") # for default_flowers mod
    and tile_not_drawn(-8)
    and self_call_available,
  call: [["1z", "2z", "3z"]],
  call_conditions: called_tile_contains(["4z"], 1),
  call_style: %{
    self: [["1x", 2], 0, 1, ["1x", 3]]
  }
  do
    big_text("Kan")
    self_call
    if status("kan") do
      set_status("double_kan")
    end
    set_status("kan")
    draw(1)
  end

# grand cross flips kandora immediately
apply set_append, "constants.closed_kans", ["grand_cross"]

# so "auto skip calls" doesn't skip over grand cross
apply append, "constants.no_auto_discard_buttons", ["grand_cross"]

# grand cross counts as a set for match and SMT
apply append, "set_definitions.mentsu", ~s"1z 2z 3z 4z"
# but don't let riichi button appear if uncalled grand cross is in hand
# (as that might mean zero discardable tiles for riichi)
define_match grand_cross_not_riichi, ~m"(ton nan shaa pei):-1, grand_cross:1 | (ton nan shaa pei):1, grand_cross:1"
apply append, "buttons.riichi.show_when", not_match(["hand"], ["grand_cross_not_riichi"])
apply append, "buttons.open_riichi.show_when", not_match(["hand"], ["grand_cross_not_riichi"])

# this 8 fu gets doubled by fu calculation since it's honors
apply merge, "constants.calls_fu", %{grand_cross: 8}

# grand cross counts for sankantsu etc.
apply set_append, "set_definitions.kan_call", ~s"grand_cross"
