define_mod_category "Other"
define_mod show_waits, name: "Show Waits", category: "Other", desc: "Add some UI that shows waits."
define_mod open_hands, name: "Open Hands", category: "Other", desc: "Everyone plays with tiles shown."
define_mod four_rows_discards, name: "Four Rows Discards", category: "Other", desc: "Change the arrangement of the discard pond past the 18th discard to accomodate more discards."
apply set_append, "default_mods", ["show_waits"]
