default list, "yaku"
default name, "Sankantsu"
default value, 0
default closed_name, ""
default closed_value, 0

on after_initialization do
  add_rule("$value $han", !name, "%{value} %{han} if you called %{kan} three times.", %{value: !value, han: !han, kan: !kan_name})
  update_rule("$value $han", !name, "%{example_hand}", %{value: !value, han: !han, example_hand: ~t"567p3z 8P888p 2z22Z2z 999m9M 3z"})
end

define_set open_kan_call, ~s"daiminkan|kakan"
define_set closed_kan_call, ~s"ankan"
if !closed_value > 0 do
  define_yaku !list, !name, [!value, !han], match(["calls"], ~m"open_kan_call:3")
  define_yaku !list, !closed_name, [!closed_value, !han], match(["calls"], ~m"closed_kan_call:3")
else
  define_yaku !list, !name, [!value, !han], match(["calls"], ~m"(open_kan_call closed_kan_call):3")
end
