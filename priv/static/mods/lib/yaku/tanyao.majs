require "value_honors"

default list, "yaku"
default name, "Tanyao"
default value, 1
default closed_only, false

on after_initialization do
  add_rule("$value $han", !name, "%{value} %{han} if your hand consists only of 2-8 number tiles.", %{value: !value, han: !han})
  if !closed_only do
    update_rule("$value $han", !name, "(Kuitan Nashi) Your hand must be closed.", %{value: !value, han: !han})
  end
  update_rule("$value $han", !name, "%{example_hand}", %{value: !value, han: !han, example_hand: ~t"234m33777p45s 678s 6s"})
end

define_set tanyao_mentsu, ~s"0@tanyao 0@tanyao 0@tanyao|0@tanyao 1@tanyao 2@tanyao"
define_set tanyao_pair, ~s"0@tanyao 0@tanyao"
define_match tanyao, ~m"exhaustive, tanyao_mentsu:4, tanyao_pair:1"
if !closed_only do
  apply initialize, "constants.closed_hand", has_no_call_named("chii", "pon", "daiminkan", "kakan")
  define_yaku !list, !name, [!value, !han], @closed_hand and match(["hand", "calls", "winning_tile"], ["tanyao"])
else
  define_yaku !list, !name, [!value, !han], match(["hand", "calls", "winning_tile"], ["tanyao"])
end

