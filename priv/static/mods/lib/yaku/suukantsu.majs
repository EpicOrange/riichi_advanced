default list, "yaku"
default closed_name, ""
default closed_value, 0

on after_initialization do
  add_rule("$value $han", "$name", "%{value} %{han} if you called %{kan} four times.", %{value: !value, han: !han, name: !name, kan: !kan_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{value: !value, han: !han, name: !name, example_hand: ~t"3z 5555p 8888p 2222z 9999m 3z"})
end

if !closed_value > 0 do
  define_yaku !list, !name, [!value, !han], match(["calls"], ~m"(daiminkan kakan):4")
  define_yaku !list, !closed_name, [!closed_value, !han], match(["calls"], ~m"ankan:4")
else
  define_yaku !list, !name, [!value, !han], match(["calls"], ~m"(daiminkan ankan kakan):4")
end
