default list, "yaku"
default name, "Shiisanpuutaa"
default value, 1

on after_initialization do
  if equals(!name, "Shiisanpuutaa") do
    add_rule("$value $han", !name, "\"Thirteen Unconnected\". Your starting hand is made of 13 disconnected tiles, plus one forming a pair. Calls invalidate.", %{value: !value, han: !han}, 113)
  else
    add_rule("$value $han", !name, "Your starting hand is made of 13 disconnected tiles, plus one forming a pair. Calls invalidate.", %{value: !value, han: !han}, 113)
  end
  update_rule("$value $han", !name, "%{example_hand}", %{value: !value, han: !han, example_hand: ~t"208m449p47s123456z"})
  add_rule("Rules", "Win Condition", "- (%{name}) Start with 13 disconnected tiles, plus one forming a pair.", %{name: !name}, -100)
end

define_match shiisanpuutaa, ~m"pair:1, taatsu:-1"
define_yaku !list, !name, [!value, !han], status("shiisanpuutaa"), ["Tsumo"]

define_button shiisanpuutaa,
  display_name: "Tsumo (Shiisanpuutaa)",
  show_when: our_turn and has_draw and status("first_turn") and match(["hand", "draw"], ["shiisanpuutaa"])
  do
    set_counter("fu", 30)
    set_status("shiisanpuutaa")
    unset_status("first_turn") # prevent tenhou/chiihou
    big_text("Tsumo")
    pause(1000)
    reveal_hand
    win_by_draw("tsumo")
  end
