default list, "yaku"
default name, "Tsumo"
default value, 1
default ankan_name, "Ankan"

on after_initialization do
  add_rule("$value $han", !name, "%{value} %{han} if you win by self-draw without having called any tiles (except %{ankan}).", %{value: !value, han: !han, ankan: !ankan_name})
end

apply initialize, "constants.closed_hand", has_no_call_named("chii", "pon", "daiminkan", "kakan")
define_yaku !list, !name, [!value, !han], won_by_draw and @closed_hand
