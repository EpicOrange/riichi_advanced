require "value_honors"

default shou_list, "yaku"
default shou_name, "Shousuushii"
default shou_value, 0
default shou_han, !han
default dai_list, "yaku"
default dai_name, "Daisuushii"
default dai_value, 0
default dai_han, !han

if !shou_value > 0 do
  on after_initialization do
    add_rule("$value $han", !shou_name, "%{value} %{han} if you have triplets of three different winds, and a pair of the fourth.", %{value: !shou_value, han: !shou_han})
    update_rule("$value $han", !shou_name, "%{example_hand}", %{value: !shou_value, han: !shou_han, example_hand: ~t"23s22233444z 1z1Z1z 4s"})
  end
  define_yaku !shou_list, !shou_name, [!shou_value, !shou_han], match(["hand", "calls", "winning_tile"], ~m"unique, (ton nan shaa pei):3, (ton_pair nan_pair shaa_pair pei_pair):1")
end

if !dai_value > 0 do
  on after_initialization do
    add_rule("$value $han", !dai_name, "%{value} %{han} if you have triplets of all four winds.", %{value: !dai_value, han: !dai_han})
    update_rule("$value $han", !dai_name, "%{example_hand}", %{value: !dai_value, han: !dai_han, example_hand: ~t"22s22233444z 1z1Z1z 3z"})
  end
  define_yaku !dai_list, !dai_name, [!dai_value, !dai_han], match(["hand", "calls", "winning_tile"], ~m"unique, (ton nan shaa pei):4")
  if !shou_value > 0 do define_yaku_precedence !dai_name, [!shou_name] end
end
