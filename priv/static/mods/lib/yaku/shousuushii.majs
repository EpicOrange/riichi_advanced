require "value_honors"
default shou_list, "yaku"
default shou_name, ""
default shou_value, 0
default shou_han, !han
default dai_list, "yaku"
default dai_name, ""
default dai_value, 0
default dai_han, !han

on after_initialization do
  add_rule("$value $han", "$name", "%{value} %{han} if you have triplets of three different winds, and a pair of the fourth.", %{value: !shou_value, han: !shou_han, name: !shou_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{value: !shou_value, han: !shou_han, name: !shou_name, example_hand: ~t"23s22233444z 111z 4s"})
  add_rule("$value $han", "$name", "%{value} %{han} if you have triplets of all four winds.", %{value: !dai_value, han: !dai_han, name: !dai_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{value: !dai_value, han: !dai_han, name: !dai_name, example_hand: ~t"22s22233444z 111z 3z"})
end

define_yaku !shou_list, !shou_name, [!shou_value, !shou_han], match(["hand", "calls", "winning_tile"], ~m"unique, (ton nan shaa pei):3, (ton_pair nan_pair shaa_pair pei_pair):1")
define_yaku !dai_list, !dai_name, [!dai_value, !dai_han], match(["hand", "calls", "winning_tile"], ~m"unique, (ton nan shaa pei):4")
define_yaku_precedence !dai_name, [!shou_name]

# pao
on after_call do
  if match(["last_call"], ~m"(ton nan shaa pei):1") and match(["calls"], ~m"ton:1, nan:1, shaa:1, pei:1") do
    as callee do
      make_responsible_for("caller", "all")
    end
  end
end
