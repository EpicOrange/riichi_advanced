default list, "yaku"
default name, "Kanburi"
default value, 1

on after_initialization do
  add_rule("$value $han", "$name", "%{value} %{han} if you win off the tile discarded by a player who just called kan.", %{value: !value, han: !han, name: !name})
end

define_yaku !list, !name, [!value, !han], won_by_discard and discarder_status("kan")
