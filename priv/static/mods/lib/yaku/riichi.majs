default bet, 1000
default name, "Riichi"
default value, 1
default double_name, "Double Riichi"
default double_value, 0
default closed_only, true
default drawless, false

define_const riichi_bet, !bet

on after_initialization do
  if @riichi_bet > 0 do
    if !double_value > 0 do
      add_rule("Rules", !name, "If you can, you may discard into tenpai (ready hand) by declaring %{name} to lock your hand. If your discard passes, you bet %{bet} points. If you win, you are awarded %{name} (%{value} %{han}). If you declared %{name} on your very first discard, then you are instead awarded %{double_name} (%{double_value} %{han}). Calls before the riichi declaration invalidate %{double_name}.", %{bet: @riichi_bet, name: !name, value: !value, double_name: !double_name, double_value: !double_value, han: !han})
    else
      add_rule("Rules", !name, "If you can, you may discard into tenpai (ready hand) by declaring %{name} to lock your hand. If your discard passes, you bet %{bet} points. If you win, you are awarded %{name} (%{value} %{han}).", %{bet: @riichi_bet, name: !name, value: !value, han: !han})
    end
  else
    if !double_value > 0 do
      add_rule("Rules", !name, "If you can, you may discard into tenpai (ready hand) by declaring %{name} to lock your hand. If you win, you are awarded %{name} (%{value} %{han}). If you declared %{name} on your very first discard, then you are instead awarded %{double_name} (%{double_value} %{han}). Calls before the riichi declaration invalidate %{double_name}.", %{name: !name, value: !value, double_name: !double_name, double_value: !double_value, han: !han})
    else
      add_rule("Rules", !name, "If you can, you may discard into tenpai (ready hand) by declaring %{name} to lock your hand. If you win, you are awarded %{name} (%{value} %{han}).", %{name: !name, value: !value, han: !han})
    end
  end
  add_rule("$value $han", !name, "%{value} %{han} for winning after declaring %{name}.", %{name: !name, value: !value, han: !han})
  if !double_value > 0 do
    add_rule("$value $han", !double_name, "%{value} %{han} for winning after declaring %{name} on your first discard.", %{name: !name, value: !double_value, han: !han})
  end
  add_rule("Rules", "No Ippatsu", "Winning in the first go-around after your riichi declaration does not award Ippatsu.")
end
 
apply set_prepend, "score_calculation.yaku_lists", ["riichi_yaku"]
define_yaku_precedence "yakuman", ["riichi_yaku"]

define_yaku riichi_yaku, !name, [!value, !han], status("riichi")
define_yaku riichi_yaku, !double_name, [!double_value, !han], status("double_riichi")
define_yaku_precedence !double_name, [!name]
 
define_const chiitoitsu_tenpai_14, ~m"(nojoker quad):-1, (nojoker koutsu):-2, pair:6"
define_match tenpai_14, +@standard_tenpai, +@chiitoitsu_tenpai_14, +@kokushi_tenpai

set display_riichi_sticks, true

apply set, "score_calculation.riichi_value", @riichi_bet

apply initialize, "constants.closed_hand", has_no_call_named("chii", "pon", "daiminkan", "kakan")
define_button riichi,
  display_name: !name,
  show_when: our_turn
    and has_draw
    and status_missing("riichi")
    and has_score("riichi_value")
    and (!drawless or next_draw_possible)
    and (not !closed_only or @closed_hand)
    and match(["hand", "calls", "draw"], ["tenpai_14"])
  do
    big_text(!name)
    set_status("riichi", "just_reached")
    if status("discards_empty") and no_calls_yet do
      set_status("double_riichi")
      push_message("declared $riichi", %{riichi: !double_name})
    else
      push_message("declared $riichi", %{riichi: !name})
    end
  end

apply append, "buttons.chii.show_when", status_missing("riichi")
apply append, "buttons.pon.show_when", status_missing("riichi")
apply append, "buttons.daiminkan.show_when", status_missing("riichi")
apply append, "buttons.kakan.call_conditions", status_missing("riichi") or not_call_changes_waits("win")
apply append, "buttons.ankan.call_conditions", status_missing("riichi") or not_call_changes_waits("win")
apply append, "buttons.daiminnobekan.show_when", status_missing("riichi")
apply append, "buttons.kanobekan.call_conditions", status_missing("riichi") or not_call_changes_waits("win")
apply append, "buttons.annobekan.call_conditions", status_missing("riichi") or not_call_changes_waits("win")
apply append, "buttons.grand_cross.call_conditions", status_missing("riichi") or not_call_changes_waits("win")
apply append, "buttons.ron.show_when", status_missing("just_reached")
apply append, "buttons.chankan.show_when", status_missing("just_reached")
apply append, "buttons.tsumo.show_when", status_missing("just_reached")
 
def discard_passed, prepend: true do
  as last_discarder do
    if status("just_reached") do
      place_riichi_stick
      enable_auto_button("_4_auto_discard")
    end
    unset_status("just_reached")
  end
end

def place_riichi_stick do
  if status_missing("riichi_stick_placed") do
    subtract_score("riichi_value")
    put_down_riichi_stick
    set_status("riichi_stick_placed")
  end
end

define_play_restriction "any", status("riichi") and status_missing("just_reached") and not_is_drawn_tile
define_play_restriction "any", status("riichi", "just_reached") and needed_for_hand("tenpai")
