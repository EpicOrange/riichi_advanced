require "value_honors"
default shou_list, "yaku"
default shou_name, ""
default shou_value, 0
default shou_han, !han
default dai_list, "yaku"
default dai_name, ""
default dai_value, 0
default dai_han, !han

on after_initialization do
  add_rule("$value $han", "$name", "%{value} %{han} if you have triplets of two different dragons, and a pair of the third.", %{value: !shou_value, han: !shou_han, name: !shou_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{value: !shou_value, han: !shou_han, name: !shou_name, example_hand: ~t"123m23s66777z 000z 4s"})
  add_rule("$value $han", "$name", "%{value} %{han} if you have triplets of all three dragons.", %{value: !dai_value, han: !dai_han, name: !dai_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{value: !dai_value, han: !dai_han, name: !dai_name, example_hand: ~t"123m22s66777z 000z 6z"})
end

define_yaku !shou_list, !shou_name, [!shou_value, !shou_han], match(["hand", "calls", "winning_tile"], ~m"unique, (haku hatsu chun):2, (haku_pair hatsu_pair chun_pair):1")
define_yaku !dai_list, !dai_name, [!dai_value, !dai_han], match(["hand", "calls", "winning_tile"], ~m"haku:1, hatsu:1, chun:1")
define_yaku_precedence !dai_name, [!shou_name]

on after_call do
  if match(["last_call"], ~m"(haku hatsu chun):1") and match(["calls"], ~m"haku:1, hatsu:1, chun:1") do
    as callee do
      make_responsible_for("caller", "all")
    end
  end
end