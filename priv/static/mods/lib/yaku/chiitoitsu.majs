default list, "yaku"
default name, "Seven Pairs"
default value, 0
default kansai, true

on after_initialization do
  unless rule_exists("Rules", "Win Condition") do
    add_rule("Rules", "Win Condition", "You may win with one of the following:", -100)
  end
  if !kansai do
    add_rule("Rules", "Win Condition", "- Seven pairs (repeated pairs OK).", -100)
    if !value > 0 do
      add_rule("$value $han", !name, "%{value} %{han} if your hand consists of seven pairs (repeated pairs OK).", %{value: !value, han: !han})
      update_rule("$value $han", !name, "%{example_hand}", %{example_hand: ~t"2266m999p4477s33z 9p"})
    end
  else
    add_rule("Rules", "Win Condition", "- Seven pairs (no repeated pairs).", -100)
    if !value > 0 do
      add_rule("$value $han", !name, "%{value} %{han} if your hand consists of seven pairs (no repeated pairs).", %{value: !value, han: !han})
      update_rule("$value $han", !name, "%{example_hand}", %{example_hand: ~t"2266m339p4477s33z 9p"})
    end
  end
end

define_set pair, ~s"0 0"
if !kansai do
  define_match chiitoitsu_tenpai, ~m"pair:6, any:1"
  define_match chiitoitsu_win, ~m"pair:7"
else
  define_match chiitoitsu_tenpai, ~m"(nojoker koutsu):-1, pair:6, any:1"
  define_match chiitoitsu_win, ~m"(nojoker quad):-1, pair:7"
end

apply set_append, "tenpai_definition", ["chiitoitsu_tenpai"]
apply set_append, "win_definition", ["chiitoitsu_win"]

if !value > 0 do
  define_yaku !list, !name, [!value, !han], match(["hand", "calls", "winning_tile"], ~m"pair:7")
end
