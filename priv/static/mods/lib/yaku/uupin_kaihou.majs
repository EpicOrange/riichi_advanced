default list, "yaku"
default name, "Uupin Kaihou"
default value, 4 # ignored if is_mangan is true
default is_mangan, true

if !is_mangan do
  on after_initialization do
    add_rule("Mangan", !name, "\"Gathering a Plum Blossom from the Roof\". Mangan if you win with rinshan on the 5p (5 circles).", 105)
    update_rule("Mangan", !name, "%{example_hand}", %{example_hand: ~t"34055p111s11z 22z2Z 5p"})
  end
  define_yaku !list, !name, [5, !han], status("kan") and match(["winning_tile"], ~m"5p:1") and not_has_points(5), ["Rinshan"]
  define_yaku_precedence !name, [[1, !han], [2, !han], [3, !han], [4, !han]]
else
  on after_initialization do
    add_rule("$value $han", !name, "\"Gathering a Plum Blossom from the Roof\". %{value} %{han} if you win with rinshan on the 5p (5 circles).", %{value: !value, han: !han}, 105)
    update_rule("$value $han", !name, "%{example_hand}", %{value: !value, han: !han, example_hand: ~t"34055p111s11z 22z2Z 5p"})
  end
  define_yaku !list, !name, [!value, !han], status("kan") and match(["winning_tile"], ~m"5p:1"), ["Rinshan"]
end
