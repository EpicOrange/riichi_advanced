require "value_honors"

default list, "yaku"
default name, "Ryuuiisou"
default value, 1

on after_initialization do
  add_rule("$value $han", !name, "%{value} %{han} if your hand consists of only all-green tiles (23468 bamboo and green dragon).", %{value: !value, han: !han})
  update_rule("$value $han", !name, "%{example_hand}", %{value: !value, han: !han, example_hand: ~t"2234466888s 6Z66z 3s"})
end

define_yaku !list, !name, [!value, !han], winning_hand_consists_of("2s","3s","4s","6s","8s","6z")


