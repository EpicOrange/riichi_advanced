require "standard_sets"

default list, "yaku"
default name, "Ketsupaihou"
default value, 1

on after_initialization do
  add_rule("$value $han", !name, "\"Missing Tile\". Win with an edge or middle wait on a tile for which three copies are already publicly visible.", %{value: !value, han: !han})
  update_rule("$value $han", !name, "%{example_hand}", %{value: !value, han: !han, example_hand: ~t"12999p11567m 33p3P 3p"})
end

define_match ketsupaihou, ~m"exhaustive, (penchan kanchan):1, mentsu:3, pair:1"
define_set ketsupaihou, ~s"0@winning_tile 0 0 0"
define_yaku !list, !name, [!value, !han],
  match(["hand", "calls", "winning_tile"], ["ketsupaihou"]) and match(["winning_tile", "visible_tiles"], ~m"(nojoker ketsupaihou):1")
