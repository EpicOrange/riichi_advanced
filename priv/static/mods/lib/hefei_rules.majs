
on after_initialization do
  add_rule("Tiles", "Base Tiles", "By default, Hefei mahjong uses the following 84 tiles:", -100)
  add_rule("Tiles", "Base Tiles", "- Four each of the 2 to 8 of circles %{pinzu}", %{pinzu: ~t"2345678p"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 2 to 8 of bamboo %{souzu}", %{souzu: ~t"2345678s"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 2 to 8 of characters %{manzu}", %{manzu: ~t"2345678m"})
  add_rule("Rules", "Win Condition", "You may win with one of the following:", -100)
  add_rule("Rules", "Win Condition", "- Four sets (sequences or triplets) and a pair.", -100) 
  add_rule("Rules", "Win Condition", "- Seven pairs (repeats OK).", -100)
  add_rule("1 嘴", "Suit Bonus", "1 嘴 for each tile in your 8+ tile suit past 8 tiles.")
  add_rule("1 嘴", "Single Wait", "1 嘴 for winning on one specific tile.")
  update_rule("1 嘴", "Single Wait", "%{example_hand}", %{example_hand: ~t"123456789m12p11z 3p"})
  update_rule("1 嘴", "Single Wait", "%{example_hand2}", %{example_hand2: ~t"123456789m24p11z 3p"})
  update_rule("1 嘴", "Single Wait", "%{example_hand3}", %{example_hand3: ~t"123456789m3p111z 3p"})
  add_rule("1 嘴", "Same Number Bonus", "1 嘴 if you have 4+ tiles of a single number (ignore suit). This awards 1 嘴 for each such tile, starting from the fourth. At 10+ tiles, award Ten Identical Tiles (100 嘴) instead.")
  delete_rule("1 嘴", "Concealed Pung")
  delete_rule("1 嘴", "Concealed Pungs")
  add_rule("1 嘴", "Concealed Pungs", "1 嘴 for each concealed triplet in hand. A triplet completed by a self-draw win counts as concealed.")
  update_rule("1 嘴", "Concealed Pungs", "%{example_hand}", %{example_hand: ~t"222678m444p123s1z 1z"})
  add_rule("2 嘴", "Double Sequences", "2 嘴 for having two of the exact same sequence. If these sequences are hidden in hand, instead score Concealed Double Sequences (4 嘴).")
  add_rule("2 嘴", "Two Suits Only", "2 嘴 for omitting one whole suit from your hand.")
  add_rule("4 嘴", "Concealed Double Sequences", "4 嘴 for having two of the exact same sequence hidden in hand.")
  add_rule("4 嘴", "Concealed Kong", "4 嘴 for each concealed kong.")
  add_rule("4 嘴", "Four of a Kind", "4 嘴 for having all four of a tile in hand or calls (not declared as a kong)")
  add_rule("Mult", "Dealer Repeat", "Your final score is multiplied by the number of times the dealership is kept without a nondealer winning. (min 1)")
  rename_rule_tab("2 ×", "Mult")
  # add_rule("Special", "Seven Pairs", "10 嘴 for winning with seven pairs.")
  add_rule("Special", "Sea Floor", "15 嘴 for winning using one of the last 4 tiles drawn from the wall.")
  add_rule("Special", "Luxury Seven Pairs", "50 嘴 for winning with seven pairs, but one of your pairs is duplicated (you have 4 of a kind).")
  add_rule("Special", "Double Luxury Seven Pairs", "100 嘴 for winning with seven pairs, but two of your pairs are duplicated (you have two 4 of a kinds).")
  add_rule("Special", "Pure Suit", "100 嘴 for having for having only one suit in hand, with no honor tiles.")
  # add_rule("Special", "Three Consecutive Pungs", "100 嘴 for having three triplets that are in consecutive order (222 333 444).")
  # add_rule("Special", "Four Concealed Pungs", "100 嘴 for having four triplets hidden in your winning hand.")
  add_rule("Special", "Ten Identical Tiles", "100 嘴 for having ten tiles of the same number.")
  add_rule("Special", "Double Concealed Double Sequences", "100 嘴 for having two of the exact same sequence hidden in hand twice.")
  # add_rule("Special", "Heavenly Win", "200 嘴 for winning immediately with your initial hand as dealer.")
  # add_rule("Special", "Earthly Win", "150 嘴 for winning immediately with your initial hand and drawn tile, as a non-dealer.")
end
