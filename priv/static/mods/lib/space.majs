define "space"

on after_initialization do
  add_rule("Rules", "Space Mahjong", "Sequences can wrap (891, 912). Winds and dragons can make sequences. You can chii from any direction.")
  add_rule("Rules", "Win Condition", "- (Space Mahjong) Seven Pairs is no longer a winning hand.", -100)
  add_rule("3+ Han", "Open Kokushi Musou", "(Space Mahjong) Open kokushi musou is worth 3 han.")
  update_rule("3+ Han", "Open Kokushi Musou", "%{example_hand}", %{example_hand: ~t"19m99p19s2z 1z3Z4z 5Z67z 1p"})
end

define_yaku yaku, "Open Kokushi Musou", 3, match(["hand", "call_tiles", "winning_tile"], ~m"orphans_all:1")

# remove chiitoitsu
apply subtract, "default_mods", [
  %{name: "lib/yaku/chiitoitsu", config: %{kansai: false, name: "Chiitoitsu", value: 2}},
]

# sequences wrap, and honors form wrapping sequences
on after_start do
  set_tile_ordering_all(["9m", "1m"])
  set_tile_ordering_all(["9p", "1p"])
  set_tile_ordering_all(["9s", "1s"])
  set_tile_ordering_all(["1z", "2z", "3z", "4z", "1z"])
  set_tile_ordering_all(["5z", "6z", "7z", "5z"])
end

# change fu calculation to count penchan as ryanmen
define_const winning_groups_fu, [
  # kanchan
  %{groups: ~s"-1 0@winning_tile 1", value: 2},
  # ryanmen
  %{groups: ~s"0@winning_tile -1 -2"},
  %{groups: ~s"0@winning_tile 1 2"},
  # shanpon
  %{groups: ~s"0@tanyao 0@tanyao 0@winning_tile&ron", value: 2},
  %{groups: ~s"0@yaochuu 0@yaochuu 0@winning_tile&ron", value: 4},
  %{groups: ~s"0@tanyao 0@tanyao 0@winning_tile&tsumo", value: 4},
  %{groups: ~s"0@yaochuu 0@yaochuu 0@winning_tile&tsumo", value: 8},
  # tanki
  %{groups: ~s"0@not_yakuhai 0@winning_tile", value: 2},
  %{groups: ~s"0@prevalent 0@winning_tile | 0@seat 0@winning_tile | 5z 5z@winning_tile | 6z 6z@winning_tile | 7z 7z@winning_tile", value: 4}
]

# chii from anyone
apply set, "buttons.chii.show_when", not_our_turn and not_no_tiles_remaining and someone_else_just_discarded and call_available
