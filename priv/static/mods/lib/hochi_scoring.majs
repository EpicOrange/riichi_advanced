define_const round_fu, false
define_const riichi_bet, 300
define_const riichi_score_rounding, 1 # turn off basic rounding

# fix rules tabs
on after_initialization do
  rename_rule_tab("Yakuman", "Daimangan")
  rename_rule_tab("1 ★", "Shoumangan")
  rename_rule_tab("1.5 ★", "Daimangan")
  rename_rule_tab("2 ★", "Baimangan")
  delete_rule("1 Han", "Pinfu")
  
  add_rule("1 Han", "Pinfu", "You won off a double-sided sequence wait, with an all-sequence hand whose pair is not yakuhai.")
  update_rule("1 Han", "Pinfu", "%{example_hand}", %{example_hand: ~t"345789m45p99s 2S34s 6p"})

  add_rule("Shoumangan", "Daichiishin", "Shoumangan if you have one pair of each of the seven honor tiles.")
  update_rule("Shoumangan", "Daichiishin", "%{example_hand}", %{example_hand: ~t"1122334455667z 7z"})

  delete_rule("Daimangan", "Chuurenpoutou")
  add_rule("Baimangan", "Chuurenpoutou", "Baimangan if you have no calls and your winning hand is the pattern 1112345678999 in one suit, plus one additional tile.")
  update_rule("Baimangan", "Chuurenpoutou", "%{example_hand}", %{example_hand: ~t"1112345568999s 7s"})
end

replace_yaku yaku, "Honroutou", [1, "★"]
define_yaku yakuman, "Daichiishin", [1.5, "★"], has_existing_yaku("Chiitoitsu") and winning_hand_consists_of("1z","2z","3z","4z","5z","6z","7z"), ["Tsuuiisou"]
replace_yaku yakuman, "Suukantsu", [1.5, "★"]
replace_yaku yakuman, "Suuankou", [1.5, "★"]
replace_yaku yakuman, "Daisangen", [1.5, "★"]
replace_yaku yakuman, "Kokushi", [1.5, "★"]
replace_yaku yakuman, "Shousuushii", [1.5, "★"]
replace_yaku yakuman, "Daisuushii", [1.5, "★"]
replace_yaku yakuman, "Tsuuiisou", [1.5, "★"]
replace_yaku yakuman, "Chinroutou", [1.5, "★"]
replace_yaku yakuman, "Tenhou", [1.5, "★"]
replace_yaku yakuman, "Chiihou", [1.5, "★"], current_turn_is("east") and status("first_turn") and won_by_discard
replace_yaku yakuman, "Chuurenpoutou", [2, "★"]
remove_yaku meta_yakuman, "Suuankou Tanki"
remove_yaku meta_yakuman, "Junsei Chuurenpoutou"
remove_yaku meta_yakuman, "Kokushi Musou Juusan Menmachi"

# allow open pinfu and pinfu tsumo
replace_yaku yaku, "Pinfu", [1, "Han"], match(["hand", "calls", "winning_tile"], ["standard_win"])
  and ((won_by_draw and minipoints_equals(22)) or minipoints_equals(20))

# min han but only if there's honba
define_const min_han_check_discard,
     honba == 0
  or has_yaku_with_discard(1, "Han")
  or has_yaku_with_discard(1, "★")
define_const min_han_check_call, @min_han_check_discard
replace all, "constants.min_han_check_call", "has_yaku_with_discard", "has_yaku_with_call"
define_const min_han_check_hand, @min_han_check_discard
replace all, "constants.min_han_check_hand", "has_yaku_with_discard", "has_yaku_with_hand"
apply append, "buttons.ron.show_when", +@min_han_check_discard
apply append, "buttons.chankan.show_when", +@min_han_check_call
apply append, "buttons.tsumo.show_when", +@min_han_check_hand

# disable noten payments
def setup_noten_payments do end
def execute_noten_payments do end

def calculate_base_score do
  cond do
    total > 0 -> noop
    points2 >= 2 ->
      total = 2000 :: "Baimangan base"
      modify_winner("score_name", "Baimangan")
    points2 >= 1.5 ->
      total = 1500 :: "Daimangan base"
      modify_winner("score_name", "Daimangan")
    points2 >= 1 ->
      total = 1000 :: "Shoumangan base"
      modify_winner("score_name", "Shoumangan")
    true ->
      han_mult = 2 ** points :: "Han mult."
      total = minipoints :: "Fu"
      total *= han_mult :: "Base"
      if total >= 1000 do
        total = 1000 :: "Shoumangan limit"
      end
  end
  base_score = total # save base_score for mods to use
end

def finalize_score, prepend: true do
  # round to nearest 10, which could be up or down
  if mod(total, 10) > 0 do
    total = round(total, 10) :: "Round"
  end
end

def apply_ron_scoring, append: true do
  # in the event of multiple ron, only get half
  if status("win_half", as: "winner") do
    total /= 2 :: "Partial head bump"
  end
end

def check_multiple_ron do
  num_winners += 1
  set_counter_all("num_winners", "num_winners")
  if num_winners > 1 do
    set_status("win_half", as: "prev_seat")
  end
end
apply prepend, "buttons.ron.actions" do check_multiple_ron end
apply prepend, "buttons.chankan.actions" do check_multiple_ron end

def precalculate_riichi_payments do
  # winners get their own riichi stick back
  # then divide remaining pot among winners
  # (this could be from nonwinner riichi bets, or from prev rounds)
  as winners do
    if status("riichi") do
      riichi_bet = @riichi_bet
      subtract_from_pot("riichi_bet")
    end
  end
  riichi_share = round(pot / num_winners, 10)
  set_counter_all("riichi_share", "riichi_share")
  subtract_from_pot("pot") # zero out pot so `riichi_scoring` mod doesn't use it
end

on after_win, prepend: true do
  modify_winner("score", "display_total") # before honba and riichi sticks
  if pot > 0 do precalculate_riichi_payments end
  if status("riichi") do
    total += @riichi_bet :: "Reclaim riichi bet"
  end
  if riichi_share > 0 do
    total += riichi_share :: "Split remaining bets"
  end
end
