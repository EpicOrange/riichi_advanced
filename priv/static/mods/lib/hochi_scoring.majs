define_const round_fu, false
define_const riichi_bet, 300
define_const riichi_score_rounding, 1 # turn off basic rounding

# min han but only if there's honba
define_const min_han_check_discard,
     honba == 0
  or has_yaku_with_discard(1, "Han")
  or has_yaku_with_discard(1, "★")
define_const min_han_check_call, @min_han_check_discard
replace all, "constants.min_han_check_call", "has_yaku_with_discard", "has_yaku_with_call"
define_const min_han_check_hand, @min_han_check_discard
replace all, "constants.min_han_check_hand", "has_yaku_with_discard", "has_yaku_with_hand"
apply append, "buttons.ron.show_when", +@min_han_check_discard
apply append, "buttons.chankan.show_when", +@min_han_check_call
apply append, "buttons.tsumo.show_when", +@min_han_check_hand

# disable noten payments
def setup_noten_payments do end
def execute_noten_payments do end

def finalize_score, prepend: true do
  # round to nearest 10, which could be up or down
  if mod(total, 10) > 0 do
    total = round(total, 10) :: "Round"
  end
end

def apply_ron_scoring, append: true do
  # in the event of multiple ron, only get half
  if status("win_half", as: "winner") do
    total /= 2 :: "Partial head bump"
  end
end

def check_multiple_ron do
  num_winners += 1
  set_counter_all("num_winners", "num_winners")
  if num_winners > 1 do
    set_status("win_half", as: "prev_seat")
  end
end
apply prepend, "buttons.ron.actions" do check_multiple_ron end
apply prepend, "buttons.chankan.actions" do check_multiple_ron end

def precalculate_riichi_payments do
  # winners get their own riichi stick back
  # then divide remaining pot among winners
  # (this could be from nonwinner riichi bets, or from prev rounds)
  as winners do
    if status("riichi") do
      riichi_bet = @riichi_bet
      subtract_from_pot("riichi_bet")
    end
  end
  riichi_share = round(pot / num_winners, 10)
  set_counter_all("riichi_share", "riichi_share")
  subtract_from_pot("pot") # zero out pot so `riichi_scoring` mod doesn't use it
end

on after_win, prepend: true do
  modify_winner("score", "display_total") # before honba and riichi sticks
  if pot > 0 do
    precalculate_riichi_payments
  end
  if status("riichi") do
    total = @riichi_bet :: "Reclaim riichi bet"
  end
  if riichi_share > 0 do
    total += riichi_share :: "Split remaining bets"
  end
end
