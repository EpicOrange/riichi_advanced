apply merge, "score_calculation", %{
  win_by_discard_name: "Trans Rights",
  win_by_discard_name_2: "Double Trans Rights",
  win_by_discard_name_3: "Triple Trans Rights",
  win_by_draw_name: "Trans Rights",
}

