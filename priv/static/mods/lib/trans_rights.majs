apply merge, "dora_indicators", %{
  "41m": ["42m"], "42m": ["43m"], "43m": ["44m"], "44m": ["45m"], "45m": ["46m"], "46m": ["47m"], "47m": ["48m"], "48m": ["49m"], "49m": ["41m"],
