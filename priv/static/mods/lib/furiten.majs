apply set_append, "shown_statuses", ["furiten"]

apply prepend, "buttons.ron.show_when", status_missing("furiten")
apply prepend, "buttons.chankan.show_when", status_missing("furiten")

# unset furiten if your turn passes (unless in riichi)
def unset_furiten do if status_missing("riichi") do unset_status("furiten") end end
on before_turn_change, prepend: true do unset_furiten end
on before_call, prepend: true do unset_furiten end

# (unset furiten so show_waits mod doesn't see your just-expired furiten)
on after_turn_change, prepend: true do unset_furiten end
