# this is used to determine furiten and noten payments
def check_tenpai do
  if match(["hand", "calls", "any"], ["win"]) do
    set_status("tenpai")
  else
    unset_status("tenpai")
  end
end

on after_start do check_tenpai end
on before_turn_change do check_tenpai end
on after_turn_change do check_tenpai end
