on after_initialization do
  delete_rule("Rules", "Kuikae Ari")
  add_rule("Rules", "Kuikae Nashi", "Swap-calling is disallowed. That is, if you call %{tile} with %{tiles}, you cannot discard a tile that could have made a set with %{tiles}. (e.g. calling %{aka}, then discarding %{tile}, or calling %{tile}, then discarding %{tile2})", %{tile: ~t"5p", tile2: ~t"2p", tiles: ~t"34p", aka: ~t"0p"})
end

define_play_restriction "any", just_called and last_called_tile_matches("kuikae")

apply append, "buttons.chii.call_conditions", can_discard_after_call
apply append, "buttons.pon.call_conditions", can_discard_after_call
apply append, "buttons.daiminkan.call_conditions", can_discard_after_call
