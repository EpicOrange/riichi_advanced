define_match 四歸三, ~m"四歸三:1, mentsu:2"
define_yaku yaku, "Tile Hog (3)", [5, "Faan"], match(["hand", "calls", "winning_tile"], ["四歸三"])
define_set 四歸四, ~s"0 1 2, 0 1 2, 0 1 2, 0 1 2|0 1 2, 0 1 2, 0 1 2, 1 2 3|0 1 2, 0 1 2, 0 1 2, 2 3 4|0 1 2, 0 1 2, 1 2 3, 1 2 3|0 1 2, 0 1 2, 1 2 3, 2 3 4|0 1 2, 0 1 2, 2 3 4, 2 3 4|0 1 2, 1 2 3, 1 2 3, 1 2 3|0 1 2, 1 2 3, 1 2 3, 2 3 4|0 1 2, 1 2 3, 2 3 4, 2 3 4|0 1 2, 2 3 4, 2 3 4, 2 3 4"
define_match 四歸四, ~m"四歸四:1, pair:1"
define_yaku yaku, "Tile Hog (4)", [15, "Faan"], match(["hand", "calls", "winning_tile"], ["四歸四"])
define_yaku yaku, "Double Tile Hog", [8, "Faan"], match(["hand", "winning_tile"], ~m"quad:2")
define_yaku yaku, "Double Tile Hog", [30, "Faan"], match(["hand", "winning_tile"], ~m"quad:3")
apply merge, "translations", %{
  "Tile Hog (2)": "Tile Hog",
  "Tile Hog (3)": "Tile Hog",
  "Tile Hog (4)": "Tile Hog"
}

# (4) 數字類

on after_initialization do
  add_rule("8 Faan", "All Like Numbers", "8 Faan if all of your sets and your pair contain the same number.")
  update_rule("8 Faan", "All Like Numbers", "%{example_hand}", %{example_hand: ~t"23445m44456p444s 3m"})
  add_rule("5 Faan", "All Odds", "5 Faan for a hand that contains only number tiles numbered 13579.")
  update_rule("5 Faan", "All Odds", "%{example_hand}", %{example_hand: ~t"11m333p33999s 7s7S7s 1m"})
  add_rule("5 Faan", "All Evens", "5 Faan for a hand that contains only number tiles numbered 2468.")
  update_rule("5 Faan", "All Evens", "%{example_hand}", %{example_hand: ~t"888m222p4488s 6M66m 4s"})
  add_rule("5 Faan", "One Suji Only", "5 Faan for having a hand consisting of 147 only, 258 only, or 369 only. Stacks with Three Number Hand (5 Faan).")
  update_rule("5 Faan", "One Suji Only", "%{example_hand}", %{example_hand: ~t"999m33399p33s 66s6S 9p"})
  add_rule("5 Faan", "Three Number Hand", "5 Faan for having a hand consisting of only three different numbers (of any suit).")
  update_rule("5 Faan", "Three Number Hand", "%{example_hand}", %{example_hand: ~t"22223m33444p333s 4m"})
  add_rule("10 Faan", "Two Number Hand", "10 Faan for having a hand consisting of only two different numbers (of any suit).")
  update_rule("10 Faan", "Two Number Hand", "%{example_hand}", %{example_hand: ~t"333m333p2233s 2p2P2p 2s"})
end
on before_win do
   add_attr(["hand", "calls", "winning_tile"], ["n1"], ["1"])
   add_attr(["hand", "calls", "winning_tile"], ["n2"], ["2"])
   add_attr(["hand", "calls", "winning_tile"], ["n3"], ["3"])
   add_attr(["hand", "calls", "winning_tile"], ["n4"], ["4"])
   add_attr(["hand", "calls", "winning_tile"], ["n5"], ["5"])
   add_attr(["hand", "calls", "winning_tile"], ["n6"], ["6"])
   add_attr(["hand", "calls", "winning_tile"], ["n7"], ["7"])
   add_attr(["hand", "calls", "winning_tile"], ["n8"], ["8"])
   add_attr(["hand", "calls", "winning_tile"], ["n9"], ["9"])
end
define_set 滿庭芳_1, ~s"0@n1 0 0 | 0@n1 1 2 | 0 1@n1 2 | 0 1 2@n1"
define_set 滿庭芳_2, ~s"0@n2 0 0 | 0@n2 1 2 | 0 1@n2 2 | 0 1 2@n2"
define_set 滿庭芳_3, ~s"0@n3 0 0 | 0@n3 1 2 | 0 1@n3 2 | 0 1 2@n3"
define_set 滿庭芳_4, ~s"0@n4 0 0 | 0@n4 1 2 | 0 1@n4 2 | 0 1 2@n4"
define_set 滿庭芳_5, ~s"0@n5 0 0 | 0@n5 1 2 | 0 1@n5 2 | 0 1 2@n5"
define_set 滿庭芳_6, ~s"0@n6 0 0 | 0@n6 1 2 | 0 1@n6 2 | 0 1 2@n6"
define_set 滿庭芳_7, ~s"0@n7 0 0 | 0@n7 1 2 | 0 1@n7 2 | 0 1 2@n7"
define_set 滿庭芳_8, ~s"0@n8 0 0 | 0@n8 1 2 | 0 1@n8 2 | 0 1 2@n8"
define_set 滿庭芳_9, ~s"0@n9 0 0 | 0@n9 1 2 | 0 1@n9 2 | 0 1 2@n9"
define_match 滿庭芳_1, ~m"(0@n1 0):1, 滿庭芳_1:4"
define_match 滿庭芳_2, ~m"(0@n2 0):1, 滿庭芳_2:4"
define_match 滿庭芳_3, ~m"(0@n3 0):1, 滿庭芳_3:4"
define_match 滿庭芳_4, ~m"(0@n4 0):1, 滿庭芳_4:4"
define_match 滿庭芳_5, ~m"(0@n5 0):1, 滿庭芳_5:4"
define_match 滿庭芳_6, ~m"(0@n6 0):1, 滿庭芳_6:4"
define_match 滿庭芳_7, ~m"(0@n7 0):1, 滿庭芳_7:4"
define_match 滿庭芳_8, ~m"(0@n8 0):1, 滿庭芳_8:4"
define_match 滿庭芳_9, ~m"(0@n9 0):1, 滿庭芳_9:4"
define_match 滿庭芳, "滿庭芳_1", "滿庭芳_2", "滿庭芳_3", "滿庭芳_4", "滿庭芳_5", "滿庭芳_6", "滿庭芳_7", "滿庭芳_8", "滿庭芳_9"
define_yaku yaku, "All Like Numbers", [8, "Faan"], match(["hand", "calls", "winning_tile"], ["滿庭芳"])
define_yaku yaku, "All Odds", [5, "Faan"], winning_hand_consists_of("1m","3m","5m","7m","9m","1p","3p","5p","7p","9p","1s","3s","5s","7s","9s")
define_yaku yaku, "All Evens", [5, "Faan"], winning_hand_consists_of("2m","4m","6m","8m","2p","4p","6p","8p","2s","4s","6s","8s")
define_yaku yaku, "One Suji Only", [5, "Faan"],
     winning_hand_consists_of("1m","4m","7m","1p","4p","7p","1s","4s","7s")
  or winning_hand_consists_of("2m","5m","8m","2p","5p","8p","2s","5s","8s")
  or winning_hand_consists_of("3m","6m","9m","3p","6p","9p","3s","6s","9s")
define_yaku yaku, "Three Number Hand", [5, "Faan"], at_most(3,
    match(["winning_hand"], ~m"0@n1:1"),
    match(["winning_hand"], ~m"0@n2:1"),
    match(["winning_hand"], ~m"0@n3:1"),
    match(["winning_hand"], ~m"0@n4:1"),
    match(["winning_hand"], ~m"0@n5:1"),
    match(["winning_hand"], ~m"0@n6:1"),
    match(["winning_hand"], ~m"0@n7:1"),
    match(["winning_hand"], ~m"0@n8:1"),
    match(["winning_hand"], ~m"0@n9:1")
  )
define_yaku yaku, "Two Number Hand", [10, "Faan"], at_most(2,
    match(["winning_hand"], ~m"0@n1:1"),
    match(["winning_hand"], ~m"0@n2:1"),
    match(["winning_hand"], ~m"0@n3:1"),
    match(["winning_hand"], ~m"0@n4:1"),
    match(["winning_hand"], ~m"0@n5:1"),
    match(["winning_hand"], ~m"0@n6:1"),
    match(["winning_hand"], ~m"0@n7:1"),
    match(["winning_hand"], ~m"0@n8:1"),
    match(["winning_hand"], ~m"0@n9:1")
  )

# (5) 偶然類

on after_initialization do
  add_rule("1 Faan", "After a Flower", "1 Faan if you win off the replacement tile after calling a joker as a flower.")
  add_rule("2 Faan", "Under the Sea", "2 Faan if you win off the last draw or last discard.")
  add_rule("5 Faan", "Within Ten Tiles", "5 Faan if you win before the eleventh tile is drawn.")
  add_rule("8 Faan", "Within Seven Tiles", "8 Faan if you win before the eighth tile is drawn.")
end
define_yaku yaku, "After a Flower", [1, "Faan"], status("joker")
# yaku/rinshan.majs adds After a Kong (2 Faan)
# yaku/chankan.majs adds Robbing a Kong (5 Faan)
define_yaku yaku, "Under the Sea", [2, "Faan"], no_tiles_remaining
define_yaku yaku, "Within Ten Tiles", [5, "Faan"], tiles_remaining(82)
define_yaku yaku, "Within Seven Tiles", [8, "Faan"], tiles_remaining(85)
# yaku/tenhou.majs adds Hand of Heaven (30 Faan), Hand of Earth (30 Faan), Hand of Man (15 Faan)

# (6) 狀態類

on after_initialization do
  add_rule("2 Faan", "Self Drawn Melded Hand", "2 Faan if you have four calls and won by self-draw.")
  update_rule("2 Faan", "Self Drawn Melded Hand", "%{example_hand}", %{example_hand: ~t"4z 2P34p 5M46m 2S34s 7Z77z 4z"})
  add_rule("5 Faan", "Melded Hand", "5 Faan if you have four calls and won on someone's discard (or by robbing a kong).")
  update_rule("5 Faan", "Melded Hand", "%{example_hand}", %{example_hand: ~t"4z 2P34p 5M46m 2S34s 7Z77z 4z"})
  add_rule("2 Faan", "Hell Wait", "2 Faan if you win with a hell wait. A hell wait is defined as a final wait in which all tiles except one are already visible to you, so there is only one remaining left in the wall (or in others' hands).")
  add_rule("2 Faan", "No Jokers", "2 Faan for not having jokers in hand. Jokers declared as flowers do not count as jokers.")
  update_rule("2 Faan", "No Jokers", "%{example_hand}", %{example_hand: ~t"11234m456p88899s 3j 1m"})
end
# yaku/menzenchin.majs adds Concealed Hand (1 Faan)
# yaku/menzentsumo.majs adds Fully Concealed Hand (2 Faan)
define_yaku yaku, "Self Drawn Melded Hand", [2, "Faan"], won_by_draw and match(["calls"], ~m"(chii pon daiminkan ankan kakan):4")
define_yaku yaku, "Melded Hand", [5, "Faan"], not_won_by_draw and match(["calls"], ~m"(chii pon daiminkan ankan kakan):4")
define_yaku yaku, "Hell Wait", [2, "Faan"], has_hell_wait("win")
define_yaku yaku, "No Jokers", [2, "Faan"], jokers <= 0

# (7) 對子類

on after_initialization do
  add_rule("2 Faan", "Three Consecutive Pairs", "2 Faan for having something like 11 22 33 in one suit in a seven-pair hand.")
  update_rule("2 Faan", "Three Consecutive Pairs", "%{example_hand}", %{example_hand: ~t"22778888m3p5533z 3p"})
  add_rule("10 Faan", "Five Consecutive Pairs", "10 Faan for having something like 11 22 33 44 55 in one suit in a seven-pair hand.")
  update_rule("10 Faan", "Five Consecutive Pairs", "%{example_hand}", %{example_hand: ~t"44m22334455669p 9p"})
  add_rule("30 Faan", "Seven Consecutive Pairs", "30 Faan for having something like 11 22 33 44 55 66 77 in one suit in a seven-pair hand.")
  update_rule("30 Faan", "Seven Consecutive Pairs", "%{example_hand}", %{example_hand: ~t"3344556678899s 7s"})
  add_rule("5 Faan", "Three Identical Pairs", "5 Faan for having the same number pair in three suits in a seven-pair hand.")
  update_rule("5 Faan", "Three Identical Pairs", "%{example_hand}", %{example_hand: ~t"33m33p33s11200z 2z"})
  add_rule("5 Faan", "Three Dragons Seven Pairs", "5 Faan if three of your pairs in a seven-pair hand are are dragon pairs.")
  update_rule("5 Faan", "Three Dragons Seven Pairs", "%{example_hand}", %{example_hand: ~t"22m3377p4s006677z 4s"})
  add_rule("10 Faan", "Four Winds Seven Pairs", "10 Faan if four of your pairs in a seven-pair hand are are wind pairs.")
  update_rule("10 Faan", "Four Winds Seven Pairs", "%{example_hand}", %{example_hand: ~t"22m99s112233446z 6z"})
end
