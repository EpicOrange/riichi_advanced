# (3) 四歸類

on after_initialization do
  add_rule("2 Faan", "Tile Hog", "2 Faan if two of your sets in hand (not calls) overlap and use up all four of a given tile.")
  update_rule("2 Faan", "Tile Hog", "%{example_hand}", %{example_hand: ~t"1111234s 4P56p 88m8M 4s"})
  add_rule("5 Faan", "Tile Hog", "5 Faan if two of your sets in hand (not calls) overlap your pair, using up all four of a given tile. Does not stack with Tile Hog (2 Faan).")
  update_rule("5 Faan", "Tile Hog", "%{example_hand}", %{example_hand: ~t"2344456s 4P56p 88m8M 4s"})
  add_rule("15 Faan", "Tile Hog", "15 Faan if four of your sets in hand (not calls) all overlap, using up all four of a given tile. Does not stack with Tile Hog (5 Faan) or Tile Hog (2 Faan).")
  update_rule("15 Faan", "Tile Hog", "%{example_hand}", %{example_hand: ~t"12233344455s 4P56p 88m8M 3s"})
  add_rule("8 Faan", "Double Tile Hog", "8 Faan if your hand (not calls) use up all eight of two different tiles.")
  update_rule("8 Faan", "Double Tile Hog", "%{example_hand}", %{example_hand: ~t"22224444s77z 88m8M 3s"})
  add_rule("30 Faan", "Triple Tile Hog", "30 Faan if your hand (not calls) use up all twelve of three different tiles. Without jokers, you can only get this via the shape 111 123 33 345 555.")
  update_rule("30 Faan", "Triple Tile Hog", "%{example_hand}", %{example_hand: ~t"2222444456666m 3s"})
end
define_set 四歸二, ~s"0 0 0, 0 1 2|0 1 2, 1 1 1|0 1 2, 2 2 2"
define_match 四歸二, ~m"四歸二:1, mentsu:2, pair:1"
define_yaku yaku, "Tile Hog (2)", [2, "Faan"], match(["hand", "calls", "winning_tile"], ["四歸二"])
