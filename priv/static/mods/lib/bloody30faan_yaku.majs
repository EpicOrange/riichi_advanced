# (8) 不搭類

on after_initialization do
  add_rule("5 Faan", "Thirteen Unconnected", "5 Faan if all of your tiles are not connected, i.e. they are 3 away from each other or more. You also have a pair of one of the tiles. In addition, the suited tiles among them must form a partial Knitted Triplets (147 147 147) or a partial Knitted Straight (147 258 369); and you must have at least one tile of each suit, at least one wind, and at least one dragon. Does not stack with All Types.", -50)
  update_rule("5 Faan", "Thirteen Unconnected", "%{example_hand} (partial knitted straight)", %{example_hand: ~t"147m28p36s122346z 7z"})
  update_rule("5 Faan", "Thirteen Unconnected", "%{example_hand2} (partial knitted triplets)", %{example_hand2: ~t"258m58p28s123307z 4z"})
  update_rule("5 Faan", "Thirteen Unconnected", "In addition, the following patterns add an additional 5 Faan to the hand:")
  update_rule("5 Faan", "Thirteen Unconnected", "- Knitted Short Straight: 5 Faan for having something like 14 25 36.")
  update_rule("5 Faan", "Thirteen Unconnected", "  %{example_hand3}", %{example_hand3: ~t"147m2p36s1223467z 5p"})
  update_rule("5 Faan", "Thirteen Unconnected", "- Knitted Terminal Sequences: 5 Faan for having 17 28 39.")
  update_rule("5 Faan", "Thirteen Unconnected", "  %{example_hand4}", %{example_hand4: ~t"147m28p3s1223467z 9s"})
  update_rule("5 Faan", "Thirteen Unconnected", "- Knitted Straight: 5 Faan for having 147 258 369.")
  update_rule("5 Faan", "Thirteen Unconnected", "  %{example_hand5}", %{example_hand5: ~t"147m258p36s22467z 9s"})
  update_rule("5 Faan", "Thirteen Unconnected", "- Knitted Triplets: 5 Faan for having something like 147 147 147.")
  update_rule("5 Faan", "Thirteen Unconnected", "  %{example_hand6}", %{example_hand6: ~t"369m369p36s22467z 9s"})
  update_rule("5 Faan", "Thirteen Unconnected", "- Knitted Honors: 5 Faan for having at least one of each honor tile.")
  update_rule("5 Faan", "Thirteen Unconnected", "  %{example_hand7}", %{example_hand7: ~t"147m258p1234567z 9s"})
end
define_match 十三不搭, ~m"""
    pair:1, restart, unique, knit1:13
  | pair:1, restart, unique, knit2:13
  | pair:1, restart, unique, knit3:13
  | pair:1, restart, unique, knit4:13
  | pair:1, restart, unique, knit5:13
  | pair:1, restart, unique, knit6:13
  | pair:1, restart, unique, knit7:13
  | pair:1, restart, unique, knit8:13
  | pair:1, restart, unique, knit9:13
  """
define_yaku yaku, "Thirteen Unconnected", [5, "Faan"], match(["hand", "winning_tile"], ["十三不搭"])
define_set 不搭連六, ~s"0 3, 11 14, 22 25|0 3, 21 24, 12 15"
define_match 不搭連六, ~m"不搭連六:1"
define_yaku yaku, "Knitted Short Straight", [5, "Faan"], match(["hand", "winning_tile"], ["不搭連六"])
define_set 不搭老少, ~s"0 6, 11 17, 22 28|0 6, 21 27, 12 18"
define_match 不搭老少, ~m"knit_terminal_seqs:1"
define_yaku yaku, "Knitted Terminal Sequences", [5, "Faan"], match(["hand", "winning_tile"], ["不搭老少"])
define_set 不搭雜龍, ~s"0 3 6, 11 14 17, 22 25 28|0 3 6, 21 24 27, 12 15 18"
define_match 不搭雜龍, ~m"不搭雜龍:1"
define_yaku yaku, "Knitted Straight", [5, "Faan"], match(["hand", "winning_tile"], ["不搭雜龍"])
define_set 不搭三相逢, ~s"0 3 6, 10 13 16, 20 23 26"
define_match 不搭三相逢, ~m"不搭三相逢:1"
define_yaku yaku, "Knitted Triplets", [5, "Faan"], match(["hand", "winning_tile"], ["不搭三相逢"])
define_set suji1, ~s"1m|4m|7m|1p|4p|7p|1s|4s|7s"
define_set suji2, ~s"1m|4m|7m|2p|5p|8p|3s|6s|9s"
define_set suji3, ~s"1m|4m|7m|3p|6p|9p|2s|5s|8s"
define_set suji4, ~s"2m|5m|8m|1p|4p|7p|3s|6s|9s"
define_set suji5, ~s"2m|5m|8m|2p|5p|8p|2s|5s|8s"
define_set suji6, ~s"2m|5m|8m|3p|6p|9p|1s|4s|7s"
define_set suji7, ~s"3m|6m|9m|1p|4p|7p|2s|5s|8s"
define_set suji8, ~s"3m|6m|9m|2p|5p|8p|1s|4s|7s"
define_set suji9, ~s"3m|6m|9m|3p|6p|9p|3s|6s|9s"
define_match 不搭七星, ~m"""
    unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  | unique, (1z 2z 3z 4z 0z 6z 7z):7, restart, manzu:1, souzu:1, pinzu:1, restart, suji1:6
  """
define_yaku yaku, "Knitted Honors", [5, "Faan"], match(["hand", "winning_tile"], ["不搭七星"])

# (9) 其他

on after_initialization do
  add_rule("1 Faan", "Eyes of the General", "1 Faan if your pair is 22, 55, or 88.")
  update_rule("1 Faan", "Eyes of the General", "%{example_hand}", %{example_hand: ~t"234m78889p44s444z 4s"})
  add_rule("20 Faan", "University Train", "20 Faan for having a pair of red dragons, plus a pure straight (123456789) of any suit, plus either a triplet of threes or a kong of fours.")
  update_rule("20 Faan", "University Train", "%{example_hand}", %{example_hand: ~t"23456789p77z 4s44S4s 1p"})
  update_rule("20 Faan", "University Train", "%{example_hand2}", %{example_hand2: ~t"12345m333p77z 7M89m 6m"})
  update_rule("20 Faan", "University Train", "Stacks with One Voided Suit (2 Faan).")
  update_rule("20 Faan", "Thirteen Orphans", "If you use no more than 3 jokers it becomes 25 Faan, and if you use no more than one joker it's 30 Faan.")
  update_rule("20 Faan", "Thirteen Orphans", "Stacks with All Types (5 Faan).")

  add_rule("8 Faan", "Mixed Shifted Linked Sequences", "8 Faan for having both Three Mixed Shifted Sequences and Three Mixed Linked Sequences simulaneously.")
  update_rule("8 Faan", "Mixed Shifted Linked Sequences", "%{example_hand}", %{example_hand: ~t"123p234s6z 3M45m 5S67s 6z"})
  update_rule("8 Faan", "Mixed Shifted Linked Sequences", "In the example above, %{shifted} forms Three Mixed Shifted Sequences and %{linked} forms Three Mixed Linked Sequences.", %{shifted: ~t"123p234s 3M45m", linked: ~t"123p 3M45m 5S67s"})
  update_rule("8 Faan", "Mixed Shifted Linked Sequences", "Another way to think about it is to have 234567 in one suit, 123 in a second suit, and 345 in the third suit OR 234567 in one suit, 456 in a second suit, and 678 in the third suit.")

  add_rule("20 Faan", "Pure Shifted Linked Sequences", "20 Faan for having both Three Pure Shifted Sequences and Three Pure Linked Sequences simulaneously.")
  update_rule("20 Faan", "Pure Shifted Linked Sequences", "%{example_hand}", %{example_hand: ~t"123234p6z 3P45p 5P67p 6z"})
  update_rule("20 Faan", "Pure Shifted Linked Sequences", "In the example above, %{shifted} forms Three Pure Shifted Sequences and %{linked} forms Three Pure Linked Sequences.", %{shifted: ~t"123p234p 3P45p", linked: ~t"123p 3P45p 5P67p"})
  update_rule("20 Faan", "Pure Shifted Linked Sequences", "Another way to think about it is to have either 123 234 345 567 or 123 345 456 567.")

  add_rule("15 Faan", "Chicken Hand", "15 Faan for having none of the other scoring patterns.", -50)
  update_rule("15 Faan", "Chicken Hand", "%{example_hand}", %{example_hand: ~t"123m345p34z3j 7s7S7s 3z"})
  update_rule("15 Faan", "Chicken Hand", """
    This boils down to the following:
    - Have no declared jokers (as flowers).
    - Have at least one joker used in hand.
    - You must win off a discard, and not on a hell wait.
      - (rare) It must also be a discard after the 11th tile is drawn.
    - You must have two winds or two dragons as your pair.
    - Your four sets (not pair) must all be numeric and include all three suits, one sequence, and one triplet.
    - You must have at least one but not four calls, with no kongs.
    - You must not include all four of a single tile in hand (not calls).
    - Sequences must avoid the following (be wary of jokers):
      - Same-suit 123 123, 123 789, 123 456, 456 789, or 123 456 789.
      - Mixed-suit 123/123, 123/234/345, 123/345/567, or 123/456/789.
    - Triplets must avoid the following (be wary of jokers):
      - Mixed-suit 111/111, 111/222, or 111/22/333 (that's a pair in the middle)
      - More than one concealed triplet.
      - (rare) They don't form All Evens, All Odds, One Suji Only, or Three Number Hand.
    If you are familiar with MCR, the major differences from MCR's Chicken Hand are flowers counting against Chicken Hand, and the last part about sequences and triplets, and also that short straights can only be 123456 or 456789. Also you can have a single wait, as that scores nothing, and you care about avoiding Hell Wait and not Last Tile. Also you need a triplet to not score All Sequences. Also Upper/Lower Four are not a thing, instead you worry about All Evens etc.
    """)
end
define_set 將眼, ~s"0@n2 0|0@n5 0|0@n7 0"
define_match 將眼, ~m"將眼:1, mentsu:4"
define_yaku yaku, "Eyes of the General", [1, "Faan"], match(["hand", "calls", "winning_tile"], ["將眼"])
define_set 清龍, ~s"0 1 2, 3 4 5, 6 7 8"
define_match 科大列車, ~m"((7z 7z)):1, 清龍:1, ((0@3 0 0)):1, ((0@4 0 0 0)):1"
define_yaku yaku, "University Train", [20, "Faan"], match(["hand", "calls", "winning_tile"], ["科大列車"])
# yaku/kokushi.majs adds Thirteen Orphans (20 Faan)
define_yaku meta_yaku, "Thirteen Orphans", [5, "Faan"], has_existing_yaku("Thirteen Orphans") and jokers <= 3
define_yaku meta_yaku, "Thirteen Orphans", [5, "Faan"], has_existing_yaku("Thirteen Orphans") and jokers <= 1
define_yaku meta_yaku, "Mixed Shifted Linked Sequences", [8, "Faan"], has_existing_yaku("Three Mixed Shifted Sequences", "Three Mixed Linked Sequences")
define_yaku meta_yaku, "Pure Shifted Linked Sequences", [20, "Faan"], has_existing_yaku("Three Pure Shifted Sequences", "Three Pure Linked Sequences")
define_yaku meta_yaku, "Chicken Hand", [15, "Faan"], has_no_yaku
