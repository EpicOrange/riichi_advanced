# (2) 順子類

on after_initialization do
  add_rule("1 Faan", "Double Sequences", "1 Faan for having two of the same sequence in different suits. It is possible to get this one twice by also having two of a different-numbered sequence, which gives you a total of 2 faan.")
  update_rule("1 Faan", "Double Sequences", "%{example_hand}", %{example_hand: ~t"234m23466p789s33z 3z"})
  add_rule("1 Faan", "Short Straight", "1 Faan for having 123 456 or 456 789 of one suit. It is possible to get this one twice by having two short straights, which gives you a total of 2 faan.")
  update_rule("1 Faan", "Short Straight", "%{example_hand}", %{example_hand: ~t"123m123456p3366z 3z"})
  add_rule("10 Faan", "Double Short Straight", "10 Faan for having 123 456 or 456 789 of one suit and the same 123 456 or 456 789 of another suit.")
  update_rule("10 Faan", "Double Short Straight", "%{example_hand}", %{example_hand: ~t"456789p456789s2z 2z"})
  add_rule("20 Faan", "Pure Double Short Straight", "20 Faan for having 123 123 456 456 or 456 456 789 789 of one suit.")
  update_rule("20 Faan", "Pure Double Short Straight", "%{example_hand}", %{example_hand: ~t"456789456789p2z 2z"})
  add_rule("15 Faan", "Pure Double Identical Sequences", "15 Faan for having two of the exact same sequence in one suit, and two of another exact same sequence in the same suit.")
  update_rule("15 Faan", "Pure Double Identical Sequences", "%{example_hand}", %{example_hand: ~t"445566p4455667s 7s"})
  add_rule("2 Faan", "Three Mixed Shifted Sequences", "2 Faan for having something like 123 234 345, with each sequence being in a different suit.")
  update_rule("2 Faan", "Three Mixed Shifted Sequences", "%{example_hand}", %{example_hand: ~t"234m345p456s3377z 7z"})
  add_rule("8 Faan", "Four Mixed Shifted Sequences", "8 Faan for having something like 123 234 345 456, and their suits cycle: e.g. if it starts with characters, circles, bamboo, the last sequence's suit must be characters again.")
  update_rule("8 Faan", "Four Mixed Shifted Sequences", "%{example_hand}", %{example_hand: ~t"234567m345p456s7z 7z"})
  add_rule("10 Faan", "Three Pure Shifted Sequences", "10 Faan for having something like 123 234 345 in the same suit. This forms a 'pyramid' shape, like 233444556.")
  update_rule("10 Faan", "Three Pure Shifted Sequences", "%{example_hand}", %{example_hand: ~t"233444556p2333s 1s"})
  add_rule("30 Faan", "Four Pure Shifted Sequences", "30 Faan for having something like 123 234 345 456 in the same suit.")
  update_rule("30 Faan", "Four Pure Shifted Sequences", "%{example_hand}", %{example_hand: ~t"1223344568p 3P45p 8p"})
  add_rule("2 Faan", "Three Mixed Linked Sequences", "2 Faan for having something like 123 345 567, all of different suits.")
  update_rule("2 Faan", "Three Mixed Linked Sequences", "%{example_hand}", %{example_hand: ~t"234m678p456s2227z 7z"})
  add_rule("8 Faan", "Three Pure Linked Sequences", "8 Faan for having something like 123 345 567 in the same suit.")
  update_rule("8 Faan", "Three Pure Linked Sequences", "%{example_hand}", %{example_hand: ~t"123m234456678p3s 3s"})
  add_rule("20 Faan", "Golden Gate Bridge", "20 Faan for having 123 345 567 789 in the same suit.")
  update_rule("20 Faan", "Golden Gate Bridge", "%{example_hand}", %{example_hand: ~t"1233455677m 7M89m 7m"})
  add_rule("5 Faan", "Mixed Straight", "5 Faan for having 123 456 789, all of different suits.")
  update_rule("5 Faan", "Mixed Straight", "%{example_hand}", %{example_hand: ~t"456m123p78999s11z 9s"})
end
