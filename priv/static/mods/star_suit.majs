define "star_suit"

on after_initialization do
  add_rule("Tiles", "Star Suit", "There is a fourth suit, stars: %{stars}", %{stars: ~t"123456789t"})
end

apply merge, "custom_style.tile_indices", %{
  "1t": "1",
  "2t": "2",
  "3t": "3",
  "4t": "4",
  "5t": "5",
  "6t": "6",
  "7t": "7",
  "8t": "8",
  "9t": "9",
  "10t": "10",
  "0t": "5"
}

apply set_append, "wall", [
  "1t", "1t", "1t", "1t",
  "2t", "2t", "2t", "2t",
  "3t", "3t", "3t", "3t",
  "4t", "4t", "4t", "4t",
  "5t", "5t", "5t", "5t",
  "6t", "6t", "6t", "6t",
  "7t", "7t", "7t", "7t",
  "8t", "8t", "8t", "8t",
  "9t", "9t", "9t", "9t"
]

on after_start do
  set_tile_ordering(["1t", "2t", "3t", "4t", "5t", "6t", "7t", "8t", "9t"])
end

if defined("dora") do
  apply merge, "dora_indicators", %{
    "1t": ["2t"],
    "2t": ["3t"],
    "3t": ["4t"],
    "4t": ["5t"],
    "5t": ["6t"],
    "6t": ["7t"],
    "7t": ["8t"],
    "8t": ["9t"]
  }
end

# change yaku to accommodate star suit
# - Tanyao: already covered due to being based on attributes, not tile identity
# - Chanta/Junchan: same 
# - Honroutou/Chinroutou: same
# - Honitsu/Chinitsu: star suit check already programmed in base riichi ruleset
# - Sanshoku (Doujin/Doukou): need to allow all combinations of 3 suits TODO
# - Kokushi (as yaku and as win con): need to add two more terminals to the set definitions

# kokushi
apply append, "set_definitions.orphans_all[0]", ["1t", "9t"]
apply append, "set_definitions.orphans_any", ~s"1t|9t"

