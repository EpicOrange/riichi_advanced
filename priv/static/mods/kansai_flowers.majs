
apply append, "wall", ~t"1234f"

define extra_yaku, "Flower", ["flowers", "Han"], flowers >= 1

# replace pei call
apply delete_key, "buttons", "flower"
define_button flower,
  display_name: "Flower",
  msg_name: "flower",
  show_when: our_turn
    and has_draw
    and not_just_discarded
    and status_missing("just_called")
    and match(["hand", "draw"], ~m"(1f 2f 3f 4f):1"),
  unskippable: true
  do
    big_text("Flower")
    unset_status("kan", "double_kan")
    flower("1f", "2f", "3f", "4f")
    if no_tiles_remaining do
      advance_turn
    else
      draw(1, "opposite_end")
    end
  end

# replace auto flower button
apply delete_key, "auto_buttons", "_5_auto_pei"

define_auto_button _5_auto_flower,
  display_name: "F",
  desc: "Automatically declare all flowers.",
  enabled_at_start: true
  do
    if buttons_include("flower") do
      press_button("flower")
      press_first_call_button("flower")
    end
  end

if defined("dora") do
  apply set_merge, "dora_indicators", %{
    "1f": ["1f","2f","3f","4f"],
    "2f": ["1f","2f","3f","4f"],
    "3f": ["1f","2f","3f","4f"],
    "4f": ["1f","2f","3f","4f"],
  }
end

# count flowers, zero out pei
on before_win do
  nukidora = 0
  add_counter("flowers", "count_matches", ["flowers"], ~m"nojoker, (1f 2f 3f 4f):1")
end
