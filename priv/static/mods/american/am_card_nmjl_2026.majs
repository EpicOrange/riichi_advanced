define_button "4_am_sextet",
  display_name: "Sextet",
  show_when: status_missing("match_start", "dead_hand") and not_our_turn and not_no_tiles_remaining and someone_else_just_discarded and call_available,
  precedence_over: ["am_pung", "am_kong", "am_quint", "am_sextet"],
  call: [[0, 0, 0, 0, 0], ["1f", "1f", "1f", "1f", "1f"]],
  call_name: "am_sextet",
  call_conditions: hand_length_at_least(6)
    and not_called_tile_contains(["1j"], 1)
    and (call_contains([+@flowers, "1j"], 3) or not_call_contains([+@flowers], 1))
  do
    big_text("Sextet")
    call
    change_turn("self")
  end

