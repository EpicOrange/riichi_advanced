default year, 2026

cond do
  !year == 2026 -> require_after "american/am_card_nmjl_2026"
  !year == 2025 -> require_after "american/am_card_nmjl_2025"
  !year == 2024 -> require_after "american/am_card_nmjl_2024"
  !year == 2023 -> require_after "american/am_card_nmjl_2023"
  !year == 2022 -> require_after "american/am_card_nmjl_2022"
  !year == 2021 -> require_after "american/am_card_nmjl_2021"
  !year == 2020 -> require_after "american/am_card_nmjl_2020"
  !year == 2019 -> require_after "american/am_card_nmjl_2019"
  !year == 2018 -> require_after "american/am_card_nmjl_2018"
  !year == 2017 -> require_after "american/am_card_nmjl_2017"
  !year == 2016 -> require_after "american/am_card_nmjl_2016"
  !year == 2015 -> require_after "american/am_card_nmjl_2015"
  !year == 2014 -> require_after "american/am_card_nmjl_2014"
  !year == 2013 -> require_after "american/am_card_nmjl_2013"
  true          -> require_after "american/am_card_nmjl_2026"
end
