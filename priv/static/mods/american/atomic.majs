default points, 50

on after_initialization do
  add_rule("Rules", "Atomic", "After the Charleston, you may declare Atomic to enable winning with 7 pairs for %{points} points. This is necessarily a concealed hand, and you cannot use flowers or jokers for it. If at any point you discard a flower or joker, you are no longer eligible for this hand.", %{points: !points})
end

define_match "atomic_win", ~m"nojoker, 4x:1, (1j 1f 2f 3f 4f 1g 2g 3g 4g):-1, pair:7"
define_yaku yaku, "Atomic", [!points, "Pts"], match(["hand", "winning_tile"], ["atomic_win"]), ["Jokerless"]
apply set_append, "win_definition", ["atomic_win"]

def set_atomic do
  if not_anyone_status("match_start") do
    as everyone do
      if match(["hand", "draw"], ~m"nojoker, (1j 1f 2f 3f 4f 1g 2g 3g 4g):-1") do
        set_status("can_declare_atomic")
      end
    end
    recalculate_buttons
  end
end

apply append, "buttons.charleston_across_0.actions" do set_atomic end
apply append, "buttons.charleston_across_1.actions" do set_atomic end
apply append, "buttons.charleston_across_2.actions" do set_atomic end
apply append, "buttons.charleston_across_3.actions" do set_atomic end

on after_start do set_atomic end # if no charleston is on

on before_turn_change do
  if just_discarded do
    unset_status("can_declare_atomic")
  end
end

define_play_restriction "4x", true

define_play_effect flower_or_joker do
  unset_status("atomic")
  delete_tiles("4x")
end

define_button atomic,
  display_name: "Atomic",
  show_when: status("can_declare_atomic") and status_missing("atomic") and our_turn and not_just_discarded
  do
    big_text("Atomic")
    unset_status("can_declare_atomic")
    set_status("atomic")
    draw(1, "4x")
    recalculate_buttons
  end
