require "renchan"

on after_initialization do
  add_rule("Rules", "Agarirenchan", "If the dealer (East wind) wins, the round repeats.")
end

if defined("honba") do
  on after_initialization do
    update_rule("Rules", "Honba", "(Agarirenchan) One honba stick is also added if the dealer (East wind) wins.")
  end
end

on before_win do
  as east do
    if is_winner("self") do
      set_status("renchan")
    end
  end
end
