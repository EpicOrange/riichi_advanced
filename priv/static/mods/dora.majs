define "dora"

on after_initialization do
  if !start_indicators == 1 do
    add_rule("Rules", "Dora", "At the beginning of the game, 1 dora indicator is revealed in the dead wall.")
  else
    add_rule("Rules", "Dora", "At the beginning of the game, %{start_indicators} dora indicators are revealed in the dead wall.", %{start_indicators: !start_indicators})
  end
  add_rule("Rules", "Dora", "The tile next in sequence to a dora indicator is considered dora, and each copy of dora in hand is worth 1 extra han. A nine indicator %{nine} indicates the one %{one} as dora. For winds, the sequence is %{east} > %{south} > %{west} > %{north} > %{east}. For dragons, the sequence is %{white}, %{green}, %{red} > %{white}.", %{one: ~t"1p", nine: ~t"9p", east: ~t"1z", south: ~t"2z", west: ~t"3z", north: ~t"4z", white: ~t"5z", green: ~t"6z", red: ~t"7z"})
end

set max_revealed_tiles, 5

if defined("sanma") do
  if !start_indicators > 0 do apply set_append, "revealed_tiles", -10 end
  if !start_indicators > 1 do apply set_append, "revealed_tiles", -12 end
  if !start_indicators > 2 do apply set_append, "revealed_tiles", -14 end
  if !start_indicators > 3 do apply set_append, "revealed_tiles", -16 end
  if !start_indicators > 4 do apply set_append, "revealed_tiles", -18 end
else
  if !start_indicators > 0 do apply set_append, "revealed_tiles", -6 end
  if !start_indicators > 1 do apply set_append, "revealed_tiles", -8 end
  if !start_indicators > 2 do apply set_append, "revealed_tiles", -10 end
  if !start_indicators > 3 do apply set_append, "revealed_tiles", -12 end
  if !start_indicators > 4 do apply set_append, "revealed_tiles", -14 end
end

apply merge, "dora_indicators", %{
  "1m": ["2m"], "2m": ["3m"], "3m": ["4m"], "4m": ["5m"], "5m": ["6m"], "6m": ["7m"], "7m": ["8m"], "8m": ["9m"], "9m": ["1m"],
  "1p": ["2p"], "2p": ["3p"], "3p": ["4p"], "4p": ["5p"], "5p": ["6p"], "6p": ["7p"], "7p": ["8p"], "8p": ["9p"], "9p": ["1p"],
  "1s": ["2s"], "2s": ["3s"], "3s": ["4s"], "4s": ["5s"], "5s": ["6s"], "6s": ["7s"], "7s": ["8s"], "8s": ["9s"], "9s": ["1s"],
  "1z": ["2z"], "2z": ["3z"], "3z": ["4z"], "4z": ["1z"], "5z": ["6z"], "6z": ["7z"], "7z": ["5z"],
}

if defined("sanma") do
  apply merge, "dora_indicators", %{"1m": ["9m"]}
end

def calculate_dora do
  dora = 0
  if tile_revealed(-6) do add_counter("dora", "count_dora", -6, ["hand", "calls", "flowers", "winning_tile"]) end
  if tile_revealed(-8) do add_counter("dora", "count_dora", -8, ["hand", "calls", "flowers", "winning_tile"]) end
  if tile_revealed(-10) do add_counter("dora", "count_dora", -10, ["hand", "calls", "flowers", "winning_tile"]) end
  if tile_revealed(-12) do add_counter("dora", "count_dora", -12, ["hand", "calls", "flowers", "winning_tile"]) end
  if tile_revealed(-14) do add_counter("dora", "count_dora", -14, ["hand", "calls", "flowers", "winning_tile"]) end
  if tile_revealed(-16) do add_counter("dora", "count_dora", -16, ["hand", "calls", "flowers", "winning_tile"]) end
  if tile_revealed(-18) do add_counter("dora", "count_dora", -18, ["hand", "calls", "flowers", "winning_tile"]) end
end

on before_win do calculate_dora end
on before_scoring do calculate_dora end

define_yaku extra_yaku, "Dora", ["dora", "Han"], dora >= 1

# tag dora with dora tag
on after_start do
  if tile_revealed(-6) do tag_dora("dora", -6) end
  if tile_revealed(-8) do tag_dora("dora", -8) end
  if tile_revealed(-10) do tag_dora("dora", -10) end
  if tile_revealed(-12) do tag_dora("dora", -12) end
  if tile_revealed(-14) do tag_dora("dora", -14) end
  if tile_revealed(-16) do tag_dora("dora", -16) end
  if tile_revealed(-18) do tag_dora("dora", -18) end
end
