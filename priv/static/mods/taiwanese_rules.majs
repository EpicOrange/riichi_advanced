on after_initialization do
  add_rule("Tiles", "Base Tiles", "By default, Taiwanese mahjong uses the following 136 tiles:", -100)
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of circles %{pinzu}", %{pinzu: ~t"123456789p"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of bamboo %{souzu}", %{souzu: ~t"123456789s"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of characters %{manzu}", %{manzu: ~t"123456789m"})
  add_rule("Tiles", "Base Tiles", "- Four each of the four winds (East, South, West, North) %{winds}", %{winds: ~t"1234z"})
  add_rule("Tiles", "Base Tiles", "- Four each of the three dragons (White, Green, Red) %{dragons}", %{dragons: ~t"067z"})
  add_rule("Tiles", "Base Tiles", "- Four flowers %{flowers}", %{flowers: ~t"1234f"})
  add_rule("Tiles", "Base Tiles", "- Four seasons %{seasons}", %{seasons: ~t"1234g"})
  add_rule("Rules", "Win Condition", "You may win with one of the following:", -100)
  add_rule("Rules", "Win Condition", "- Five sets (sequences or triplets) and a pair.", -100)
  add_rule("Rules", "Win Condition", "- Seven pairs (repeats OK) plus one triplet.", -100)
  add_rule("Rules", "Win Condition", "- Having all eight flowers. (You have 7 flowers and win from calling the eighth someone declares, or by drawing it yourself.)", -100)
  add_rule("Rules", "Ting", "If you can, you may discard into a ready hand by announcing Ting to lock your hand. If you win, you are awarded 1 Tai.")
  add_rule("Rules", "Dealer Continuation", "If the dealer wins, or the round ends in a draw, the dealer remains dealer.")
  add_rule("Rules", "Dealer Penalty", "If the dealer loses (by discarding the winning tile, or by someone else self-drawing their winning tile) then the dealer pays an extra 1 Tai plus 2 Tai for each dealer continuation. The only way to avoid the dealer penalty while passing on the dealership is if someone else discards into another player's winning hand.")
  add_rule("1 Tai", "Ting", "1 Tai for winning after announcing Ting.")
  add_rule("1 Tai", "Dealer", "1 Tai if you are the dealer. As the dealer you pay an additional 1 Tai if you lose (by discarding someone's winning tile or if someone else self-draws their tile). This bonus/penalty increases by 2 Tai for every consecutive dealer continuation.")
  add_rule("1 Tai", "Concealed Hand", "1 Tai for having no calls (except concealed kongs). This combines with Self-Draw (1 Tai) to get Fully Concealed Hand (3 Tai).")
  add_rule("1 Tai", "No Flowers", "1 Tai for having no flowers. This combines with No Honors (1 Tai) to get No Honors or Flowers (3 Tai).")
  add_rule("1 Tai", "Flowers", "1 Tai for each flower tile, regardless of the number printed on it.")
  add_rule("1 Tai", "Pung of Winds", "1 Tai for a wind triplet, regardless of seat.")
  add_rule("1 Tai", "Pung of Dragons", "1 Tai for a dragon triplet.")
  add_rule("1 Tai", "No Honors", "1 Tai for no honor tiles. This combines with No Flowers (1 Tai) to get No Honors or Flowers (3 Tai).")
  add_rule("1 Tai", "Self-Draw", "1 Tai for drawing the winning tile yourself. This combines with Concealed Hand (1 Tai) to get Fully Concealed Hand (3 Tai).")
  add_rule("1 Tai", "Robbing the Kong", "1 Tai for winning on the tile someone wanted to add to a pung.")
  add_rule("1 Tai", "Last Tile Win", "1 Tai for winning on the last tile drawn from the wall.")
  add_rule("1 Tai", "Melded Kong", "1 Tai for having a non-concealed kong.")
  add_rule("2 Tai", "Concealed Kong", "2 Tai for having a concealed kong.")
  add_rule("2 Tai", "Single Wait", "2 Tai for having your final wait be on only one tile, forming a pair.")
  add_rule("2 Tai", "Closed Wait", "2 Tai for having your final wait be on a closed wait, like 35 waiting on 4.")
  add_rule("1 Tai", "Two Concealed Triplets", "1 Tai for having two triplets (including concealed kongs) hidden in your winning hand.")
  add_rule("3 Tai", "No Honors or Flowers", "3 Tai for having no honor tiles or flower tiles.")
  add_rule("3 Tai", "All Sequences (Mixed)", "3 Tai for having 5 sequences and a pair. If the hand also has No Honors or Flowers, this becomes All Sequences (Full) (10 Tai).")
  add_rule("3 Tai", "Fully Concealed Hand", "3 Tai for winning by self-draw without calling any tiles besides concealed kong.")
  add_rule("5 Tai", "Three Concealed Triplets", "5 Tai for having three triplets (including concealed kongs) hidden in your winning hand.")
  add_rule("5 Tai", "Within Ten Discards", "5 Tai for winning when there are at most 10 discards on the table. Tiles claimed by calls do not count towards this total.")
  add_rule("5 Tai", "Open Straight", "5 Tai for having the sequences 123 456 789 in one suit. If the hand is concealed, this becomes Closed Straight (10 Tai).")
  add_rule("5 Tai", "Three Little Winds", "5 Tai for having two triplets of wind tiles plus a pair of wind tiles.")
  add_rule("10 Tai", "Half Flush", "10 Tai for having only one suit in hand, plus honor tiles.")
  add_rule("10 Tai", "All Triplets", "10 Tai for having 5 triplets and a pair.")
  add_rule("10 Tai", "Closed Straight", "10 Tai for having the sequences 123 456 789 in one suit in a concealed hand.")
  add_rule("10 Tai", "All Sequences (Full)", "10 Tai for having 5 sequences and a pair. In addition, it must have No Honors or Flowers.")
  add_rule("10 Tai", "All Revealed", "10 Tai for having 5 open calls, so you have one tile in hand waiting for a pair. It doesn't matter if it wins off a discard or self-draw.")
  add_rule("10 Tai", "Within Five Discards", "10 Tai for winning when there are at most 5 discards on the table. Tiles claimed by calls do not count towards this total.")
  add_rule("10 Tai", "Little Three Dragons", "10 Tai for having two dragon triplets and a pair of the third.")
  add_rule("10 Tai", "Ready Hand", "10 Tai for announcing Ting on the initial draw.")
  add_rule("10 Tai", "Big Three Winds", "10 Tai for having three wind triplets.")
  add_rule("10 Tai", "Four Concealed Triplets", "10 Tai for having four triplets (including concealed kongs) hidden in your winning hand.")
  add_rule("20 Tai", "Seven Flowers Robbing Eighth", "20 Tai for having seven flowers and winning off of someone declaring an eighth.")
  add_rule("30 Tai", "Eight Flowers", "30 Tai for having seven flowers and drawing the eighth yourself.")
  add_rule("30 Tai", "Little Four Winds", "30 Tai for having three wind triplets and a pair of the fourth.")
  add_rule("30 Tai", "Big Three Dragons", "30 Tai for having triplets of all three dragons.")
  add_rule("30 Tai", "Seven Pairs", "30 Tai for having seven pairs plus one triplet.")
  add_rule("40 Tai", "Big Four Winds", "40 Tai for having triplets of all four winds.")
  add_rule("40 Tai", "Full Flush", "40 Tai for having only one suit in hand, with no honor tiles.")
  add_rule("40 Tai", "Blessing of Heaven", "40 Tai for winning immediately with your initial hand and drawn tile.")
  add_rule("40 Tai", "Blessing of Earth", "40 Tai for winning immediately with your initial hand and the dealer's first discard.")
  add_rule("40 Tai", "Five Concealed Triplets", "40 Tai for having five triplets (hidden including concealed kongs) hidden in your winning hand.")
end
