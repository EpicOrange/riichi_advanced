on after_initialization do
  add_rule("Rules", "Suukaikan", "If fourth kans have been declared (not all by the same player), the game ends in an abortive draw.")
end

replace_yaku yakuman, "Suukantsu", [2, "★"], match(["calls"], ~m"(daiminkan ankan kakan):4")

# if the rinshan after 4th kan fails to win, then it's an immediate win with double yakuman
# this special win does not get additional chip yaku and cannot stack other yaku/yakuman
# added a space in the name so it doesn't override itself
apply append, "score_calculation.yaku_lists", "suukantsu"
define_yaku suukantsu, "Suukantsu ", [2, "★"], status("suukantsu_rinshan"), ["yaku", "meta_yaku", "extra_yaku", "yakuman", "meta_yakuman", "shuugi"]
# trigger special win
define_button suukantsu,
  display_name: "Suukantsu",
  show_when: our_turn and has_draw and status("kan") and match(["calls"], ~m"(daiminkan ankan kakan):4, pair:-1")
  do
    big_text("Tsumo")
    set_status("suukantsu_rinshan")
    pause(1000)
    reveal_hand
    win_by_draw
  end

if defined("shuugi") do
  def calculate_shuugi_payment, append: true do
    if status("suukantsu_rinshan") do
      shuugi_payment = 20
    end
  end
end
