default seven_list, "yaku"
default seven_name, "Seven Flowers"
default seven_value, 0
default seven_han, !han
default eight_list, "yaku"
default eight_name, "Eight Flowers"
default eight_value, 0
default eight_han, !han

if !seven_value > 0 do
  on after_initialization do
    add_rule("$value $han", !seven_name, "You won with seven flowers.", %{value: !seven_value, han: !seven_han})
    update_rule("$value $han", !seven_name, "%{example_hand}", %{value: !seven_value, han: !seven_han, example_hand: ~t"1234f123g"})
  end
  # seven flowers simply won't be scored if win_on is 8, because the button won't appear
  define_yaku !seven_list, !seven_name, [!seven_value, !seven_han], match(["draw", "flowers"], ~m"unique, (1f 2f 3f 4f 1g 2g 3g 4g):7")
  define_yaku_precedence !seven_name, ["Seat Flower", "Seat Season", "All Flowers", "All Seasons"]
end

if !eight_value > 0 do
  on after_initialization do
    add_rule("$value $han", !eight_name, "You won with eight flowers.", %{value: !eight_value, han: !eight_han})
    update_rule("$value $han", !eight_name, "%{example_hand}", %{value: !eight_value, han: !eight_han, example_hand: ~t"1234f1234g"})
  end
  define_yaku !eight_list, !eight_name, [!eight_value, !eight_han], match(["draw", "flowers"], ~m"unique, (1f 2f 3f 4f 1g 2g 3g 4g):8")
  if !seven_value > 0 do define_yaku_precedence !eight_name, [!seven_name] end
end

cond do
  equals(!win_on, "7 flowers") ->
    on after_initialization do
      add_rule("Rules", "Flowers", "- As soon as you draw a seventh flower, you may declare a win for an additional 3 Fan, or 8 Fan if you have eight flowers.")
    end
  equals(!win_on, "8 flowers") ->
    on after_initialization do
      add_rule("Rules", "Flowers", "- As soon as you draw an eighth flower, you may declare a win for an additional 8 Fan.")
    end
end

define_button flower_win,
  display_name: "Zimo",
  show_when: our_turn
    and has_draw
    and match(["draw"], ~m"unique, (1f 2f 3f 4f 1g 2g 3g 4g):1")
    and (
        (equals(!win_on, "7 flowers") and match(["flowers"], ~m"unique, (1f 2f 3f 4f 1g 2g 3g 4g):6"))
     or (equals(!win_on, "8 flowers") and match(["flowers"], ~m"unique, (1f 2f 3f 4f 1g 2g 3g 4g):7"))
    )
  do
    big_text("Zimo")
    pause(1000)
    reveal_hand
    win_by_draw
  end
