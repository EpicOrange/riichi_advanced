on after_initialization do
  add_rule("Rules", "Zan Scoring", """
    (Zan Scoring) Fu is not calculated (though pinfu still exists with the same condition). There is no tsumo loss. Instead, hands score based on the following table:
    Ron:
    - 1 han: dealer 2000, nondealer 1000
    - 2 han: dealer 3000, nondealer 2000
    - 3 han: dealer 6000, nondealer 4000
    - Mangan (4-5 han): dealer 12000, nondealer 8000
    - Haneman (6-7 han): dealer 18000, nondealer 12000
    - Baiman (8-10 han): dealer 24000, nondealer 16000
    - Sanbaiman (11-12 han): dealer 36000, nondealer 24000
    - Yakuman (13+ han): dealer 48000, nondealer 32000
    Tsumo:
    - 1 han: dealer 1000 all, nondealer 1000/1000
    - 2 han: dealer 2000 all, nondealer 1000/1000
    - 3 han: dealer 3000 all, nondealer 1000/3000
    - Mangan (4-5 han): dealer 6000 all, nondealer 3000/5000
    - Haneman (6-7 han): dealer 9000 all, nondealer 4000/8000
    - Baiman (8-10 han): dealer 12000 all, nondealer 6000/10000
    - Sanbaiman (11-12 han): dealer 18000 all, nondealer 8000/16000
    - Yakuman (13+ han): dealer 24000 all, nondealer 12000/20000
    """, -90)
end

# don't display fu
# (still need to calculate it for pinfu though)
apply merge, "score_calculation", %{right_display: ""}

# tsumo pinfu is ok
apply delete, "yaku_precedence.Tsumo", "Pinfu"

# use a different scoring logic
replace all, "buttons", "ron", "zan_ron"
replace all, "buttons", "tsumo", "zan_tsumo"

define_scoring zan_ron do
  total = 0
  if points2 > 0 do
    total = points2 * 32000 :: "Yakuman ron"
    modify_winner("score_name", "Yakuman", as: "winner")
  else
    han = points :: "Han"
    cond do
      points >= 13 ->
        total = 32000 :: "Yakuman ron"
        modify_winner("score_name", "Kazoe Yakuman", as: "winner")
      points >= 11 ->
        total = 24000 :: "Sanbaiman ron"
        modify_winner("score_name", "Sanbaiman", as: "winner")
      points >= 8 ->
        total = 16000 :: "Baiman ron"
        modify_winner("score_name", "Baiman", as: "winner")
      points >= 6 ->
        total = 12000 :: "Haneman ron"
        modify_winner("score_name", "Haneman", as: "winner")
      points >= 4 ->
        total = 8000 :: "Mangan ron"
        modify_winner("score_name", "Mangan", as: "winner")
      points >= 3 -> total = 4000 :: "3 han ron"
      points >= 2 -> total = 2000 :: "2 han ron"
      points >= 1 -> total = 1000 :: "1 han ron"
      true        -> total = 0 :: "0 han ron" # not a thing
    end
  end
  if seat_is("east", as: "winner") do
    if points == 1 do
      total *= 2 :: "Dealer"
    else
      total *= 1.5 :: "Dealer"
    end
  end
  if honba > 0 do
    total += honba * 1000 :: "Honba"
  end
end

define_scoring zan_tsumo do
  total = 0
  if seat_is("east", as: "winner") do
    winner_dealer = 1
    dealer = 1
  end
  if seat_is("east") do
    dealer = 1
  end
  if points2 > 0 do
    if dealer == 1 do
      if winner_dealer == 1 do
        total = points2 * 24000 :: "Yakuman dealer tsumo"
      else
        total = points2 * 20000 :: "Yakuman tsumo"
      end
    else
      total = points2 * 12000 :: "Yakuman tsumo"
    end
    modify_winner("score_name", "Yakuman", as: "winner")
  else
    han = points :: "Han"
    cond do
      points >= 13 ->
        if dealer == 1 do
          if winner_dealer == 1 do
            total = 24000 :: "Yakuman dealer tsumo"
          else
            total = 20000 :: "Yakuman tsumo"
          end
        else
          total = 12000 :: "Yakuman tsumo"
        end
        modify_winner("score_name", "Kazoe Yakuman", as: "winner")
      points >= 11 ->
        if dealer == 1 do
          if winner_dealer == 1 do
            total = 18000 :: "Sanbaiman dealer tsumo"
          else
            total = 16000 :: "Sanbaiman tsumo"
          end
        else
          total = 8000 :: "Sanbaiman tsumo"
        end
        modify_winner("score_name", "Sanbaiman", as: "winner")
      points >= 8 ->
        if dealer == 1 do
          if winner_dealer == 1 do
            total = 12000 :: "Baiman dealer tsumo"
          else
            total = 10000 :: "Baiman tsumo"
          end
        else
          total = 6000 :: "Baiman tsumo"
        end
        modify_winner("score_name", "Baiman", as: "winner")
      points >= 6 ->
        if dealer == 1 do
          if winner_dealer == 1 do
            total = 9000 :: "Haneman dealer tsumo"
          else
            total = 8000 :: "Haneman tsumo"
          end
        else
          total = 4000 :: "Haneman tsumo"
        end
        modify_winner("score_name", "Haneman", as: "winner")
      points >= 4 ->
        if dealer == 1 do
          if winner_dealer == 1 do
            total = 6000 :: "Mangan dealer tsumo"
          else
            total = 5000 :: "Mangan tsumo"
          end
        else
          total = 3000 :: "Mangan tsumo"
        end
        modify_winner("score_name", "Mangan", as: "winner")
      points >= 3 ->
        if dealer == 1 do
          total = 3000 :: "3 han dealer tsumo"
        else
          total = 1000 :: "3 han tsumo"
        end
      points >= 2 ->
        if winner_dealer == 1 do
          total = 2000 :: "2 han dealer tsumo"
        else
          total = 1000 :: "2 han tsumo"
        end
      true -> total = 1000 :: "1 han tsumo"
    end
  end
  if honba > 0 do
    total += honba * 1000 :: "Honba"
  end
end
