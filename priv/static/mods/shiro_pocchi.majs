on after_initialization do
  add_rule("Tiles", "Shiro Pocchi", "One of the white dragons %{5z} is replaced with a shiro pocchi %{shiro_pocchi}. Shiro pocchi acts a joker tile when drawn while in riichi.", %{"5z": ~t"5z", shiro_pocchi: ~t"9z"}, -99)
  update_rule("Rules", "Shuugi", "(Shiro Pocchi) Winning in riichi via shiro pocchi is worth 1 shuugi.")
end

replace 1, "wall", "5z", "9z"
on after_start do
  set_tile_alias_all(["9z"], ["5z"])
end

# when drawing shiro pocchi in riichi, it becomes a wildcard
on after_turn_change do
  if !ippatsu_only do
    if status("riichi", "ippatsu") and match(["draw"], ~m"nojoker, 9z:1") do
      set_status("shiro_pocchi")
      save_tile_behavior("before_shiro_pocchi")
      set_tile_alias(["9z"], ["any"])
    end
  else
    if status("riichi") and match(["draw"], ~m"nojoker, 9z:1") do
      set_status("shiro_pocchi")
      save_tile_behavior("before_shiro_pocchi")
      set_tile_alias(["9z"], ["any"])
    end
  end
end

# remove shiro pocchi wildcard status on turn change (to avoid furiten)
on before_turn_change do
  if status("shiro_pocchi") do
    unset_status("shiro_pocchi")
    load_tile_behavior("before_shiro_pocchi")
  end
end

apply set_merge, "dora_indicators", %{
  "9z": ["6z"],
}

if defined("shuugi") do
  define_yaku shuugi, "Shiro Pocchi", [1, "⛀"], status("riichi", "shiro_pocchi")

  apply append, "functions.announce_shuugi_payment" do
    if status("riichi", "shiro_pocchi") do
      if won_by_draw do
        push_system_message("Everyone pays 1 chip for shiro pocchi")
      else
        push_system_message("Discarder pays 1 chip for shiro pocchi")
      end
    end
  end
end
