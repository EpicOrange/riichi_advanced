on after_initialization do
  add_rule("$value $han", "$name", "%{value} %{han} if you have three of the exact same sequence in one suit, like 123 123 123.", %{value: !san_value, han: !san_han, name: !san_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{example_hand: ~t"345345m789p6s 34m5M 6s", value: !san_value, han: !san_han, name: !san_name})
  add_rule("$value $han", "$name", "%{value} %{han} if you have three of the exact same sequence in one suit, like 123 123 123.", %{value: !yon_value, han: !yon_han, name: !yon_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{example_hand: ~t"345345m789p6s 34m5M 6s", value: !yon_value, han: !yon_han, name: !yon_name})
end

define_set iishoku_sanjun, ~s"0 1 2, 0 1 2, 0 1 2"
define_set iishoku_yonjun, ~s"0 1 2, 0 1 2, 0 1 2, 0 1 2"

define_yaku !san_list, !san_name, [!san_value, !san_han], match(["hand", "calls", "winning_tile"], ~m"exhaustive, iishoku_sanjun:1, mentsu:1, pair:1")
define_yaku !yon_list, !yon_name, [!yon_value, !yon_han], match(["hand", "calls", "winning_tile"], ~m"exhaustive, iishoku_yonjun:1, pair:1"), [!san_name]
