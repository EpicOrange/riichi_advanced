on after_initialization do
  add_rule("$value $han", "$name", "%{value} %{han} if you called %{kan} twice.", %{value: !value, han: !han, name: !name, kan: !kan_name})
  update_rule("$value $han", "$name", "%{example_hand}", %{value: !value, han: !han, name: !name, example_hand: ~t"345m222s3z 2222z 9999m 3z"})
end

define_yaku !list, !name, [!value, !han], match(["calls"], ~m"(daiminkan ankan kakan):2")
