default list, "yaku"
default flower_name, ""
default double_list, "yaku"
default double_name, ""
default double_value, 0
default double_han, !han

on after_initialization do
  if equals(!rinshan_name, !flower_name) do
    add_rule("$value $han", "$name", "%{value} %{han} if you win off a %{kan} or flower replacement tile.", %{value: !value, han: !han, name: !rinshan_name, kan: !kan_name})
  else
    add_rule("$value $han", "$name", "%{value} %{han} if you win off a %{kan} replacement tile.", %{value: !value, han: !han, name: !rinshan_name, kan: !kan_name})
  end
  unless equals(!flower_name, "") do
    add_rule("$value $han", "$name", "%{value} %{han} if you win off a flower replacement tile.", %{value: !value, han: !han, name: !flower_name})
  end
  if !double_value > 0 do
    add_rule("$value $han", "$name", "%{value} %{han} if you win off a %{kan} replacement tile drawn after another %{kan}.", %{value: !double_value, han: !han, name: !double_name, kan: !kan_name})
  end
end

define_yaku !list, !rinshan_name, [!value, !han], status("kan")
unless equals(!flower_name, "") do
  define_yaku !list, !flower_name, [!value, !han], status("flower")
end
if !double_value > 0 do
  define_yaku !double_list, !double_name, [!double_value, !double_han], status("double_kan"), [!rinshan_name]
end

unless equals(!flower_name, "") do
  define_yaku_precedence !double_name, [!flower_name]
end
