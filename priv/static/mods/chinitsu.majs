on after_initialization do
  add_rule("Tiles", "Chinitsu", "The wall is composed of 16 copies of each bamboo tile.", -99)
end

set wall, [
  "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s", "1s",
  "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s", "2s",
  "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s", "3s",
  "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s", "4s",
  "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s", "5s",
  "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s", "6s",
  "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s", "7s",
  "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s", "8s",
  "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s", "9s"
]

if defined("ten") do
  apply append, "wall", ["10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s", "10s"]
end

if defined("sichuan") do
# skip sichuan voided suit prompt, we're voiding manzu always
  on after_charleston do
    as everyone do
      unset_status("round_start")
      set_status("void_manzu")
    end
  end
  apply delete_key, "buttons", "void_manzu"
  apply delete_key, "buttons", "void_pinzu"
  apply delete_key, "buttons", "void_souzu"
  if defined("star_suit")
    apply delete_key, "buttons", "void_stars"
  end
end
