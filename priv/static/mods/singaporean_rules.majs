on after_initialization do
  add_rule("Tiles", "Base Tiles", "By default, Singaporean mahjong uses the following 148 tiles:", -100)
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of circles %{pinzu}", %{pinzu: ~t"123456789p"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of bamboo %{souzu}", %{souzu: ~t"123456789s"})
  add_rule("Tiles", "Base Tiles", "- Four each of the 1 to 9 of characters %{manzu}", %{manzu: ~t"123456789m"})
  add_rule("Tiles", "Base Tiles", "- Four each of the four winds (East, South, West, North) %{winds}", %{winds: ~t"1234z"})
  add_rule("Tiles", "Base Tiles", "- Four each of the three dragons (White, Green, Red) %{dragons}", %{dragons: ~t"067z"})
  add_rule("Tiles", "Base Tiles", "- Four flowers %{flowers}", %{flowers: ~t"1234f"})
  add_rule("Tiles", "Base Tiles", "- Four seasons %{seasons}", %{seasons: ~t"1234g"})
  add_rule("Tiles", "Base Tiles", "- Four animals %{animals}", %{animals: ~t"1234a"})
  add_rule("Rules", "Win Condition", "You may win with one of the following:", -100)
  add_rule("Rules", "Win Condition", "- Four sets (sequences or triplets) and a pair.", -100)
  add_rule("Rules", "Win Condition", "- Have all thirteen terminal/honor tiles plus one forming a pair.", -100)
  add_rule("Rules", "Win Condition", "- Have 7 flowers and rob the eighth someone declares, or draw it yourself.", -100)
  add_rule("Rules", "Minimum Tai", "A winning hand must be worth at least 2 Tai, not counting flowers/seasons/animals.")
  add_rule("Rules", "Maximum Tai", "A winning hand maxes out at 5 Tai, with the exception of the two 10 Tai hands. Riichi Advanced will still calculate all Tai patterns, but score is capped at 5.")
  add_rule("Rules", "Locked Discards", "If you are waiting for a tile to win, but one of your winning tiles is among your discards (including tiles called by other players), then you cannot win if someone discards the same tile (but you can still win by self-draw). The difference from Riichi's furiten rule is that you can still win with non-discarded tiles that you are waiting for.")
  add_rule("Rules", "Instant Payouts", "Declaring kongs and declaring certain flower combinations award instant payouts.", -50)
  add_rule("Rules", "Instant Payouts", "- Calling a kong on a discard immediately awards 1 point from the discarder. %{daiminkan}", %{daiminkan: ~t"2P222p"})
  add_rule("Rules", "Instant Payouts", "- Calling a kong to upgrade a triplet immediately awards 1 point from every player. %{kakan}", %{kakan: ~t"2p22P2p"})
  add_rule("Rules", "Instant Payouts", "- Calling a concealed kong immediately awards 2 points from every player. %{ankan}", %{ankan: ~t"1x22p1x"})
  add_rule("Rules", "Instant Payouts", "- Declaring both a cat %{cat} and a mouse tile %{mouse} immediately awards 2 points from every player, or 4 points if done at the start of the game.", %{cat: ~t"1a", mouse: ~t"2a"})
  add_rule("Rules", "Instant Payouts", "- Declaring both a chicken %{chicken} and a centipede tile %{centipede} immediately awards 2 points from every player, or 4 points if done at the start of the game.", %{chicken: ~t"3a", centipede: ~t"4a"})
  cond do
    seat_is("east") -> add_rule("Rules", "Instant Payouts", "- Declaring both your seat flower %{flower} and your seat season %{season} immediately awards 2 points from every player, or 4 points if done at the start of the game.", %{flower: ~t"1f", season: ~t"1g"})
    seat_is("east") -> add_rule("Rules", "Instant Payouts", "- Declaring both your seat flower %{flower} and your seat season %{season} immediately awards 2 points from every player, or 4 points if done at the start of the game.", %{flower: ~t"2f", season: ~t"2g"})
    seat_is("east") -> add_rule("Rules", "Instant Payouts", "- Declaring both your seat flower %{flower} and your seat season %{season} immediately awards 2 points from every player, or 4 points if done at the start of the game.", %{flower: ~t"3f", season: ~t"3g"})
    seat_is("east") -> add_rule("Rules", "Instant Payouts", "- Declaring both your seat flower %{flower} and your seat season %{season} immediately awards 2 points from every player, or 4 points if done at the start of the game.", %{flower: ~t"4f", season: ~t"4g"})
  end
  add_rule("Rules", "Instant Payouts", "- Declaring all four flowers %{flowers} or all four seasons %{seasons} immediately awards 4 points.", %{flowers: ~t"1234f", seasons: ~t"1234g"})
  add_rule("Rules", "Bao Penalty", "In certain dangerous situations, unwisely discarding a certain tile leaves you liable for the full amount.")
  add_rule("Rules", "Bao Penalty", "- If the wall (not dead wall) has 5 or less tiles remaining and you discard a live (unseen by every player) tile that is then claimed to make a kong by another player, who subsequently wins on the kong replacement tile, then you pay the full amount. (It is scored as a self-draw, but the discarder pays for everyone.")
  add_rule("Rules", "Bao Penalty", "- If a potential winner has 4+ visible Tai (from flowers/seasons/animals/honor triplets), and you discard a tile that helps the potential winner form an additional 1 Tai honor triplet, then you pay in full if the potential winner actually wins, even if by self-draw.")
  add_rule("Rules", "Bao Penalty", "- If a potential winner has 3+ calls in the same suit, and you discard a tile of that suit that is called by that same player, then you pay in full if the potential winner actually wins with Full Flush.")
  add_rule("Rules", "Bao Penalty", "- If a potential winner has called two dragon triplets, and you discard a tile of the third dragon which is then called, then you pay in full if the potential winner wins (as you have confirmed their Big Three Scholars).")
  add_rule("Rules", "Bao Penalty", "- If a potential winner has called three wind triplets, and you discard a tile of the fourth wind which is then called, then you pay in full if the potential winner wins (as you have confirmed their Four Great Blessings).")
  add_rule("Rules", "Bao Penalty", "- If a potential winner has called 3+ honor triplets, and someone discards any of the non-called honor tiles which is then called, then you pay in full if the potential winner wins with All Honours.")
  add_rule("1 Tai", "Animal Tile", "1 Tai for each individual animal tile, regardless of seat.")
  add_rule("1 Tai", "Seat Flower/Season", "1 Tai for a flower or season tile that matches the player's own seat.")
  add_rule("1 Tai", "Dragon Pung", "1 Tai for any dragon triplet or kong.")
  add_rule("1 Tai", "Valued Wind Pung", "1 Tai for any wind triplet or kong that matches either the round wind or your seat wind.")
  add_rule("1 Tai", "Little Ping Hu", "1 Tai for 4 sequences and a pair, where the pair is not a dragon or valued wind, and either the winning tile was self-drawn or the final wait was not a single wait. Not awarded if you have 4 open sequences. If you have no flowers/seasons/animals, instead score Big Ping Hu (4 Tai).")
  add_rule("1 Tai", "Fully Concealed Hand", "1 Tai for having no calls (even concealed kong) and winning by self-draw. Flower/season/animal tile do not count as calls.")
  add_rule("1 Tai", "Winning on Replacement Tile", "1 Tai for winning on the replacement tile after declaring a flower or kong.")
  add_rule("1 Tai", "Robbing the Kong", "1 Tai for claiming the tile another player tried to add onto an existing called triplet to turn into a kong.")
  add_rule("1 Tai", "Last Tile Win", "1 Tai for winning on the last tile drawn from the live wall (so replacement tiles do not count).")
  add_rule("2 Tai", "Flower/Season Set", "2 Tai for having all 4 flowers, or all 4 seasons. Stacks with the 1 Tai bonus for having a matching seat. Animal tiles don't award this.")
  add_rule("2 Tai", "Half Flush", "2 Tai for having only one suit in hand, plus honor tiles.")
  add_rule("2 Tai", "All Pungs", "2 Tai for having 4 triplets and a pair.")
  add_rule("3 Tai", "Three Lesser Scholars", "3 Tai for having two dragon triplets and a pair of the third. Does not stack with the 1 Tai from individual dragon triplets.")
  add_rule("4 Tai", "Full Flush", "4 Tai for having only one suit in hand, with no honor tiles.")
  add_rule("4 Tai", "Big Ping Hu", "4 Tai for 4 sequences and a pair, where the pair is not a dragon or valued wind, and either the winning tile was self-drawn or the final wait was not a single wait. Also, you have no flowers/seasons/animals. Not awarded if you have 4 open sequences.")
  add_rule("4 Tai", "All Terminals or Honors", "4 Tai for having only terminal tiles (1s and 9s) and honor tiles. Does not stack with the 1 Tai from individual dragon triplets or valued wind triplets.")
  add_rule("4 Tai", "Four Lesser Blessings", "4 Tai for three wind triplets plus a pair of the fourth wind. Does not stack with the 1 Tai from valued wind pungs, Half Flush, or Full Flush.")
  add_rule("5 Tai", "Seven Flowers/Seasons", "5 Tai for having seven flowers and winning off of someone declaring an eighth.")
  add_rule("5 Tai", "All Eight Flowers/Seasons", "5 Tai for having seven flowers and drawing the eighth yourself.")
  add_rule("5 Tai", "Animal Set", "5 Tai for declaring all 4 animal tiles (cat, mouse, chicken, centipede).")
  add_rule("5 Tai", "All Honours", "5 Tai for having only honor tiles.")
  add_rule("5 Tai", "All Terminals", "5 Tai for having only terminal tiles (1s and 9s).")
  add_rule("5 Tai", "Hidden Treasure", "5 Tai for having four triplets (including concealed kongs) hidden in your winning hand. Must be won by self-draw, even if you're waiting on the pair.")
  add_rule("5 Tai", "Thirteen Wonders", "5 Tai for having all thirteen terminal/honor tiles plus one forming a pair. Always scored as self-drawn (so everyone pays), even when winning off a discard.")
  add_rule("5 Tai", "All Green", "5 Tai for having only 23468 of bamboo + green dragon.")
  add_rule("5 Tai", "Nine Gates", "5 Tai if your hand is concealed and contains 1112345678999 in one suit plus one extra tile in that suit.")
  add_rule("5 Tai", "Eighteen Arhats", "5 Tai if you have four kongs.")
  add_rule("5 Tai", "Heavenly Hand", "5 Tai for winning immediately with your initial hand as dealer.")
  add_rule("5 Tai", "Earthly Hand", "5 Tai for winning immediately with your initial hand + initial draw (as a non-dealer), or if you win off the dealer's first discard.")
  add_rule("5 Tai", "Kong on Kong", "5 Tai if you call a kong, then call kong on the replacement tile, then win on that second replacement tile.")
  add_rule("10 Tai", "Three Great Scholars", "10 Tai for having all three dragon triplets.")
  add_rule("10 Tai", "Three Great Scholars", "10 Tai for having all four wind triplets.")
end
