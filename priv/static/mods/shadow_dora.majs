define "shadow_dora"

on after_initialization do
  update_rule("Rules", "Dora", "(Shadow Dora) All dora/ura is worth 2 Han, but the dora indicators become shadow dora/ura, worth -1 Han. This will not put your score below 1 Han.")
end

def calculate_shadow_dora do
  if tile_revealed("$indicator") do
    subtract_counter("shadow_dora", "count_matching_ways", ["hand_any", "$indicator"], ~m"pair:1")
    subtract_counter("shadow_dora", "count_matching_ways", ["call_tiles_any", "$indicator"], ~m"pair:1")
    subtract_counter("shadow_dora", "count_matching_ways", ["winning_tile", "$indicator"], ~m"pair:1")
  end
end
def calculate_shadow_ura do
  if tile_revealed("$indicator") do
    subtract_counter("shadow_ura", "count_matching_ways", ["hand_any", "$indicator"], ~m"pair:1")
    subtract_counter("shadow_ura", "count_matching_ways", ["call_tiles_any", "$indicator"], ~m"pair:1")
    subtract_counter("shadow_ura", "count_matching_ways", ["winning_tile", "$indicator"], ~m"pair:1")
  end
end

def calculate_dora, append: true do
  dora *= 2
  ura *= 2
  shadow_dora = 0
  shadow_ura = 0
  calculate_shadow_dora(%{indicator: -6})
  calculate_shadow_dora(%{indicator: -8})
  calculate_shadow_dora(%{indicator: -10})
  calculate_shadow_dora(%{indicator: -12})
  calculate_shadow_dora(%{indicator: -14})
  calculate_shadow_dora(%{indicator: -16})
  calculate_shadow_dora(%{indicator: -18})
  calculate_shadow_ura(%{indicator: -5})
  calculate_shadow_ura(%{indicator: -7})
  calculate_shadow_ura(%{indicator: -9})
  calculate_shadow_ura(%{indicator: -11})
  calculate_shadow_ura(%{indicator: -13})
  calculate_shadow_ura(%{indicator: -15})
  calculate_shadow_ura(%{indicator: -17})
end

define_yaku extra_yaku, "Shadow Dora", ["shadow_dora", "Han"], shadow_dora <= -1
define_yaku extra_yaku, "Shadow Ura", ["shadow_ura", "Han"], shadow_ura <= -1

# don't allow going below 1 han
def cap_negative_points do if points < 1 do points = 1; modify_winner("points", 1) end end
define_scoring ron, prepend: true do cap_negative_points end
define_scoring tsumo, prepend: true do cap_negative_points end

# make shadow dora/ura shine black
on before_scoring do
  if tile_revealed(-5) do tag_dora("ura", -5) end
  if tile_revealed(-7) do tag_dora("ura", -7) end
  if tile_revealed(-9) do tag_dora("ura", -9) end
  if tile_revealed(-11) do tag_dora("ura", -11) end
  if tile_revealed(-13) do tag_dora("ura", -13) end
  if tile_revealed(-15) do tag_dora("ura", -15) end
  if tile_revealed(-17) do tag_dora("ura", -17) end
  add_attr_tagged("ura", "_dora")
end

