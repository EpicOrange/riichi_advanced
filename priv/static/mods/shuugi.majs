# enables other mods to add shuugi-related scoring
define "shuugi"

on after_initialization do
  add_rule("Rules", "Shuugi", "Part of the player's starting score is composed of shuugi chips worth %{worth} each, which are gained and lost separately from points.", %{worth: !worth})
  if !starting_shuugi > 0 do
    add_rule("Rules", "Shuugi", "Each player starts with %{starting_shuugi} chips.", %{starting_shuugi: !starting_shuugi})
  end
  as everyone do
    shuugi = !starting_shuugi
  end
end

apply append, "score_calculation.yaku_lists", "shuugi"

# shuugi mods should extend this empty function
def announce_shuugi_payment do end

def execute_shuugi_payment do
  set_counter_all("shuugi_payment", "shuugi_payment")
  if !pao_pays_all and anyone_status("pao") do
    as everyone do
      if status("pao") do
        shuugi -= shuugi_payment * 3
        as prev_seat do shuugi += shuugi_payment * 3 end
      end
    end
  else
    cond do
      won_by_draw ->
        as others do
          shuugi -= shuugi_payment
          as prev_seat do shuugi += shuugi_payment end
        end
      won_by_call ->
        as last_caller do
          shuugi -= shuugi_payment
        end
        shuugi += shuugi_payment
      true ->
        as last_discarder do
          shuugi -= shuugi_payment
        end
        shuugi += shuugi_payment
    end
  end
end

on after_win do
  shuugi_payment += shuugi_gain # gained from yaku that score ⛀
  announce_shuugi_payment
  execute_shuugi_payment
end

def convert_shuugi do
  push_system_message("Converted each shuugi to %{worth} points.", %{worth: !worth})
  # convert to points
  as everyone do
    shuugi_payout = shuugi
    shuugi_payout = shuugi_payout * !worth
    add_score("shuugi_payout")
  end
end

on before_conclusion do
  convert_shuugi
end

apply append, "persistent_counters", "shuugi"

# no longer needed since we have a shuugi graphic now
