on after_initialization do
  add_rule("Rules", "Shuugi", "Part of the player's starting score is composed of shuugi chips worth %{worth} each, which are gained and lost separately from points.", %{worth: !worth})
  if !starting_shuugi > 0 do
    add_rule("Rules", "Shuugi", "Each player starts with %{starting_shuugi} chips.", %{starting_shuugi: !starting_shuugi})
  end
  # set shuugi so that everyone sees the counter
  as everyone do
    shuugi = !starting_shuugi
  end
end

apply append, "score_calculation.yaku_lists", "shuugi"

def calculate_shuugi_payment do
  shuugi_payment += shuugi_gain

  # TODO factor the below as mods
  
  # if status("kindora") do shuugi_payment += 2 end
  # shuugi_payment += toriuchi
  # shuugi_payment += galaxy_shuugi
  # if status("riichi", "shiro_pocchi") do shuugi_payment += 1 end
end

