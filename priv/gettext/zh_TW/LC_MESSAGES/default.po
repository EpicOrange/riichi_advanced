msgid "Everyone pays %{tsumo_chips} chips for a yakuman win (shuugi)"
msgstr "所有人為役滿和牌支付 %{tsumo_chips} 個籌碼（籌碼）"

msgid "Everyone pays %{tsumo_chips} chips for each yakuman count (shuugi)"
msgstr "所有人每計一次役滿支付 %{tsumo_chips} 個籌碼（籌碼）"

msgid "Everyone pays 1 chip for a yakuman win (shuugi)"
msgstr "所有人為役滿和牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip for each yakuman count (shuugi)"
msgstr "所有人每計一次役滿支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip for ippatsu"
msgstr "所有人為一發支付 1 個籌碼"

msgid "Everyone pays 1 chip for shiro pocchi"
msgstr "所有人為白發財支付 1 個籌碼"

msgid "Everyone pays 1 chip per aka dora (shuugi)"
msgstr "所有人每張赤寶牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip per aka dora in a closed hand (shuugi)"
msgstr "所有人於門前手牌中每張赤寶牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip per ao dora (shuugi)"
msgstr "所有人每張青寶牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip per ao dora in a closed hand (shuugi)"
msgstr "所有人於門前手牌中每張青寶牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip per kin dora (shuugi)"
msgstr "所有人每張金寶牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip per kin dora in a closed hand (shuugi)"
msgstr "所有人於門前手牌中每張金寶牌支付 1 個籌碼（籌碼）"

msgid "Everyone pays 1 chip per ura dora"
msgstr "所有人每張裏寶牌支付 1 個籌碼"

msgid "Everyone pays 10 chips per rainbow seven"
msgstr "所有人每張彩虹七支付 10 個籌碼"

