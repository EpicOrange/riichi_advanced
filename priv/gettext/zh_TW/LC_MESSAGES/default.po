msgstr "Matsumi Yuu"

msgid "Maximum Tai"
msgstr "最高台數"

msgid "Maya Yukiko"
msgstr "Maya Yukiko"

msgid "Megan Davin"
msgstr "Megan Davin"

msgid "Melded Hand"
msgstr "鳴牌手"

msgid "Melded Kong"
msgstr "明槓"

msgid "Melded and Concealed Kongs"
