msgstr "2026"

msgid "2026 #1 (25 pts)"
msgstr "2026 #1（25 點）"

msgid "2026 #2 (25 pts)"
msgstr "2026 #2（25 點）"

msgid "2026 #3 (25 pts)"
msgstr "2026 #3（25 點）"

msgid "2026 #4 (30 pts)"
msgstr "2026 #4（30 點）"

