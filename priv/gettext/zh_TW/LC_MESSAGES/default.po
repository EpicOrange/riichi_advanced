msgstr "所有人每張青寶牌支付 %{chips} 個籌碼（籌碼）"

msgid "Everyone pays %{chips} chips per ao dora in a closed hand (shuugi)"
msgstr "所有人於門前手牌中每張青寶牌支付 %{chips} 個籌碼（籌碼）"

msgid "Everyone pays %{chips} chips per kin dora (shuugi)"
msgstr "所有人每張金寶牌支付 %{chips} 個籌碼（籌碼）"

msgid "Everyone pays %{chips} chips per kin dora in a closed hand (shuugi)"
msgstr "所有人於門前手牌中每張金寶牌支付 %{chips} 個籌碼（籌碼）"

