msgid "%{is} if you win off the first tile someone dropped before your first draw. Calls invalidate."
msgstr "最初のツモ前に他者の捨て牌で和了した場合に成立。副露は無効。"

msgid "%{man}x %{1m}, %{pin}x %{1p}, and %{sou}x %{1s} are replaced with red \\\"aka dora\\\" ones %{akadora_ones} that are worth one extra han each."
msgstr "%{man}x %{1m}、%{pin}x %{1p}、%{sou}x %{1s}を赤ドラ1 %{akadora_ones}に置き換え。それぞれ1翻追加。"

msgid "%{man}x %{3m}, %{pin}x %{3p}, and %{sou}x %{3s} are replaced with red \\\"aka dora\\\" threes %{akadora_threes} that are worth one extra han each."
msgstr "%{man}x %{3m}、%{pin}x %{3p}、%{sou}x %{3s}を赤ドラ3 %{akadora_threes}に置き換え。それぞれ1翻追加。"

msgid "%{man}x %{5m}, %{pin}x %{5p}, and %{sou}x %{5s} are replaced with blue \\\"ao dora\\\" fives %{aodora_fives} that are worth one extra han each."
msgstr "%{man}x %{5m}、%{pin}x %{5p}、%{sou}x %{5s}を青ドラ5 %{aodora_fives}に置き換え。それぞれ1翻追加。"

msgid "%{man}x %{5m}, %{pin}x %{5p}, and %{sou}x %{5s} are replaced with gold \\\"kin dora\\\" fives %{kindora_fives} that are worth one extra han each."
msgstr "%{man}x %{5m}、%{pin}x %{5p}、%{sou}x %{5s}を金ドラ5 %{kindora_fives}に置き換え。それぞれ1翻追加。"

msgid "%{man}x %{5m}, %{pin}x %{5p}, and %{sou}x %{5s} are replaced with red \\\"aka dora\\\" fives %{akadora_fives} that are worth one extra han each."
msgstr "%{man}x %{5m}、%{pin}x %{5p}、%{sou}x %{5s}を赤ドラ5 %{akadora_fives}に置き換え。それぞれ1翻追加。"

msgid "%{man}x %{7m}, %{pin}x %{7p}, and %{sou}x %{7s} are replaced with red \\\"aka dora\\\" sevens %{akadora_sevens} that are worth one extra han each."
msgstr "%{man}x %{7m}、%{pin}x %{7p}、%{sou}x %{7s}を赤ドラ7 %{akadora_sevens}に置き換え。それぞれ1翻追加。"

msgid "%{man}x %{9m}, %{pin}x %{9p}, and %{sou}x %{9s} are replaced with red \\\"aka dora\\\" nines %{akadora_nines} that are worth one extra han each."
msgstr "%{man}x %{9m}、%{pin}x %{9p}、%{sou}x %{9s}を赤ドラ9 %{akadora_nines}に置き換え。それぞれ1翻追加。"

