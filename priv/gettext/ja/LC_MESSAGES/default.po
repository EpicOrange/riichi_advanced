msgstr "模倣満貫"

msgid "Mangan"
msgstr "満貫"

msgid "Mangan base"
msgstr "満貫ベース"

msgid "Mangan dealer tsumo"
msgstr "満貫親ツモ"

msgid "Mangan if your hand was 1112345678999 in one suit, and you won via its nine-sided wait."
msgstr "手牌が同じスートの1112345678999で、その九面待ちで和了すると満貫。"

msgid "Mangan is achieved at 4.5 han 30 fu, 3.5 han 50 fu, or 2.5 han 90 fu. Haneman is still 6+ han."
msgstr "満貫は4.5翻30符、3.5翻50符、または2.5翻90符で達成されます。跳満は依然として6翻以上です。"

msgid "Mangan ron"
msgstr "満貫ロン"

msgid "Mangan tsumo"
msgstr "満貫ツモ"

msgid "Manzu"
msgstr "萬子"

msgid "Manzu Honitsu"
msgstr "萬子混一色"

msgid "Mase Yuuko"
msgstr "Mase Yuuko"

msgid "Matano Seiko"
msgstr "Matano Seiko"

msgid "Matsumi Kuro"
msgstr "Matsumi Kuro"

msgid "Matsumi Yuu"
msgstr "Matsumi Yuu"

msgid "Maximum Tai"
msgstr "最大台数"

msgid "Maya Yukiko"
msgstr "Maya Yukiko"

msgid "Megan Davin"
msgstr "Megan Davin"

