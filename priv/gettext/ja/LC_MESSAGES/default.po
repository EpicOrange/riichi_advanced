msgstr "%{tiles}"

msgid "%{value} %{han} for each flower tile whose number matches your seat. Since your current seat is East, that would be the following flowers: %{flowers}"
msgstr "あなたの席風に対応する花牌ごとに%{value} %{han}。現在東家なので、対象の花牌は: %{flowers}"

msgid "%{value} %{han} for each flower tile whose number matches your seat. Since your current seat is North, that would be the following flowers: %{flowers}"
msgstr ""
"あなたの席風に対応する花牌ごとに%{value} %{han}。現在北家なので、対象の花牌は: %{flowers}"

msgid "%{value} %{han} for each flower tile whose number matches your seat. Since your current seat is South, that would be the following flowers: %{flowers}"
msgstr "あなたの席風に対応する花牌ごとに%{value} %{han}。現在南家なので、対象の花牌は: %{flowers}"

msgid "%{value} %{han} for each flower tile whose number matches your seat. Since your current seat is West, that would be the following flowers: %{flowers}"
msgstr "あなたの席風に対応する花牌ごとに%{value} %{han}。現在西家なので、対象の花牌は: %{flowers}"

msgid "%{value} %{han} for each of the following triplets in your hand:"
msgstr "以下の刻子それぞれについて%{value} %{han}:"

msgid "%{value} %{han} if all four of your sets are sequences."
msgstr "4つの面子すべてが順子なら%{value} %{han}。"

msgid "%{value} %{han} if all four of your sets are triplets."
msgstr "4つの面子すべてが刻子なら%{value} %{han}。"

msgid "%{value} %{han} if as a non-dealer, you win with your initial draw. Calls do not invalidate this."
msgstr "子として初自摸で和了した場合%{value} %{han}。副露があっても有効。"

msgid "%{value} %{han} if as a non-dealer, you win with your initial draw. Calls invalidate."
msgstr "子として初自摸で和了した場合%{value} %{han}。副露は無効。"

msgid "%{value} %{han} if as dealer, you win with your initial draw. Calls do not invalidate this."
msgstr "親として初自摸で和了した場合%{value} %{han}。副露があっても有効。"

msgid "%{value} %{han} if as dealer, you win with your initial draw. Calls invalidate."
msgstr "親として初自摸で和了した場合%{value} %{han}。副露は無効。"

msgid "%{value} %{han} if every set/pair in your hand contains a terminal or honor tile."
msgstr "全ての面子・対子に么九牌または字牌が含まれる場合%{value} %{han}。"

msgid "%{value} %{han} if every set/pair in your hand contains a terminal tile."
msgstr "全ての面子・対子に么九牌が含まれる場合%{value} %{han}。"

msgid "%{value} %{han} if you called %{kan} four times."
msgstr "%{kan}を4回宣言した場合%{value} %{han}。"

msgid "%{value} %{han} if you called %{kan} once."
msgstr "%{kan}を1回宣言した場合%{value} %{han}。"

msgid "%{value} %{han} if you called %{kan} three times."
msgstr "%{kan}を3回宣言した場合%{value} %{han}。"

msgid "%{value} %{han} if you called %{kan} twice."
msgstr "%{kan}を2回宣言した場合%{value} %{han}。"

msgid "%{value} %{han} if you have a double sequence: two copies of the exact same sequence in one suit, like 123 123."
msgstr "同一の順子を同種で2組持つ場合%{value} %{han}（例: 123 123）。"

msgid "%{value} %{han} if you have four concealed triplets. A triplet completed by a self-draw win counts as concealed."
msgstr "暗刻を4組持つ場合%{value} %{han}。自摸和了で完成した刻子は暗刻として扱う。"

msgid "%{value} %{han} if you have no calls (except %{ankan})."
msgstr "%{ankan}以外の副露がない場合%{value} %{han}。"

msgid "%{value} %{han} if you have one concealed triplet. A triplet completed by a self-draw win counts as concealed."
msgstr "暗刻を1組持つ場合%{value} %{han}。自摸和了で完成した刻子は暗刻として扱う。"

msgid "%{value} %{han} if you have three concealed triplets. A triplet completed by a self-draw win counts as concealed."
msgstr "暗刻を3組持つ場合%{value} %{han}。自摸和了で完成した刻子は暗刻として扱う。"

msgid "%{value} %{han} if you have three of the exact same sequence in one suit, like 123 123 123."
msgstr "同一の順子を同種で3組持つ場合%{value} %{han}（例: 123 123 123）。"

msgid "%{value} %{han} if you have triplets of all four winds."
msgstr "4種類の風牌全ての刻子を持つ場合%{value} %{han}。"

msgid "%{value} %{han} if you have triplets of all three dragons."
msgstr "3種類の三元牌全ての刻子を持つ場合%{value} %{han}。"

msgid "%{value} %{han} if you have triplets of three different winds, and a pair of the fourth."
msgstr "3種類の風牌の刻子と、4つ目の風牌の対子を持つ場合%{value} %{han}。"

msgid "%{value} %{han} if you have triplets of three different winds."
msgstr "3種類の風牌の刻子を持つ場合%{value} %{han}。"

msgid "%{value} %{han} if you have triplets of two different dragons, and a pair of the third."
msgstr "2種類の三元牌の刻子と、残りの三元牌の対子を持つ場合%{value} %{han}。"

msgid "%{value} %{han} if you have triplets of two different winds, and a pair of a third."
msgstr "2種類の風牌の刻子と、別の風牌の対子を持つ場合%{value} %{han}。"

msgid "%{value} %{han} if you have two concealed triplets. A triplet completed by a self-draw win counts as concealed."
msgstr "暗刻を2組持つ場合%{value} %{han}。自摸和了で完成した刻子は暗刻として扱う。"

msgid "%{value} %{han} if you have two double sequences, each being two copies of the exact same sequence in one suit, like 123 123. Cannot be scored together with seven pairs."
msgstr "同一の順子を2組ずつ、合計4組持つ場合%{value} %{han}（例: 123 123）。七対子とは複合しない。"

msgid "%{value} %{han} if you win by drawing the last tile in the wall."
msgstr "壁の最後の牌を自摸で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win by having one of each terminal and honor tile, with one of them forming a pair."
msgstr "么九牌と字牌をすべて1枚ずつ持ち、そのうち1枚が対子となる形で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off a %{kan} or flower replacement tile."
msgstr "%{kan}または花牌の補充牌で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off a %{kan} replacement tile drawn after another %{kan}."
msgstr "%{kan}の補充牌の後に、さらに%{kan}の補充牌で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off a %{kan} replacement tile."
msgstr "%{kan}の補充牌で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off a discard after the last tile in the wall is drawn."
msgstr "壁の最後の牌が引かれた後の捨て牌で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off a flower replacement tile."
msgstr "花牌の補充牌で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off someone else adding a drawn tile to an existing %{pung} to form a %{kong}."
msgstr "他家が引いた牌を%{pung}に加えて%{kong}にするのを狙って和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win off the last draw or discard."
msgstr "最後のツモまたは捨て牌で和了した場合%{value} %{han}。"

msgid "%{value} %{han} if you win on someone's discard, before your first draw. Calls do not invalidate this."
msgstr "最初のツモ前に他家の捨て牌で和了した場合%{value} %{han}。副露があっても有効。"

msgid "%{value} %{han} if you win on someone's discard, before your first draw. Calls invalidate."
msgstr "最初のツモ前に他家の捨て牌で和了した場合%{value} %{han}。副露は無効。"

msgid "%{value} %{han} if you win on the dealer's first discard. Calls do not invalidate this."
msgstr "親の最初の捨て牌で和了した場合%{value} %{han}。副露があっても有効。"

msgid "%{value} %{han} if you win on the dealer's first discard. Calls invalidate."
msgstr "親の最初の捨て牌で和了した場合%{value} %{han}。副露は無効。"

msgid "%{value} %{han} if your final hand (including winning tile) looks like 1112345678999 of any suit, plus one additional tile of that suit."
msgstr "最終的な手牌（和了牌を含む）が任意の一種類で1112345678999プラス同種の牌1枚の形になる場合%{value} %{han}。"

msgid "%{value} %{han} if your final wait contains at least two pairs waiting for either one to become a triplet."
msgstr "最終的な待ちが、どちらかが刻子になるのを待つ対子を2組以上含む場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists of only one suit plus honor tiles."
msgstr "手牌が一色と字牌のみで構成される場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists of only one suit, no honor tiles."
msgstr "手牌が一色のみで構成される場合（字牌なし）%{value} %{han}。"

msgid "%{value} %{han} if your hand consists of seven pairs (no repeated pairs)."
msgstr "手牌が七対子（重複なし）の場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists of seven pairs (repeated pairs OK)."
msgstr "手牌が七対子（重複ありでも可）の場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists only of 1 and 9 tiles."
msgstr "手牌が1と9の牌のみの場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists only of 1, 9, and honor tiles."
msgstr "手牌が1、9、字牌のみの場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists only of 2-8 number tiles."
msgstr "手牌が2から8の数牌のみの場合%{value} %{han}。"

msgid "%{value} %{han} if your hand consists only of honor tiles."
msgstr "手牌が字牌のみの場合%{value} %{han}。"

msgid "%{value} %{han} if your hand contains the same number sequence in all three suits."
msgstr "手牌に同じ数字の順子が3種類全てに含まれる場合%{value} %{han}。"

msgid "%{value} %{han} if your hand contains the same number triplet in all three suits."
msgstr "手牌に同じ数字の刻子が3種類全てに含まれる場合%{value} %{han}。"

msgid "%{value} %{han} if your hand contains the same number triplet in two different suits, plus a pair in the third suit."
msgstr "手牌に同じ数字の刻子が2種類に含まれ、残りの種類に対子がある場合%{value} %{han}。"

msgid "%{value} %{han} if your hand contains the sequences 123 456 879 in one suit."
msgstr "手牌に同種で123 456 789の順子が含まれる場合%{value} %{han}。"

msgid "%{value} %{han} if your hand didn't earn any points."
msgstr "手牌が得点を獲得できなかった場合%{value} %{han}。"

msgid "%{value} %{han} if your hand has four triplets of the same suit in sequence, like 222 333 444 555."
msgstr "手牌に同種の連続する刻子が4組ある場合%{value} %{han}（例: 222 333 444 555）。"

msgid "%{value} %{han} if your hand has three triplets of the same suit in sequence, like 222 333 444."
msgstr "手牌に同種の連続する刻子が3組ある場合%{value} %{han}（例: 222 333 444）。"

msgid "%{value} %{han} if your hand includes all 5 suits (character, circle, bamboo, wind, dragon)."
msgstr "手牌に5種類すべて（萬子、筒子、索子、風牌、三元牌）が含まれる場合%{value} %{han}。"

msgid "&lt;disconnected&gt;"
msgstr "＜切断＞"

msgid "(#{print_yaku_value(value)})"
msgstr "(#{print_yaku_value(value)})"

msgid "(Add Blank Flowers) Blank tiles %{tile} also count as flowers, worth 1 Fan each, plus 1 bonus Fan (5 total) if you have all four. %{tiles}"
msgstr "（ブランク花牌追加）ブランク牌%{tile}も花牌として扱われ、各1ファン。4枚すべて揃えるとボーナス1ファン（合計5ファン）。%{tiles}"

msgid "(Agarirenchan) One honba stick is also added if the dealer (East wind) wins."
msgstr "（連荘）親（東家）が和了した場合、本場棒が1本追加される。"

msgid "(Agariyame) After every round, the dealer may choose whether to pass the dealership."
msgstr "（和了やめ）各局終了後、親は連荘するか席を譲るかを選択できる。"

msgid "(Agariyame) An exception is if it's the last round -- then the dealer may choose whether to end the game."
msgstr "（和了やめ）例外として最終局の場合、親はゲームを終了するかを選択できる。"

msgid "(Agariyame) An exception is if it's the last round -- then the game just ends."
msgstr "（和了やめ）例外として最終局の場合、ゲームはそのまま終了する。"

msgid "(Agariyame) An exception is if it's the last round with the dealer ending in first place -- then the dealer may choose whether to end the game."
msgstr "（和了やめ）例外として最終局で親が1位の場合、親はゲームを終了するかを選択できる。"

msgid "(Agariyame) An exception is if it's the last round with the dealer ending in first place -- then the game just ends."
msgstr "（和了やめ）例外として最終局で親が1位の場合、ゲームはそのまま終了する。"

msgid "(Agariyame) An exception is if the dealer ends up in first place -- then the dealer may choose whether to pass the dealership."
msgstr "（和了やめ）例外として親が1位になった場合、親は連荘するか席を譲るかを選択できる。"

msgid "(Agariyame) An exception is if the dealer ends up in first place -- then the dealership passes."
msgstr "（和了やめ）例外として親が1位になった場合、親は席を譲る。"
msgid "(Aka) Each aka (red) dora in a closed winning hand adds %{chips} shuugi to the payment."
msgstr "（赤）門前での和了時に各赤ドラが%{chips}点の祝儀を追加。"

msgid "(Aka) Each aka (red) dora in a winning hand adds %{chips} shuugi to the payment."
msgstr "（赤）和了時に各赤ドラが%{chips}点の祝儀を追加。"

msgid "(Aka) If your hand is closed, each aka dora is worth 1 shuugi chip."
msgstr "（赤）門前の場合、各赤ドラは1枚の祝儀チップの価値がある。"

msgid "(Ao) Each ao (blue) dora in a closed winning hand adds %{chips} shuugi to the payment."
msgstr "（青）門前での和了時に各青ドラが%{chips}点の祝儀を追加。"

msgid "(Ao) Each ao (blue) dora in a winning hand adds %{chips} shuugi to the payment."
msgstr "（青）和了時に各青ドラが%{chips}点の祝儀を追加。"

msgid "(Blind Pass) On the third (and sixth) charleston pass, each player may choose to 'blind pass' up to three tiles, which means instead of passing a tile from hand, pass 1 to 3 of the tiles that are being passed to you this round. In Riichi Advanced, this is done by selecting the upside-down tiles that appear in your hand."
msgstr "（ブラインドパス）チャールストンの3回目（および6回目）のパスで、各プレイヤーは最大3枚を「ブラインドパス」できる。手牌から渡す代わりに、このラウンドに渡される牌のうち1〜3枚を渡す。リアーチ・アドバンスでは、手牌に現れる裏向きの牌を選択することで行う。"

msgid "(Blue Dragon) Daisangen is now 2 han (+3 from dragons)."
msgstr "（青龍）大三元は2翻になる（三元牌からの+3翻）。"

msgid "(Blue Dragon) For dragons, the sequence for dora indicators is White, Green, Red, Blue."
msgstr "（青龍）ドラ表示牌としての三元牌の順序は、白、發、中、青。"

msgid "(Blue Dragon) Having four dragon triplets awards the Daisuugen double yakuman."
msgstr "（青龍）4種類の三元牌の刻子で大四喜（ダブル役満）。"

msgid "(Blue Dragon) Having three dragon triplets and a dragon pair awards the Shousuugen yakuman."
msgstr "（青龍）3種類の三元牌の刻子と1つの三元牌の対子で小四喜（役満）。"

msgid "(Blue Dragon) Shousangen is now 1 han (+2 from dragons)."
msgstr "（青龍）小三元は1翻になる（三元牌からの+2翻）。"

msgid "(Called Game) If any player is above %{called_game_above} points, the game ends and each such player is paid %{chips} shuugi from every other player."
msgstr "（コールドゲーム）いずれかのプレイヤーが%{called_game_above}点を超えた場合、ゲームは終了し、そのプレイヤーは他の全プレイヤーから%{chips}枚の祝儀を受け取る。"

msgid "(Chii in Sanma) Chii is allowed."
msgstr "（三麻チー）チーが許可される。"

msgid "(Chinroutou Pao) Dealing the last tile called for kan for a chinroutou hand also counts."
msgstr "（清老頭包）清老頭の手でカンに必要な最後の牌を切った場合も包が適用される。"

msgid "(Click the tile to discard it.)"
msgstr "（牌をクリックして捨てます。）"

msgid "(Click to continue)"
msgstr "（クリックして続行）"

msgid "(Conceal) Every turn, you may bet 1000 points in order to conceal your next discard (flipping it upside down). These concealed tiles are uncallable, are not considered furiten, and does not count against nagashi. Concealed tiles are not revealed at the end of a round."
msgstr "（伏せ）毎ターン、1000点を賭けて次の捨て牌を伏せることができる。伏せた牌はポン・チー等の対象にならず、フリテンとは見なされず、流局時の荒茶（ナガシ）にも数えない。伏せた牌は局終了時に公開されない。"

msgid "(Cosmic) If you fuun and then tsumo on the replacement tile, you are awarded rinshan (1 han)."
msgstr "（コズミック）風圏（フーン）を宣言し、その補充牌で自摸和了した場合、嶺上開花（1翻）が成立。"

msgid "(Dora counts.)"
msgstr "（ドラが有効）"

msgid "(Dora does not count.)"
msgstr "（ドラは無効）"

msgid "(Fei Payments) Upon an exhaustive draw (the wall runs out of tiles), players reveal their hands and each player pays each player some amount of points for each Fei Joker in the recipient's hand."
msgstr "（フェイ支払い）流局時、全員が手牌を公開し、各プレイヤーは受け取る側の手牌にあるフェイジョーカー1枚につき、所定の点数を支払う。"

msgid "(Flowers do not count.)"
msgstr "（花牌は無効）"

msgid "(Galaxy Mahjong) Every galaxy tile used as its original tile awards one shuugi."
msgstr "（ギャラクシー麻雀）ギャラクシー牌を本来の牌として使用した場合、各1枚につき1点の祝儀。"

msgid "(Galaxy Mahjong) Having any 14 galaxy tiles awards the Milky Way yakuman."
msgstr "（ギャラクシー麻雀）ギャラクシー牌を14枚集めると「ミルキーウェイ」役満。"

msgid "(Golden Chun) Completing a hand via shiro pocchi while using the golden chun as a five and having the aka green dragon scores yakuman."
msgstr "（金中）金中を5として使いつつ、赤發を持ち、白ポッチで和了すると役満。"

msgid "(Golden Chun) Winning with a hand that uses the golden chun as a five adds 2 shuugi to the payment."
msgstr "（金中）金中を5として使用した和了の場合、支払いに2点の祝儀を追加。"

msgid "(Half Flush) You get 1 Fan if your hand has only tiles of one suit, plus honours. This is always awarded."
msgstr "（混一色）一色と字牌のみの手牌で1ファン。常に与えられる。"

msgid "(Ippatsu) If you win before or during your next draw after riichi, you are awarded ippatsu (1 han). Calls invalidate ippatsu."
msgstr "（一発）立直後、次のツモまでに和了すると一発（1翻）。副露で無効。"

msgid "(Ippatsu) Winning by ippatsu adds %{chips} shuugi to the payment."
msgstr "（一発）一発での和了は%{chips}点の祝儀を追加。"

msgid "(Isshoku Yonjun) If you win with isshoku yonjun (123123123123 of the same suit) and called the fourth sequence from a player, that player is responsible for the yakuman payment if you tsumo, or half of the payment if you ron off someone else."
msgstr "（一色四順）同種の123を4組（123123123123）で和了し、4つ目の順子を他家からチーした場合、その他家が自摸和了時の役満分を全額、ロン和了時は半分を支払う責任を負う。"

msgid "(Joker Swapping) During any player's turn, they can replace a tile in hand if it matches an existing meld on the table (not just their own melds!) that contains a joker. This action swaps the tile in hand with the meld's joker."
msgstr "（ジョーカー交換）自分のターン中、手牌の牌が場に晒されているジョーカーを含む面子（自分の面子だけでなく他者の面子も対象）と交換できる。手牌の牌と面子内のジョーカーを交換する。"

msgid "(Kansai) 6 han if you have chiitoitsu honitsu."
msgstr "（関西）チートイツ混一色は6翻。"

msgid "(Kansai) At the end of the game, chips are exchanged based on placement and points."
msgstr "（関西）ゲーム終了時、順位と点数に基づいてチップを交換。"

msgid "(Kansai) Everyone starts with 50000 points."
msgstr "（関西）全員50000点で開始。"

msgid "(Kansai) In the south round only, the round repeats on exhaustive draws regardless of anyone's tenpai status."
msgstr "（関西）南場に限り、流局時は誰もテンパイしていなくても、その局をやり直す。"

msgid "(Kansai) Yakuman if you have chiitoitsu chinitsu."
msgstr "（関西）チートイツ清一色は役満。"

msgid "(Kansai) Yakuman if you have manzu honitsu."
msgstr "（関西）萬子混一色は役満。"

msgid "(Kin) Each kin (gold) dora in a closed winning hand adds %{chips} shuugi to the payment."
msgstr "（金）門前での和了時に各金ドラが%{chips}点の祝儀を追加。"

msgid "(Kin) Each kin (gold) dora in a winning hand adds %{chips} shuugi to the payment."
msgstr "（金）和了時に各金ドラが%{chips}点の祝儀を追加。"

msgid "(Lock) When another player reveals your concealed discard, you may bet 4000 additional points to negate the negation of your concealed discard. If this is done, then the tile is never revealed to the table, and this cannot be negated."
msgstr "（ロック）他のプレイヤーがあなたの伏せ牌を公開した場合、4000点を追加で賭けて、その伏せ牌の公開を取り消す（再び伏せたままにする）ことができる。この場合、その牌は場に公開されず、この取り消しをさらに無効化することはできない。"

msgid "(Nippatsu) If you win on the second go-around after riichi, you are awarded nippatsu (1 han). Any call starting from the riichi onward invalidates nippatsu."
msgstr "（二発）立直後、次の自分のツモの次の巡で和了すると二発（1翻）。立直以降の副露で無効。"

msgid "(No Riichi Ankan) You may not call concealed kan while in riichi."
msgstr "（立直中暗槓禁止）立直中は暗槓を宣言できない。"

msgid "(Open Riichi) You may also declare open riichi, which reveals your hand but is worth 1 more han if you win."
msgstr "（オープン立直）手牌を公開する「オープン立直」を宣言することもできる。和了した場合、1翻追加。"

msgid "(Reveal) When another player conceals their discard, the first player to press Reveal bets 2000 points to negate the conceal action. All bets stay on the table."
msgstr "（公開）他者が伏せ牌をした場合、最初に「公開」ボタンを押したプレイヤーが2000点を賭けて伏せを無効化する。賭けた点棒は場に残る。"

msgid "(Rinshan Pao) Dealing a discard called for kan by a player, who then immediately wins with rinshan, also counts, except you pay for the full hand (not just rinshan)."
msgstr "（嶺上包）カンを宣言したプレイヤーが、その補充牌で即座に嶺上開花で和了した場合も包が適用される。ただし、支払いは嶺上分だけでなく手牌全体の責任を負う。"

msgid "(Sanma) The 2 to 8 of characters are removed from the wall."
msgstr "（三麻）萬子の2〜8が壁から除外される。"

msgid "(Sanma) You cannot call chii in sanma."
msgstr "（三麻）三麻ではチーができない。"

msgid "(Sanma) You may declare north winds to draw a replacement tile from the dead wall. Each is worth 1 han. North winds are still usable to form pairs and triplets. If you are waiting on the north wind, you may ron a north wind declaration much like chankan (but you are not awarded chankan)."
msgstr "（三麻）北風を宣言して嶺上牌から補充牌を引くことができる。各北風は1翻。北風は対子や刻子に使うことも可能。北風待ちの場合、相手の北風宣言に対してロンできる（槍槓と同様だが、槍槓は付与されない）。"

msgid "(Self-Draw Seven Pairs) You must win by self-draw."
msgstr "（七対子自摸限定）七対子は自摸和了のみ有効。"

msgid "(Seven Pairs) You get 1 Fan if your winning hand consists of 7 pairs."
msgstr "（七対子）和了手が7組の対子で構成されている場合、1ファン。"

msgid "(Shiro Pocchi) Winning in riichi via shiro pocchi is worth 1 shuugi."
msgstr "（白ポッチ）白ポッチで和了した場合、1点の祝儀。"

msgid "(Space Mahjong) Open kokushi musou is worth 3 han."
msgstr "（スペース麻雀）オープン国士無双は3翻。"

msgid "(Speed Tonpuu) 1x %{5m}, 1x %{5p}, and 1x %{5s} are replaced with red \\\"aka dora\\\" fives %{aka} worth 1 han and one chip each."
msgstr "（スピード東風）%{5m}を1枚、%{5p}を1枚、%{5s}を1枚、赤ドラ5 %{aka}に交換。各1翻とチップ1枚。"

msgid "(Speed Tonpuu) 1x %{5p} is replaced with a gold five %{kin} worth 1 han and one chip. This 1 han counts as yaku."
msgstr "（スピード東風）%{5p}を1枚、金の5 %{kin}に交換。1翻とチップ1枚。この1翻は役として数える。"

msgid "(Speed Tonpuu) 1x %{7m}, 1x %{7p}, and 1x %{7s} are replaced with blue \\\"ao dora\\\" sevens %{ao} worth 1 han and 2 chips each."
msgstr "（スピード東風）%{7m}、%{7p}、%{7s}を各1枚、青ドラ7 %{ao}に交換。各1翻とチップ2枚。"

msgid "(Stackable Limit) You may stack multiple instances of 10 Fan by achieving more than one of these. This is the only way to exceed the 10 Fan limit."
msgstr "（スタック可能リミット）複数の10ファン条件を満たすことで、10ファンを上限とせずに加算できる。10ファンを超える唯一の方法。"

msgid "(Super Bingo)"
msgstr "（スーパービンゴ）"

msgid "(Super Bingo) 3 han if each of the 5 blocks in your hand contains a terminal or honor. 4 han if closed."
msgstr "（スーパービンゴ）手牌の5つのブロックのそれぞれに么九牌または字牌が含まれる場合3翻。門前なら4翻。"

msgid "(Super Bingo) 4 han if each of the 5 blocks in your hand contains a terminal. 6 han if closed."
msgstr "（スーパービンゴ）手牌の5つのブロックのそれぞれに么九牌が含まれる場合4翻。門前なら6翻。"

msgid "(Super Bingo) 4 han if you win with seven pairs with a repeated pair. 8 han for two repeated pairs, yakuman for three."
msgstr "（スーパービンゴ）七対子で1組重複した対子がある場合4翻。2組重複で8翻、3組重複で役満。"

msgid "(Super Bingo) 6 han if you win off someone's discard before your first draw. Calls invalidate."
msgstr "（スーパービンゴ）最初のツモ前に他家の捨て牌で和了した場合6翻。副露は無効。"

msgid "(Super Bingo) A single gold north wind is added. This tile has no special functionality except when you use it to declare a Grand Cross. In that case, you are paid 20 from each player instead of 10."
msgstr "（スーパービンゴ）金の北風が1枚追加される。この牌は特別な機能を持たないが、これを「グランドクロス」の宣言に使用した場合、各プレイヤーから10ではなく20を受け取る。"

msgid "(Super Bingo) Actually, kazoe yakuman awards 2 chips flat."
msgstr "（スーパービンゴ）なお、数え役満は一律2枚のチップ。"

msgid "(Super Bingo) Double yakuman if your winning hand consists of one of each terminal/seven/honor tile and you won with a thirteen-sided wait for the pair."
msgstr "（スーパービンゴ）么九牌・7・字牌をすべて1枚ずつ持ち、対子となる13面待ちで和了した場合、ダブル役満。"

msgid "(Super Bingo) Each rainbow seven in a winning hand adds 10 shuugi to the payment."
msgstr "（スーパービンゴ）和了手にレインボー7が1枚あるごとに、支払いに10点の祝儀を追加。"

msgid "(Super Bingo) Grand Cross is instead worth 1 han."
msgstr "（スーパービンゴ）グランドクロスは代わりに1翻。"

msgid "(Super Bingo) Having both rainbow sevens in your winning hand grants +1 tier (max tier is still 3)."
msgstr "（スーパービンゴ）和了手にレインボー7を2枚持っている場合、ティアが+1される（上限は3のまま）。"

msgid "(Super Bingo) If you are in furiten, then you are required to declare open riichi when possible."
msgstr "（スーパービンゴ）フリテンの場合、可能であればオープン立直を宣言しなければならない。"

msgid "(Super Bingo) If you win with shiro pocchi %{9z}, it takes on the identity of any unseen tile. In particular, it can take on the identity of a red five or gold five as long as those tiles are not visible to you. (Unimplemented:) The game automatically chooses for you, with priority %{35p} >  %{05p} >  %{5p}."
msgstr "（スーパービンゴ）%{9z}の白ポッチで和了した場合、それは未見の任意の牌として扱われる。特に、赤5や金5が自分に見えていない場合は、それらとして扱える。（未実装:）ゲームが自動的に選択し、優先順位は%{35p} > %{05p} > %{5p}。"

msgid "(Super Bingo) One %{7p} and one %{7s} are replaced by %{rainbows}."
msgstr "（スーパービンゴ）%{7p}と%{7s}を各1枚、%{rainbows}に交換。"

msgid "(Super Bingo) The %{manzu} are replaced with %{sevens}."
msgstr "（スーパービンゴ）%{manzu}を%{sevens}に置き換えます。"

msgid "(Super Bingo) Yakuman if your winning hand consists of one of each terminal/seven/honor tile, with another copy of one of those tiles forming a pair."
msgstr "（スーパービンゴ）和了手が么九牌・7・字牌をすべて1枚ずつ持ち、そのうち1枚がもう1枚あって対子になる場合、役満。"

msgid "(Super Bingo) You are not permitted to skip a winning tile."
msgstr "（スーパービンゴ）和了牌を見逃すことはできない。"

msgid "(Super Bingo) You may not use more than 4 of the same seven in your winning hand. If you have all 4 sevens, any potential wait on the same 7 is not counted as a wait (cannot put you in furiten)."
msgstr "（スーパービンゴ）和了手に同じ7を4枚以上使用してはならない。7を4枚すべて持っている場合、その7への待ちは待ちとして認められない（フリテンにならない）。"

msgid "(Suukantsu Pao) Dealing the last tile called for kan for a suukantsu hand also counts."
msgstr "（四槓子包）四槓子の手で槓に必要な最後の牌を切った場合も包が適用される。"

msgid "(Suurenkou) If you win with suurenkou (four consecutive triplets of the same suit like 111 222 333 444) and called the fourth triplet or kan from a player, that player is responsible for the yakuman payment if you tsumo, or half of the payment if you ron off someone else."
msgstr "（四連刻）四連刻（同種の111 222 333 444）で和了し、4つ目の刻子または槓を他家からポン・カンした場合、その他家が自摸和了時の役満分を全額、ロン和了時は半分を支払う責任を負う。"

msgid "(Tenpaiyame) After every round, the dealer may choose whether to pass the dealership."
msgstr "（テンパイやめ）各局終了後、親はテンパイしていれば連荘するか席を譲るかを選択できる。"

msgid "(Tenpaiyame) An exception is if it's the last round -- then the dealer may choose whether to end the game."
msgstr "（テンパイやめ）例外として最終局の場合、親はテンパイしていればゲームを終了するかを選択できる。"

msgid "(Tenpaiyame) An exception is if it's the last round -- then the game just ends."
msgstr "（テンパイやめ）例外として最終局の場合、ゲームはそのまま終了する。"

msgid "(Tenpaiyame) An exception is if it's the last round and the tenpai dealer becomes first place -- then the dealer may choose whether to end the game."
msgstr "（テンパイやめ）例外として最終局でテンパイの親が1位になった場合、親はゲームを終了するかを選択できる。"

msgid "(Tenpaiyame) An exception is if it's the last round and the tenpai dealer becomes first place -- then the game just ends."
msgstr "（テンパイやめ）例外として最終局でテンパイの親が1位になった場合、ゲームはそのまま終了する。"

msgid "(Tenpaiyame) An exception is if the tenpai dealer becomes first place -- then the dealer may choose whether to pass the dealership."
msgstr "（テンパイやめ）例外としてテンパイの親が1位になった場合、親は連荘するか席を譲るかを選択できる。"

msgid "(Tenpaiyame) An exception is if the tenpai dealer becomes first place -- then the dealership passes."
msgstr "（テンパイやめ）例外としてテンパイの親が1位になった場合、親は席を譲る。"

msgid "(Tobi) If any player dips below %{tobi_below} points, the game ends and each such player pays %{chips} shuugi to every other player."
msgstr "（トビ）いずれかのプレイヤーが%{tobi_below}点未満になった場合、ゲームは終了し、そのプレイヤーは他の全プレイヤーに%{chips}枚の祝儀を支払う。"

msgid "(Toriuchi) On ron, each 1s (bird) tile is worth 1 shuugi, unless the discarder's hand contains 7p (pistol) which would shoot the birds dead. That is, unless the winner's hand contains 8s (birdcage) which would protect the birds from gunfire."
msgstr "（鳥打ち）ロン和了時、各1s（鳥）は1点の祝儀。ただし、捨てた側の手に7p（拳銃）がある場合は鳥は撃ち落とされる。さらに、和了者の手に8s（鳥かご）がある場合は鳥は守られる。"

msgid "(Tsuuiisou Pao) Dealing the last tile called for kan for a tsuuiisou hand also counts."
msgstr "（字一色包）字一色の手でカンに必要な最後の牌を切った場合も包が適用される。"

msgid "(Ura) Each ura dora adds %{chips} shuugi to the payment."
msgstr "（裏）各裏ドラが%{chips}点の祝儀を追加。"

msgid "(Ura) Players in riichi are also eligible for ura dora, worth 1 extra han each. Ura dora are indicated by ura dora indicators, the tiles underneath each dora indicator at the time a win is declared."
msgstr "（裏）立直中のプレイヤーは裏ドラの対象となり、各1翻追加。裏ドラは和了宣言時点のドラ表示牌の下にある牌で示される。"

msgid "(Vietnamese) You can only Coong with four non-joker tiles."
msgstr "（ベトナム）槓（クオン）はジョーカー以外の4枚でのみ宣言できる。"

msgid "(Vietnamese) You cannot Phỗng with more than one joker tile."
msgstr "（ベトナム）ポン（フォン）にジョーカーを2枚以上使用することはできない。"

msgid "(Vietnamese) You cannot Ăn with more than one joker tile."
msgstr "（ベトナム）チー（アン）にジョーカーを2枚以上使用することはできない。"

msgid "(Yakuman) A yakuman win adds %{ron_chips} shuugi to the payment if ron or %{tsumo_chips} shuugi if tsumo."
msgstr "（役満）役満での和了はロンの場合は%{ron_chips}点、ツモの場合は%{tsumo_chips}点の祝儀を追加。"

msgid "(Yakuman) Each count of yakuman adds %{ron_chips} shuugi to the payment if ron or %{tsumo_chips} shuugi if tsumo."
msgstr "（役満）役満の数1つにつき、ロンの場合は%{ron_chips}点、ツモの場合は%{tsumo_chips}点の祝儀を追加。"

msgid "(Yakuman) Kazoe yakuman counts as yakuman for shuugi purposes."
msgstr "（役満）数え役満は祝儀の計算上、役満として扱う。"

msgid "(Yakuman) Kazoe yakuman does not count as yakuman for shuugi purposes."
msgstr "（役満）数え役満は祝儀の計算上、役満として扱わない。"

msgid "(Yes Riichi Ankan) You may freely call concealed quads in riichi even if they change your waits."
msgstr "（立直中暗槓許可）立直中でも、待ちが変わっても暗槓を自由に宣言できる。"

msgid "(ongoing)"
msgstr "（進行中）"

msgid "(with AI)"
msgstr "（AI対戦）"

msgid "+1 Mủn if all four quads are concealed."
msgstr "4つの槓がすべて暗槓の場合、+1ムン。"

msgid "+1 Mủn if combined with Single Wait and Fully Closed Hand."
msgstr "単騎待ち・門前清自摸和と複合する場合、+1ムン。"

msgid "+1 Mủn if no jokers."
msgstr "ジョーカーがない場合、+1ムン。"

msgid "+1 Mủn if no jokers. +1 Mủn if combined with Single Wait and Fully Closed Hand."
msgstr "ジョーカーがない場合+1ムン。単騎待ち・門前清自摸和と複合する場合+1ムン。"

msgid "+1 Phán if no jokers."
msgstr "ジョーカーがない場合、+1ファン。"

msgid "+1 fan for each concealed Kong. Does not contribute towards the 2 fan minimum or Multiple Patterns. Stacks with Kong Blossom."
msgstr "各暗槓につき+1翻。2翻最低ラインや複合パターンには含まれない。槓上開花（コンブロッサム）とは複合する。"

msgid "+1 fan for each pattern if you won with 2 or more win patterns. Does not contribute towards the 2 fan minimum."
msgstr "2つ以上の和了パターンで和了した場合、各パターンにつき+1翻。2翻最低ラインには含まれない。"

msgid "×2 fan multiplier if you won with the replacement tile drawn after a Kong."
msgstr "槓後の補充牌で和了した場合、翻数×2。"

msgid "×4 fan multiplier if you are not the dealer and you won with the tiles initially drawn. Does not contribute towards Multiple Patterns."
msgstr "子で最初のツモ牌で和了した場合、翻数×4。複合パターンには含まれない。"

msgid "×6 fan multiplier if you are the dealer and you won with the tiles initially drawn. Does not contribute towards Multiple Patterns."
msgstr "親で最初のツモ牌で和了した場合、翻数×6。複合パターンには含まれない。"

msgid ","
msgstr "、"

msgid "- %{any} can represent any tile."
msgstr "- %{any}は任意の牌を表す。"

msgid "- %{dragon} can represent any dragon."
msgstr "- %{dragon}は任意の三元牌を表す。"

msgid "- %{honour} can represent any honour tile."
msgstr "- %{honour}は任意の字牌を表す。"

msgid "- %{manzu} can represent any character tile."
msgstr "- %{manzu}は任意の萬子を表す。"

msgid "- %{number} can represent any number (suited) tile."
msgstr "- %{number}は任意の数牌を表す。"

msgid "- %{pinzu} can represent any circle tile."
msgstr "- %{pinzu}は任意の筒子を表す。"

msgid "- %{souzu} can represent any bamboo tile."
msgstr "- %{souzu}は任意の索子を表す。"

msgid "- %{wind} can represent any wind tile."
msgstr "- %{wind}は任意の風牌を表す。"

msgid "- (%{name}) All thirteen terminal/honor tiles plus one forming a pair."
msgstr "- (%{name}) 么九牌と字牌をすべて1枚ずつ持ち、そのうち1枚で対子を作る。"

msgid "- (Added) If you previously called Pong, you can add the fourth tile to it but only if you draw the tile yourself. This awards you an instant payment of 50 from each player."
msgstr "- （加槓）以前にポンした刻子に、自分で引いた4枚目を加えて槓にできる。各プレイヤーから即座に50点を受け取る。"

msgid "- (Chiitoitsu) Seven distinct pairs."
msgstr "- （七対子）7組の異なる対子。"

msgid "- (Concealed) If you have four of a kind, you can declare them as a Concealed Gong. This awards you an instant payment of 100 from each player."
msgstr "- （暗槓）4枚組がある場合、暗槓として宣言できる。各プレイヤーから即座に100点を受け取る。"

msgid "- (Cosmic Riichi) Seven Pairs is again a possible winning hand."
msgstr "- （コズミック立直）七対子が再び和了可能な手になる。"

msgid "- (Four Fei Win) Your starting hand contains four Fei Jokers, which counts as an immediate win."
msgstr "- （フェイ4枚和了）配牌にフェイジョーカーが4枚あり、即座に和了となる。"

msgid "- (Four Fei Win) Your starting hand contains four Fei Jokers."
msgstr "- （フェイ4枚和了）配牌にフェイジョーカーが4枚ある。"

msgid "- (Galaxy Mahjong) You have 14 galaxy tiles."
msgstr "- （ギャラクシー麻雀）ギャラクシー牌を14枚持っている。"

msgid "- (Kansai Chiitoitsu) Seven pairs (repeats allowed)."
msgstr "- （関西チートイツ）七対子（重複あり）。"

msgid "- (Knitted Hand) 14 unique tiles (no pair) from the following set of 16 tiles: 147 of one suit, 258 of a second suit, 369 of a third suit, all winds, and all dragons."
msgstr "- （ニーデッドハンド）次の16種のうち14枚を重複なしで集める: 一色の147、別の一色の258、さらに別の一色の369、すべての風牌、すべての三元牌。"

msgid "- (Knitted Straight) A knitted straight plus one set and a pair. A knitted straight consists of 147 of one suit, 258 of a second suit, and 369 of a third suit."
msgstr "- （ニーデッドストレート）ニーデッドストレートに1面子と1対子を加えた形。ニーデッドストレートは、一色の147、別の一色の258、さらに別の一色の369で構成。"

msgid "- (Kokushi Musou) All thirteen terminal/honor tiles plus one forming a pair."
msgstr "- （国士無双）么九牌と字牌をすべて1枚ずつ持ち、そのうち1枚で対子を作る。"

msgid "- (No Seven Pairs) Seven Pairs is no longer a winning hand."
msgstr "- （七対子なし）七対子は和了手として認められない。"

msgid "- (Open) If you have three of a kind, you can claim the fourth if someone discarded it. This awards you an instant payment of 100 from the discarder."
msgstr "- （明槓）3枚組がある場合、他家が捨てた4枚目をポンして明槓にできる。捨てたプレイヤーから即座に100点を受け取る。"

msgid "- (Seven Pairs) Seven distinct pairs."
msgstr "- （七対子）7組の異なる対子。"

msgid "- (Shiisanpuutaa) Start with 13 disconnected tiles, plus one forming a pair."
msgstr "- （十三不塔）13枚の孤立した牌と、そのうち1枚の対子で開始する。"

msgid "- (Shiisanuushi) Start with 14 disconnected tiles."
msgstr "- （十三無xi）14枚の孤立した牌で開始する。"

msgid "- (Space Mahjong) Seven Pairs is no longer a winning hand."
msgstr "- （スペース麻雀）七対子は和了手として認められない。"

msgid "- (Super Bingo) A rainbow seven flipped during this process is treated as a normal seven (matches 678 of that suit) but earns twice the number of chips, that is, two chips per match."
msgstr "- （スーパービンゴ）この過程でめくられたレインボー7は通常の7として扱われる（その種の678に対応）が、獲得チップは2倍、つまり一致ごとに2枚。"

msgid "- (Super Bingo) While in riichi, you instantly win with haneman if you discard three sevens in a row."
msgstr "- （スーパービンゴ）立直中に7を3連続で捨てた場合、即座に跳満で和了。"

msgid "- (Super Bingo) While in riichi, you instantly win with haneman if your riichi discards form a line of three sevens in your discards (orthogonal or diagonal)."
msgstr "- （スーパービンゴ）立直中に、自分の捨て牌の中で7が縦・横・斜めに3つ並んだ場合、即座に跳満で和了。"

msgid "- (Thirteen Unconnected) All of your tiles are not connected, i.e. they are 3 away from each other or more, except you have a pair of one of the tiles. In addition, the suited tiles among them must form a partial Knitted Triplets (147 147 147) or a partial Knitted Straight (147 258 369); and you must have at least one tile of each suit, at least one wind, and at least one dragon."
msgstr "- （十三不塔）すべての牌が互いに3以上離れており、1組の対子がある。さらに、数牌の中には部分的ニーデッド三暗刻（147 147 147）または部分的ニーデッド一気通貫（147 258 369）を形成する必要があり、各種類の数牌を最低1枚、風牌を最低1枚、三元牌を最低1枚持つ必要がある。"

msgid "- (Vietnamese NFNL) Starting with no flowers in your hand, you complete one of the above hands while discarding every honor, flower, or joker tile as soon as possible. (Your final hand cannot have honors, flowers, or jokers.)"
msgstr "- （ベトナムNFNL）手牌に花牌がない状態から開始し、字牌・花牌・ジョーカーを可能な限り早く捨てながら、上記のいずれかの手を完成させる。（最終的な手牌に字牌・花牌・ジョーカーは含められない。）"

msgid "- (Vietnamese NFNL) Starting with no flowers in your hand, you deal (as your first discards) three flowers as your first discards."
msgstr "- （ベトナムNFNL）手牌に花牌がない状態から開始し、最初の捨て牌として花牌を3枚捨てる。"

msgid "- (Vietnamese NFNL) Starting with no flowers in your hand, you deal (as your first discards) three flowers or jokers, and proceed to discard until you have no honors, flowers or jokers, at which point you can win on the next discarded or drawn number tile."
msgstr "- （ベトナムNFNL）手牌に花牌がない状態から開始し、最初の捨て牌として花牌またはジョーカーを3枚捨て、字牌・花牌・ジョーカーがなくなるまで捨て続け、その後の最初の数牌のツモまたは捨て牌で和了できる。"

msgid "- (Vietnamese NFNL) Starting with no flowers in your hand, you deal (as your first discards) three tiles from the set %{blue_jokers} (blue jokers + number joker) as your first discards."
msgstr "- （ベトナムNFNL）手牌に花牌がない状態から開始し、最初の捨て牌として%{blue_jokers}（青ジョーカー+数ジョーカー）から3枚を捨てる。"

msgid "- 4x of each bamboo tile (1 to 9): %{souzu}"
msgstr "- 各索子（1〜9）4枚: %{souzu}"

msgid "- 4x of each character tile (1 to 9): %{manzu}"
msgstr "- 各萬子（1〜9）4枚: %{manzu}"

msgid "- 4x of each circle tile (1 to 9): %{pinzu}"
msgstr "- 各筒子（1〜9）4枚: %{pinzu}"

msgid "- 4x of each of the four Winds (East, South, West, North) %{winds}"
msgstr "- 各風牌（東、南、西、北）4枚: %{winds}"

msgid "- 4x of each of the three Dragons (White, Green, Red) %{dragons}"
msgstr "- 各三元牌（白、發、中）4枚: %{dragons}"

msgid "- A triplet of East Winds %{east_wind_triplet}"
msgstr "- 東風の刻子 %{east_wind_triplet}"

msgid "- A triplet of North Winds %{north_wind_triplet}"
msgstr "- 北風の刻子 %{north_wind_triplet}"

msgid "- A triplet of dragon tiles %{dragons}"
msgstr "- 三元牌の刻子 %{dragons}"

msgid "- A triplet of winds matching the round marker %{round_winds}"
msgstr "- 場風に一致する風牌の刻子 %{round_winds}"

msgid "- A triplet of winds matching your seat %{seat_winds}"
msgstr "- 自風に一致する風牌の刻子 %{seat_winds}"

msgid "- After adding all the fu, round up to the next 10. So 32 becomes 40 fu, but 30 fu stays 30 fu."
msgstr "- すべての符を合計した後、10の位に切り上げる。例: 32符は40符になるが、30符は30符のまま。"

msgid "- An open hand is minimum 30 fu. You still start at 20 fu, but if you end with 20 fu, it becomes 30 fu."
msgstr "- 副露した手の最低符は30符。基本符は20符だが、合計が20符の場合、30符として扱う。"

msgid "- As soon as you draw a seventh flower, you may declare a win for an additional 3 Fan, or 8 Fan if you have eight flowers."
msgstr "- 7枚目の花牌を引いた時点で、追加の3ファンで和了を宣言できる。8枚の場合は8ファン。"

msgid "- As soon as you draw an eighth flower, you may declare a win for an additional 8 Fan."
msgstr "- 8枚目の花牌を引いた時点で、追加の8ファンで和了を宣言できる。"

msgid "- Bamboo tiles: %{reversible_s}"
msgstr "- 索子: %{reversible_s}"

msgid "- Calling a concealed kong immediately awards 2 points from every player. %{ankan}"
msgstr "- 暗槓を宣言すると、全プレイヤーから即座に2点を受け取る。%{ankan}"

msgid "- Calling a kong on a discard immediately awards 1 point from the discarder. %{daiminkan}"
msgstr "- 捨て牌で明槓を宣言すると、捨てたプレイヤーから即座に1点を受け取る。%{daiminkan}"

msgid "- Calling a kong to upgrade a triplet immediately awards 1 point from every player. %{kakan}"
msgstr "- 刻子に加えて槓（加槓）を宣言すると、全プレイヤーから即座に1点を受け取る。%{kakan}"

msgid "- Chiitoitsu (7 pairs) is worth 25 fu flat."
msgstr "- 七対子（7対子）は固定で25符。"

msgid "- Circle tiles: %{reversible_p}"
msgstr "- 筒子: %{reversible_p}"

msgid "- Declaring all four flowers %{flowers} or all four seasons %{seasons} immediately awards 4 points."
msgstr "- 4枚の花牌 %{flowers} または4枚の季節牌 %{seasons} をすべて宣言すると、即座に4点。"

msgid "- Declaring both a cat %{cat} and a mouse tile %{mouse} immediately awards 2 points from every player, or 4 points if done at the start of the game."
msgstr "- 猫 %{cat} と鼠 %{mouse} の両方を宣言すると、全プレイヤーから即座に2点。ゲーム開始時なら4点。"

msgid "- Declaring both a chicken %{chicken} and a centipede tile %{centipede} immediately awards 2 points from every player, or 4 points if done at the start of the game."
msgstr "- 鶏 %{chicken} と蜈蚣 %{centipede} の両方を宣言すると、全プレイヤーから即座に2点。ゲーム開始時なら4点。"

msgid "- Declaring both your seat flower %{flower} and your seat season %{season} immediately awards 2 points from every player, or 4 points if done at the start of the game."
msgstr "- 自風に対応する花牌 %{flower} と季節牌 %{season} の両方を宣言すると、全プレイヤーから即座に2点。ゲーム開始時なら4点。"

msgid "- Each triplet is worth 2 fu, 4 if terminal/honors, 4 if closed, 8 if terminal/honors and closed."
msgstr "- 各刻子は2符。么九牌・字牌なら4符、門前なら4符、么九牌・字牌かつ門前なら8符。"

msgid "- Eight jokers %{jokers}"
msgstr "- ジョーカー8枚 %{jokers}"

msgid "- Five sets (sequences or triplets) and a pair."
msgstr "- 5組の面子（順子または刻子）と1組の対子。"

msgid "- Four Animal tiles %{animals}"
msgstr "- 動物牌4枚 %{animals}"

msgid "- Four Face tiles %{faces}"
msgstr "- 人物牌4枚 %{faces}"

msgid "- Four Fei Jokers %{feis}"
msgstr "- フェイジョーカー4枚 %{feis}"

msgid "- Four Flower tiles, numbered from 1 to 4 %{flowers}"
msgstr "- 花牌4枚（1から4）%{flowers}"

msgid "- Four Flowers %{flowers}"
msgstr "- 花牌4枚 %{flowers}"

msgid "- Four Kings %{kings}"
msgstr "- 王牌4枚 %{kings}"

msgid "- Four Queens %{queens}"
msgstr "- 女王牌4枚 %{queens}"

msgid "- Four Season tiles, numbered from 1 to 4 %{seasons}"
msgstr "- 季節牌4枚（1から4）%{seasons}"

msgid "- Four Seasons %{seasons}"
msgstr "- 季節牌4枚 %{seasons}"

msgid "- Four animals %{animals}"
msgstr "- 動物牌4枚 %{animals}"

msgid "- Four blank tiles %{tiles}"
msgstr "- ブランク牌4枚 %{tiles}"

msgid "- Four each of the 1 to 9 of Bams %{souzu}"
msgstr "- 各索子（1〜9）4枚 %{souzu}"

msgid "- Four each of the 1 to 9 of Craks %{manzu}"
msgstr "- 各萬子（1〜9）4枚 %{manzu}"

msgid "- Four each of the 1 to 9 of Dots %{pinzu}"
msgstr "- 各筒子（1〜9）4枚 %{pinzu}"

msgid "- Four each of the 1 to 9 of bamboo %{souzu}"
msgstr "- 各索子（1〜9）4枚 %{souzu}"

msgid "- Four each of the 1 to 9 of characters %{manzu}"
msgstr "- 各萬子（1〜9）4枚 %{manzu}"

msgid "- Four each of the 1 to 9 of circles %{pinzu}"
msgstr "- 各筒子（1〜9）4枚 %{pinzu}"

msgid "- Four each of the 2 to 8 of bamboo %{souzu}"
msgstr "- 各索子（2〜8）4枚 %{souzu}"

msgid "- Four each of the 2 to 8 of characters %{manzu}"
msgstr "- 各萬子（2〜8）4枚 %{manzu}"

msgid "- Four each of the 2 to 8 of circles %{pinzu}"
msgstr "- 各筒子（2〜8）4枚 %{pinzu}"

msgid "- Four each of the four Winds (East, South, West, North) %{winds}"
msgstr "- 各風牌（東、南、西、北）4枚 %{winds}"

msgid "- Four each of the four winds (East, South, West, North) %{winds}"
msgstr "- 各風牌（東、南、西、北）4枚 %{winds}"

msgid "- Four each of the three Dragons (White, Green, Red) %{dragons}"
msgstr "- 各三元牌（白、發、中）4枚 %{dragons}"

msgid "- Four each of the three dragons (White, Green, Red) %{dragons}"
msgstr "- 各三元牌（白、發、中）4枚 %{dragons}"

msgid "- Four flowers %{flowers}"
msgstr "- 花牌4枚 %{flowers}"

msgid "- Four seasons %{seasons}"
msgstr "- 季節牌4枚 %{seasons}"

msgid "- Four sets (sequences or triplets) and a pair."
msgstr "- 4組の面子（順子または刻子）と1組の対子。"

msgid "- Green dragon: %{reversible_z}"
msgstr "- 發: %{reversible_z}"

msgid "- Have 7 flowers and rob the eighth someone declares, or draw it yourself."
msgstr "- 花牌を7枚持ち、他家が8枚目を宣言した場合に槍槓するか、自分で8枚目を引く。"

msgid "- Have all thirteen terminal/honor tiles plus one forming a pair."
msgstr "- 么九牌と字牌をすべて1枚ずつ持ち、そのうち1枚で対子を作る。"

msgid "- Having a single wait like 12₍₃₎, 1₍₂₎3, or 2₍₂₎ adds 2 fu. Only the final shape matters, so 1234 waiting for a pair of 1 or 4, counts as a single wait since it could be read as 1 234 or 123 4."
msgstr "- 辺張・嵌張・単騎などの単独待ち（例: 12₍₃₎、1₍₂₎3、2₍₂₎）は2符追加。最終的な形のみが重要なので、1234で1または4の対子を待つ場合は、1 234または123 4と解釈できるため、単騎待ちとして扱う。"

msgid "- Having a yakuhai pair adds 2 fu. A double wind pair (i.e. both round and seat wind) adds %{double_wind_fu} fu."
msgstr "- 役牌の対子は2符。ダブル風牌（場風と自風の両方）の対子は%{double_wind_fu}符。"

msgid "- Having all 4 flower tiles of the same set is instead worth %{four_flowers_value} %{four_flowers_han}."
msgstr "- 同じセットの花牌を4枚すべて持つ場合は、代わりに%{four_flowers_value} %{four_flowers_han}。"

msgid "- Having all eight flowers. (You have 7 flowers and win from calling the eighth someone declares, or by drawing it yourself.)"
msgstr "- 花牌を8枚すべて持つ。（7枚持っていて、他家が宣言した8枚目を槍槓するか、自分で引く。）"

msgid "- If a potential winner has 3+ calls in the same suit, and you discard a tile of that suit that is called by that same player, then you pay in full if the potential winner actually wins with Full Flush."
msgstr "- 和了候補者が同色の副露を3回以上しており、あなたがその色の牌を捨て、それがそのプレイヤーにポン・チーされた場合、その候補者が実際に清一色で和了したら、あなたが全額を支払う。"

msgid "- If a potential winner has 4+ visible Tai (from flowers/seasons/animals/honor triplets), and you discard a tile that helps the potential winner form an additional 1 Tai honor triplet, then you pay in full if the potential winner actually wins, even if by self-draw."
msgstr "- 和了候補者が花牌・季節牌・動物牌・字牌の刻子などで4つ以上のタイを公開しており、あなたがその候補者の追加の字牌刻子を完成させる牌を捨てた場合、その候補者が実際に和了したら、自摸和了でもあなたが全額を支払う。"

msgid "- If a potential winner has called 3+ honor triplets, and someone discards any of the non-called honor tiles which is then called, then you pay in full if the potential winner wins with All Honours."
msgstr "- 和了候補者が字牌の刻子を3つ以上副露しており、あなたが残りの字牌のいずれかを捨て、それがポン・チーされた場合、その候補者が字一色で和了したら、あなたが全額を支払う。"

msgid "- If a potential winner has called three wind triplets, and you discard a tile of the fourth wind which is then called, then you pay in full if the potential winner wins (as you have confirmed their Four Great Blessings)."
msgstr "- 和了候補者が風牌の刻子を3つ副露しており、あなたが4つ目の風牌を捨て、それがポンされた場合、その候補者が大四喜で和了したら、あなたが全額を支払う（大四喜を確定させたため）。"

msgid "- If a potential winner has called two dragon triplets, and you discard a tile of the third dragon which is then called, then you pay in full if the potential winner wins (as you have confirmed their Big Three Scholars)."
msgstr "- 和了候補者が三元牌の刻子を2つ副露しており、あなたが3つ目の三元牌を捨て、それがポンされた場合、その候補者が大三元で和了したら、あなたが全額を支払う（大三元を確定させたため）。"

msgid "- If the flipped tile is a 9, then the next tile is the 1 of the same suit."
msgstr "- めくられた牌が9の場合、次は同じ種類の1。"

msgid "- If the flipped tile is a dragon, it goes in the order %{dragons}."
msgstr "- めくられた牌が三元牌の場合、順序は%{dragons}。"

msgid "- If the flipped tile is a wind, it goes in the order %{winds}."
msgstr "- めくられた牌が風牌の場合、順序は%{winds}。"

msgid "- If the wall (not dead wall) has 5 or less tiles remaining and you discard a live (unseen by every player) tile that is then claimed to make a kong by another player, who subsequently wins on the kong replacement tile, then you pay the full amount. (It is scored as a self-draw, but the discarder pays for everyone."
msgstr "- 壁（嶺上牌を除く）に残り5枚以下があり、あなたが生牌（誰にも見えていない牌）を捨て、それを他家が槓して、その補充牌で和了した場合、あなたが全額を支払う。（自摸和了として計算されるが、捨てたプレイヤーが全員分を支払う。）"

msgid "- If you have a closed hand and won with tsumo (20+2 fu) but not scoring any more fu, it is treated as 20 fu (and awards you the 1 han yaku Pinfu)."
msgstr "- 門前でツモ和了し（20+2符）、他の符がない場合、20符として扱う（平和の1翻が付与される）。"

msgid "- Kans are the same but worth 4x that amount (so 8, 16, or 32 fu)."
msgstr "- 槓も同じだが、符は4倍になる（8、16、32符）。"

msgid "- Knitted Honors: 5 Faan for having at least one of each honor tile."
msgstr "- ニーデッド・オナーズ: 各字牌を最低1枚持つと5ファン。"

msgid "- Knitted Short Straight: 5 Faan for having something like 14 25 36."
msgstr "- ニーデッド・ショートストレート: 14 25 36のような形で5ファン。"

msgid "- Knitted Straight: 5 Faan for having 147 258 369."
msgstr "- ニーデッドストレート: 147 258 369で5ファン。"

msgid "- Knitted Terminal Sequences: 5 Faan for having 17 28 39."
msgstr "- ニーデッド・ターミナルシーケンス: 17 28 39で5ファン。"

msgid "- Knitted Triplets: 5 Faan for having something like 147 147 147."
msgstr "- ニーデッド・トリプレッツ: 147 147 147のような形で5ファン。"

msgid "- Kokushi musou (13 orphans) is 30 fu. (Fu does not matter for kokushi hands, but here we say it's 30 fu.)"
msgstr "- 国士無双（13孤）は30符。（国士の手では符は意味がないが、ここでは30符とする。）"

msgid "- One %{30j} joker is added to the wall. This joker acts as any five or any honor tile."
msgstr "- ジョーカー%{30j}が1枚追加される。このジョーカーは任意の5または任意の字牌として機能する。"

msgid "- One %{31j} joker is added to the wall. This joker acts as any honor tile, but can also be used as the middle tile in any sequence."
msgstr "- ジョーカー%{31j}が1枚追加される。このジョーカーは任意の字牌として機能し、任意の順子の中間牌としても使用できる。"

msgid "- Plus 8 to 32 Joker tiles %{jokers}"
msgstr "- ジョーカータイル8〜32枚 %{jokers}"

msgid "- Ron with a closed hand adds 10 fu."
msgstr "- 門前でのロン和了は10符追加。"

msgid "- Sequences are worth 0 fu."
msgstr "- 順子は0符。"

msgid "- Seven pairs (no repeated pairs)."
msgstr "- 七対子（対子の重複なし）。"

msgid "- Seven pairs (repeated pairs OK)."
msgstr "- 七対子（対子の重複ありでも可）。"

msgid "- Seven pairs (repeats OK) plus one triplet."
msgstr "- 七対子（重複あり）+1刻子。"

msgid "- Seven pairs (repeats OK)."
msgstr "- 七対子（重複あり）。"

msgid "- Start with 20 fu."
msgstr "- 基本符は20符。"

msgid "- Tsumo adds 2 fu."
msgstr "- ツモ和了で2符追加。"

msgid "- Vietnamese mahjong additionally includes 4 kings %{kings}, 4 queens %{queens}, and the flower joker %{hoa} as additional flower tiles."
msgstr "- ベトナム麻雀では、追加の花牌として王牌4枚 %{kings}、女王牌4枚 %{queens}、花牌ジョーカー %{hoa} が含まれる。"

msgid "- White dragon: %{reversible_z}"
msgstr "- 白: %{reversible_z}"

msgid "- You draw the winning tile."
msgstr "- 和了牌を自分で引く。"

msgid "- You have at least 2 fan from win patterns."
msgstr "- 和了パターンから最低2ファン。"

msgid "- You have four sets (sequences or triplets) and a pair."
msgstr "- 4組の面子（順子または刻子）と1組の対子。"

msgid "- You may Kong a discard if you have three of the same tile in hand, forming a quad. The discarder immediately pays you 1 point."
msgstr "- 手牌に同じ牌が3枚あり、捨て牌をポンして槓（明槓）にできる。捨てたプレイヤーは即座に1点を支払う。"

msgid "- You may Kong a tile by adding it to an existing Pung. All players immediately pay you 1 point."
msgstr "- 既存のポンに牌を加えて槓（加槓）にできる。全プレイヤーが即座に1点を支払う。"

msgid "- You may Kong four identical tiles in hand. All players immediately pay you 2 points. If the tile is a wildcard (Hun'er), all players instead immediately pay you 8 points."
msgstr "- 手牌に同じ牌が4枚ある場合、暗槓を宣言できる。全プレイヤーが即座に2点を支払う。その牌がワイルドカード（混児）の場合、全プレイヤーが即座に8点を支払う。"

msgid "- You may Pung a discard if you have two of the same tile in hand, forming a triplet."
msgstr "- 手牌に同じ牌が2枚あり、捨て牌をポンして刻子にできる。"

msgid "- You may not call a tile to complete a sequence."
msgstr "- 順子を完成させるためのチーはできない。"

msgid "-$amt"
msgstr "-$amt"

msgid "-$score"
msgstr "-$score"

msgid "-10"
msgstr "-10"

msgid "-100"
msgstr "-100"

msgid "-20"
msgstr "-20"

msgid "-50"
msgstr "-50"

msgid "...but also on the 4 of characters (for Mixed Straight 123 456 789, worth 8 Fan by itself)! Switching tracks like this is quite common in MCR, since there are so many Fan patterns."
msgstr "...しかし、萬子の4（三色順子123 456 789、これだけで8ファン）にも待つ！このように軌道を変えるのはMCRではよくある。ファンパターンが多いからだ。"

msgid "...or someone else can discard it!"
msgstr "...または、他家が捨てることもできる！"

msgid "/"
msgstr "/"

msgid "0 Faan"
msgstr "0ファン"

msgid "0 Fan"
msgstr "0ファン"

msgid "0 Fan → 1 pts"
msgstr "0ファン → 1点"

msgid "0 han ron"
msgstr "0翻ロン"

msgid "0.5 Han"
msgstr "0.5翻"

msgid "0.5 han is awarded for each mixed triplet of dragons."
msgstr "三元牌の混合刻子（ミニ三原）ごとに0.5翻。"

msgid "0.5 han is awarded for each mixed triplet of winds that contain both the round wind and the seat wind."
msgstr "場風と自風の両方を含む風牌の混合刻子ごとに0.5翻。"

msgid "1 Faan"
msgstr "1ファン"

msgid "1 Faan for each joker you declare as a flower."
msgstr "花として宣言したジョーカー1枚につき1ファン。"

msgid "1 Faan for having 123 456 or 456 789 of one suit. It is possible to get this one twice by having two short straights, which gives you a total of 2 faan."
msgstr "一色の123 456または456 789で1ファン。短い順子（ショートストレート）を2組持つと、これを2回獲得でき、合計2ファンになる。"

msgid "1 Faan for having 123 789 in the same suit."
msgstr "同色の123 789で1ファン。"

msgid "1 Faan for having an open kong. This could be a kong formed by calling a discard %{daiminkan}, or a kong formed by adding onto an existing pung %{kakan}."
msgstr "明槓で1ファン。これは、捨て牌をポンして作る槓 %{daiminkan}、または既存の刻子に加えて作る槓 %{kakan} のどちらか。"

msgid "1 Faan for having consecutive triplets in the pattern 111222. They do not have to be the same suit. If they are the same suit, it's still 1 Faan."
msgstr "111222のパターンの連続刻子で1ファン。同種である必要はない。同種の場合でも1ファン。"

msgid "1 Faan for having two of the same sequence in different suits. It is possible to get this one twice by also having two of a different-numbered sequence, which gives you a total of 2 faan."
msgstr "異なる種類の同じ順子を2組持つと1ファン。さらに別の数字の順子も2組持つと、これを2回獲得でき、合計2ファン。"

msgid "1 Faan if you win off the replacement tile after calling a joker as a flower."
msgstr "ジョーカーを花として宣言した後の補充牌で和了した場合、1ファン。"

msgid "1 Faan if your pair is 22, 55, or 88."
msgstr "対子が22、55、88の場合、1ファン。"

msgid "1 Fan"
msgstr "1ファン"

msgid "1 Fan → 2 pts"
msgstr "1ファン → 2点"

msgid "1 Han"
msgstr "1翻"

msgid "1 Han for winning after declaring riichi."
msgstr "立直を宣言して和了すると1翻。"

msgid "1 Mủn"
msgstr "1ムン"

msgid "1 Mủn if you win a discarded flower or joker."
msgstr "捨てられた花牌またはジョーカーで和了した場合、1ムン。"

msgid "1 Mủn if you win with a hand containing no jokers but also scores no other hand patterns besides Mosquito Hand."
msgstr "ジョーカーを含まない手で、モスキートハンド以外の役がない場合、1ムン。"

msgid "1 Phán"
msgstr "1ファン"

msgid "1 Phán if someone else uses a tile you're waiting for to bounce a joker"
msgstr "あなたが待っている牌を他家がジョーカーのバウンスに使用した場合、1ファン。"

msgid "1 Phán if you win (by self-draw) with a hand that relied on exactly one tile to complete. Because of jokers, this tends to be rarer than in other Mahjong variants."
msgstr "ちょうど1枚の牌で完成する手（単騎待ち）を自摸和了した場合、1ファン。ジョーカーのため、他の麻雀より稀。"

msgid "1 Tai"
msgstr "1タイ"

msgid "1 Tai for 4 sequences and a pair, where the pair is not a dragon or valued wind, and either the winning tile was self-drawn or the final wait was not a single wait. Not awarded if you have 4 open sequences. If you have no flowers/seasons/animals, instead score Big Ping Hu (4 Tai)."
msgstr "4順子と1対子で、対子が三元牌や役風牌ではなく、和了が自摸または最終待ちが単騎でない場合に1タイ。4つの明順子がある場合は与えられない。花牌・季節牌・動物牌がない場合は、代わりに大平和（4タイ）。"

msgid "1 Tai for a dragon triplet."
msgstr "三元牌の刻子で1タイ。"

msgid "1 Tai for a flower or season tile that matches the player's own seat."
msgstr "自分の席に対応する花牌または季節牌で1タイ。"

msgid "1 Tai for a round wind triplet/kong."
msgstr "場風の刻子/槓で1タイ。"

msgid "1 Tai for a seat wind triplet/kong."
msgstr "自風の刻子/槓で1タイ。"

msgid "1 Tai for a wind triplet, regardless of seat."
msgstr "風牌の刻子（席に関係なく）で1タイ。"

msgid "1 Tai for any dragon triplet or kong."
msgstr "三元牌の刻子/槓で1タイ。"

msgid "1 Tai for any dragon triplet/kong."
msgstr "三元牌の刻子/槓で1タイ。"

msgid "1 Tai for any wind triplet or kong that matches either the round wind or your seat wind."
msgstr "場風または自風に一致する風牌の刻子/槓で1タイ。"

msgid "1 Tai for claiming the tile another player tried to add onto an existing called triplet to turn into a kong."
msgstr "他家が既存の刻子に加えて槓にしようとした牌を槍槓（チャンカン）した場合、1タイ。"

msgid "1 Tai for drawing the winning tile yourself. This combines with Concealed Hand (1 Tai) to get Fully Concealed Hand (3 Tai)."
msgstr "自分で和了牌を引いた場合、1タイ。門前清（1タイ）と複合して門前清自摸和（3タイ）。"

msgid "1 Tai for each flower tile, regardless of the number printed on it."
msgstr "花牌1枚ごとに1タイ（数字は問わない）。"

msgid "1 Tai for each individual animal tile, regardless of seat."
msgstr "動物牌1枚ごとに1タイ（席は問わない）。"

msgid "1 Tai for having a non-concealed kong."
msgstr "明槓がある場合、1タイ。"

msgid "1 Tai for having no calls (even concealed kong) and winning by self-draw. Flower/season/animal tile do not count as calls."
msgstr "副露なし（暗槓も含む）で自摸和了した場合、1タイ。花牌・季節牌・動物牌の宣言は副露として数えない。"

msgid "1 Tai for having no calls (except concealed kongs). This combines with Self-Draw (1 Tai) to get Fully Concealed Hand (3 Tai)."
msgstr "副露なし（暗槓は除く）で1タイ。自摸（1タイ）と複合して門前清自摸和（3タイ）。"

msgid "1 Tai for having no flowers. This combines with No Honors (1 Tai) to get No Honors or Flowers (3 Tai)."
msgstr "花牌がない場合、1タイ。字牌なし（1タイ）と複合して字牌花牌なし（3タイ）。"

msgid "1 Tai for having two triplets (including concealed kongs) hidden in your winning hand."
msgstr "和了手に暗刻（暗槓を含む）が2組隠れている場合、1タイ。"

msgid "1 Tai for no honor tiles. This combines with No Flowers (1 Tai) to get No Honors or Flowers (3 Tai)."
msgstr "字牌がない場合、1タイ。花牌なし（1タイ）と複合して字牌花牌なし（3タイ）。"

msgid "1 Tai for the winning shape containing a Baida tile."
msgstr "和了形にバイダ牌が含まれる場合、1タイ。"

msgid "1 Tai for using a Baida tile as its original tile."
msgstr "バイダ牌を本来の牌として使用した場合、1タイ。"

msgid "1 Tai for winning after announcing Ting."
msgstr "聴牌（ティン）を宣言して和了した場合、1タイ。"

msgid "1 Tai for winning by drawing the winning tile yourself."
msgstr "自分で和了牌を引いて和了した場合、1タイ。"

msgid "1 Tai for winning on a pair wait (e.g. 3 waiting for 3)."
msgstr "単騎待ち（例: 3を待つ）で和了した場合、1タイ。"

msgid "1 Tai for winning on a pair wait by drawing a Baida tile."
msgstr "バイダ牌を引いて単騎待ちで和了した場合、1タイ。"

msgid "1 Tai for winning on an closed wait (e.g. 35 waiting for 4)."
msgstr "嵌張待ち（例: 35で4を待つ）で和了した場合、1タイ。"

msgid "1 Tai for winning on an edge wait (12 waiting for 3, or 89 waiting for 7)."
msgstr "辺張待ち（12で3を待つ、または89で7を待つ）で和了した場合、1タイ。"

msgid "1 Tai for winning on the last tile drawn from the live wall (so replacement tiles do not count)."
msgstr "壁の最後の牌（槓や花牌の補充牌は含まない）を自摸して和了した場合、1タイ。"

msgid "1 Tai for winning on the last tile drawn from the wall."
msgstr "壁の最後の牌を自摸して和了した場合、1タイ。"

msgid "1 Tai for winning on the replacement tile after declaring a flower or kong."
msgstr "花牌または槓を宣言した後の補充牌で和了した場合、1タイ。"

msgid "1 Tai for winning on the replacement tile after declaring a kong (not flower)."
msgstr "槓（花牌ではない）を宣言した後の補充牌で和了した場合、1タイ。"

msgid "1 Tai for winning on the tile someone wanted to add to a pung."
msgstr "他家が刻子に加えようとした牌で和了した場合、1タイ。"

msgid "1 Tai for winning without any Baida tiles."
msgstr "バイダ牌なしで和了した場合、1タイ。"

msgid "1 Tai if you are the dealer. As the dealer you pay an additional 1 Tai if you lose (by discarding someone's winning tile or if someone else self-draws their tile). This bonus/penalty increases by 2 Tai for every consecutive dealer continuation."
msgstr "親の場合、1タイ。親は負けた場合（他家の和了牌を捨てた場合、または他家が自摸和了した場合）、追加で1タイを支払う。このボーナス/ペナルティは、連荘するたびに2タイずつ増加する。"

msgid "1 han for each of the following triplets in your hand:"
msgstr "以下の各刻子につき1翻:"

msgid "1 han for winning off the tile that upgrades a wind kontsu to a fuun."
msgstr "風牌の混合刻子（コンツ）を風圏（フーン）にアップグレードする牌で和了した場合、1翻。"

msgid "1 han if each of the 5 blocks in your hand contains a terminal or honor. 2 han if closed."
msgstr "手牌の5つのブロックのそれぞれに么九牌または字牌が含まれる場合、1翻。門前なら2翻。"

msgid "1 han if you win off the tile discarded by a player who just called fuun."
msgstr "風圏（フーン）を宣言した直後のプレイヤーが捨てた牌で和了した場合、1翻。"

msgid "1 han if you win with seven pairs with a repeated pair. 2 han for two repeated pairs, yakuman for three."
msgstr "七対子で1組重複した対子がある場合、1翻。2組重複で2翻、3組重複で役満。"

msgid "1 han if your closed hand contains two copies of the exact same kontsu."
msgstr "門前で同じ混合刻子（コンツ）を2組持つ場合、1翻。"

msgid "1 han if your hand consists of four kontsu and a pair. 2 han if closed."
msgstr "手牌が4組の混合刻子（コンツ）と1対子で構成される場合、1翻。門前なら2翻。"

msgid "1 han if your hand contains the same number sequence in all three suits. 2 han if closed."
msgstr "手牌に同じ数字の順子が3種類全てに含まれる場合、1翻。門前なら2翻。"

msgid "1 han if your hand contains the sequences 123 456 789 in one suit."
msgstr "手牌に同種で123 456 789の順子が含まれる場合、1翻。"

msgid "1 han if your hand contains the sequences 123 456 789 in one suit. 2 han if closed."
msgstr "手牌に同種で123 456 789の順子が含まれる場合、1翻。門前なら2翻。"

msgid "1 han if your hand has three closed kontsu (mixed triplets). A kontsu (mixed triplet) formed by a self-draw win counts as closed."
msgstr "手牌に暗刻の混合刻子（コンツ）が3組ある場合、1翻。自摸和了で完成した混合刻子は暗刻として扱う。"

msgid "1 han if your hand has three closed triplets. A triplet formed by a self-draw win counts as closed."
msgstr "手牌に暗刻が3組ある場合、1翻。自摸和了で完成した刻子は暗刻として扱う。"

msgid "1 han if your hand is all triplets."
msgstr "手牌がすべて刻子の場合、1翻。"

msgid "1 han if your hand is comprised of one suit plus honor tiles."
msgstr "手牌が一色と字牌のみで構成される場合、1翻。"

msgid "1 han on top of yakuhai if you have two dragon triplets/kans and a dragon pair."
msgstr "役牌に加えて、三元牌の刻子/槓を2組と三元牌の対子を持つ場合、+1翻。"

msgid "1 han ron"
msgstr "1翻ロン"

msgid "1 han tsumo"
msgstr "1翻ツモ"

msgid "1 mủn if you collect any 10 flowers, on top of points normally granted by flowers."
msgstr "花牌を10枚集めた場合、通常の花牌の点に加えて1ムン。"

msgid "1 mủn if you collect any 8 flowers, on top of points normally granted by flowers."
msgstr "花牌を8枚集めた場合、通常の花牌の点に加えて1ムン。"

msgid "1 mủn on your 6th win in a row, plus 1 mủn for each additional win."
msgstr "6連勝目で1ムン、それ以降の連勝ごとに+1ムン。"

msgid "1 phán if someone else uses a tile you're waiting for to bounce a joker."
msgstr "あなたが待っている牌を他家がジョーカーのバウンスに使用した場合、1ファン。"

msgid "1 phán if your winning hand has two pairs waiting for either one to become a triplet."
msgstr "和了手に、どちらかが刻子になるのを待つ対子が2組ある場合、1ファン。"

msgid "1 嘴"
msgstr "1嘴"

msgid "1 嘴 for each concealed triplet in hand. A triplet completed by a self-draw win counts as concealed."
msgstr "手牌の各暗刻につき1嘴。自摸和了で完成した刻子は暗刻として扱う。"

msgid "1 嘴 for each tile in your 8+ tile suit past 8 tiles."
msgstr "8枚以上の一色の手牌で、8枚を超える各牌につき1嘴。"

msgid "1 嘴 for winning on one specific tile."
msgstr "特定の1牌でのみ和了した場合、1嘴。"

msgid "1 嘴 if you have 4+ tiles of a single number (ignore suit). This awards 1 嘴 for each such tile, starting from the fourth. At 10+ tiles, award Ten Identical Tiles (100 嘴) instead."
msgstr "同じ数字の牌（種類は問わない）を4枚以上持っている場合、4枚目から各1嘴。10枚以上なら、代わりに「十同一」（100嘴）。"

msgid "1-2 Faan"
msgstr "1-2ファン"

msgid "10"
msgstr "10"

msgid "10 Faan"
msgstr "10ファン"

msgid "10 Faan for having 123 456 or 456 789 of one suit and the same 123 456 or 456 789 of another suit."
msgstr "一色の123 456（または456 789）と、別の一色の同じ123 456（または456 789）で10ファン。"

msgid "10 Faan for having 123 789 in the same suit, for two different suits."
msgstr "異なる2種類で、それぞれ同色の123 789を持っている場合、10ファン。"

msgid "10 Faan for having a hand consisting of only two different numbers (of any suit)."
msgstr "手牌が任意の種類の2つの数字のみで構成される場合、10ファン。"

msgid "10 Faan for having consecutive triplets in the pattern 111222333444, except one of them is actually a pair. Their suits have to cycle: e.g. if it starts with characters, circles, bamboo, the last suit must be characters again."
msgstr "111222333444のパターンで、そのうち1つが実際には対子である連続刻子。種類は循環する必要がある: 例えば萬子、筒子、索子と始まった場合、最後は萬子でなければならない。"

msgid "10 Faan for having something like 11 22 33 44 55 in one suit in a seven-pair hand."
msgstr "七対子の手で、一色の11 22 33 44 55のような形で10ファン。"

msgid "10 Faan for having something like 123 234 345 in the same suit. This forms a 'pyramid' shape, like 233444556."
msgstr "同色の123 234 345のような形で10ファン。これは「ピラミッド」型（例: 233444556）を形成する。"

msgid "10 Faan if four of your pairs in a seven-pair hand are are wind pairs."
msgstr "七対子の手で、4つの対子が風牌の対子の場合、10ファン。"

msgid "10 Fan"
msgstr "10ファン"

msgid "10 Tai"
msgstr "10タイ"

msgid "10 Tai for announcing Ting on the initial draw."
msgstr "最初のツモで聴牌（ティン）を宣言した場合、10タイ。"

msgid "10 Tai for having 5 open calls, so you have one tile in hand waiting for a pair. It doesn't matter if it wins off a discard or self-draw."
msgstr "副露を4回し、手牌に1枚残して対子を待つ場合、10タイ。ロン和了か自摸和了かは問わない。"

msgid "10 Tai for having 5 sequences and a pair. In addition, it must have No Honors or Flowers."
msgstr "5順子と1対子で、字牌と花牌がない場合、10タイ。"

msgid "10 Tai for having 5 triplets and a pair."
msgstr "5刻子と1対子で10タイ。"

msgid "10 Tai for having all four wind triplets."
msgstr "4種類の風牌の刻子で10タイ。"

msgid "10 Tai for having all three dragon triplets."
msgstr "3種類の三元牌の刻子で10タイ。"

msgid "10 Tai for having four triplets (including concealed kongs) hidden in your winning hand."
msgstr "和了手に暗刻（暗槓を含む）が4組隠れている場合、10タイ。"

msgid "10 Tai for having only one suit in hand, plus honor tiles."
msgstr "手牌が一色と字牌のみの場合、10タイ。"

msgid "10 Tai for having seven flowers and winning by someone else calling an eighth or drawing the eighth yourself."
msgstr "花牌を7枚持ち、他家が8枚目を宣言するか自分で8枚目を引いて和了した場合、10タイ。"

msgid "10 Tai for having the sequences 123 456 789 in one suit in a concealed hand."
msgstr "門前で同色の123 456 789の順子がある場合、10タイ。"

msgid "10 Tai for having three wind triplets."
msgstr "3種類の風牌の刻子で10タイ。"

msgid "10 Tai for having two dragon triplets and a pair of the third."
msgstr "2種類の三元牌の刻子と、残りの三元牌の対子で10タイ。"

msgid "10 Tai for winning immediately with your initial hand and drawn tile."
msgstr "配牌と最初のツモで即座に和了した場合、10タイ。"

msgid "10 Tai for winning immediately with your initial hand and the dealer's first discard."
msgstr "配牌と親の最初の捨て牌で即座に和了した場合、10タイ。"

msgid "10 Tai for winning when there are at most 5 discards on the table. Tiles claimed by calls do not count towards this total."
msgstr "場に捨て牌が5枚以下の時点で和了した場合、10タイ。副露で取られた牌はこの数に含まれない。"

msgid "10 嘴 for winning with seven pairs."
msgstr "七対子で和了すると10嘴。"

msgid "100 嘴 for having for having only one suit in hand, with no honor tiles."
msgstr "字牌なしで一色のみの手牌で100嘴。"

msgid "100 嘴 for having four triplets hidden in your winning hand."
msgstr "和了手に暗刻が4組隠れている場合、100嘴。"

msgid "100 嘴 for having ten tiles of the same number."
msgstr "同じ数字の牌を10枚持っている場合、100嘴。"

msgid "100 嘴 for having three triplets that are in consecutive order (222 333 444)."
msgstr "連続する3つの刻子（222 333 444）で100嘴。"

msgid "100 嘴 for having two of the exact same sequence hidden in hand twice."
msgstr "手牌に同じ順子を2組隠している場合、100嘴。"

msgid "100 嘴 for winning with seven pairs, but two of your pairs are duplicated (you have two 4 of a kinds)."
msgstr "七対子で、2組の対子が重複している（つまり4枚組が2つある）場合、100嘴。"

msgid "11 Fan"
msgstr "11ファン"

msgid "11-13 Faan"
msgstr "11-13ファン"

msgid "12"
msgstr "12"

msgid "12 Fan"
msgstr "12ファン"

msgid "12 Tile Pao"
msgstr "12牌包"

msgid "123"
msgstr "123"

msgid "13 Fan"
msgstr "13ファン"

msgid "13 Phán"
msgstr "13ファン"

msgid "13+ Fan"
msgstr "13+ファン"

msgid "13+ han is worth sanbaiman, not yakuman."
msgstr "13翻以上は三倍満であり、役満ではない。"

msgid "14-16 Faan"
msgstr "14-16ファン"

msgid "147"
msgstr "147"

msgid "15"
msgstr "15"

msgid "15 Faan"
msgstr "15ファン"

msgid "15 Faan for having consecutive triplets in the pattern 111222333444 all in the same suit, except one of them is actually a pair."
msgstr "同種の111222333444のパターンで、そのうち1つが実際には対子である連続刻子で15ファン。"

msgid "15 Faan for having consecutive triplets in the pattern 111222333444. Their suits have to cycle: e.g. if it starts with characters, circles, bamboo, the last suit must be characters again."
msgstr "111222333444のパターンの連続刻子で15ファン。種類は循環する必要がある: 例えば萬子、筒子、索子と始まった場合、最後は萬子でなければならない。"

msgid "15 Faan for having none of the other scoring patterns."
msgstr "他の得点パターンがない場合、15ファン。"

msgid "15 Faan for having two of the exact same sequence in one suit, and two of another exact same sequence in the same suit."
msgstr "同種で同じ順子を2組と、同じく同種で別の同じ順子を2組持っている場合、15ファン。"

msgid "15 Faan if four of your sets in hand (not calls) all overlap, using up all four of a given tile. Does not stack with Tile Hog (5 Faan) or Tile Hog (2 Faan)."
msgstr "手牌（副露は含まない）の4つの面子がすべて重なり合い、特定の牌を4枚すべて使用している場合、15ファン。タイルホッグ（5ファン）やタイルホッグ（2ファン）とは複合しない。"

msgid "15 嘴 for winning using one of the last 4 tiles drawn from the wall."
msgstr "壁から引かれた最後の4枚のうちの1枚で和了した場合、15嘴。"

msgid "150 嘴 for winning immediately with your initial hand and drawn tile, as a non-dealer."
msgstr "子として配牌と最初のツモで即座に和了した場合、150嘴。"

msgid "16 Fan"
msgstr "16ファン"

msgid "16-tile mahjong with a version of dora that doesn't give you han, but becomes a unique winning condition by itself."
msgstr "16枚麻雀で、ドラが翻を与えず、それ自体が特別な和了条件になるバージョン。"

msgid "16-tile mahjong with riichi mechanics."
msgstr "立直の仕組みを持つ16枚麻雀。"

msgid "17-19 Faan"
msgstr "17-19ファン"

msgid "19"
msgstr "19"

msgid "2"
msgstr "2"

msgid "2 Faan"
msgstr "2ファン"

msgid "2 Faan for having a concealed kong %{ankan}, a kong declared with four identical tiles in your hand."
msgstr "暗槓%{ankan}（手牌の4枚組を宣言する槓）で2ファン。"

msgid "2 Faan for having something like 11 22 33 in one suit in a seven-pair hand."
msgstr "七対子の手で、一色の11 22 33のような形で2ファン。"

msgid "2 Faan for having something like 123 234 345, with each sequence being in a different suit."
msgstr "123 234 345のような形で、各順子が異なる種類の場合、2ファン。"

msgid "2 Faan for having something like 123 345 567, all of different suits."
msgstr "123 345 567のような形で、すべて異なる種類の場合、2ファン。"

msgid "2 Faan for not having any honors or declared jokers."
msgstr "字牌と宣言されたジョーカーがない場合、2ファン。"

msgid "2 Faan for not having jokers in hand. Jokers declared as flowers do not count as jokers."
msgstr "手牌にジョーカーがない場合、2ファン。花として宣言されたジョーカーはジョーカーとして数えない。"

msgid "2 Faan if two of your sets in hand (not calls) overlap and use up all four of a given tile."
msgstr "手牌（副露は含まない）の2つの面子が重なり合い、特定の牌を4枚すべて使用している場合、2ファン。"

msgid "2 Faan if you have four calls and won by self-draw."
msgstr "4回副露し、自摸和了した場合、2ファン。"

msgid "2 Faan if you win off the last draw or last discard."
msgstr "最後のツモまたは最後の捨て牌で和了した場合、2ファン。"

msgid "2 Faan if you win with a hell wait. A hell wait is defined as a final wait in which all tiles except one are already visible to you, so there is only one remaining left in the wall (or in others' hands)."
msgstr "地獄待ちで和了した場合、2ファン。地獄待ちとは、最終待ちで自分の見えている牌を除いて残りが1枚しかない状態を指す（壁または他家の手にある）。"

msgid "2 Faan if your hand contains the same number triplet in two suits."
msgstr "手牌に同じ数字の刻子が2種類に含まれる場合、2ファン。"

msgid "2 Fan"
msgstr "2ファン"

msgid "2 Fan → 4 pts"
msgstr "2ファン → 4点"

msgid "2 Han"
msgstr "2翻"

msgid "2 Tai"
msgstr "2タイ"

msgid "2 Tai for having 4 triplets and a pair."
msgstr "4刻子と1対子で2タイ。"

msgid "2 Tai for having a concealed kong."
msgstr "暗槓で2タイ。"

msgid "2 Tai for having all 4 flowers, or all 4 seasons. Stacks with the 1 Tai bonus for having a matching seat. Animal tiles don't award this."
msgstr "花牌4枚、または季節牌4枚で2タイ。席に対応する1タイのボーナスとは複合する。動物牌ではこれは与えられない。"

msgid "2 Tai for having only one suit in hand, plus honor tiles."
msgstr "手牌が一色と字牌のみの場合、2タイ。"

msgid "2 Tai for having your final wait be on a closed wait, like 35 waiting on 4."
msgstr "最終待ちが嵌張待ち（例: 35で4を待つ）の場合、2タイ。"

msgid "2 Tai for having your final wait be on only one tile, forming a pair."
msgstr "最終待ちが単騎待ち（1種の牌で対子を形成）の場合、2タイ。"

msgid "2 fan if your final wait completes a pair with the wildcard (Hun'er)."
msgstr "最終待ちがワイルドカード（混児）で対子を完成させる場合、2翻。"

msgid "2 fan if your final wait consists of a pair of wildcards (Hun'er)."
msgstr "最終待ちがワイルドカード（混児）の対子の場合、2翻。"

msgid "2 fan if your winning hand contains no wildcards (Hun'er)."
msgstr "和了手にワイルドカード（混児）が含まれない場合、2翻。"

msgid "2 han dealer tsumo"
msgstr "2翻親ツモ"

msgid "2 han if each of the 5 blocks in your hand contains a terminal. 3 han if closed."
msgstr "手牌の5つのブロックのそれぞれに么九牌が含まれる場合、2翻。門前なら3翻。"

msgid "2 han if each of your four sets is of a different kind: sequence, triplet, mixed triplet (kontsu), kan, mixed quad (fuun)."
msgstr "4つの面子がそれぞれ異なる種類（順子、刻子、混合刻子（コンツ）、槓、混合槓（フーン））の場合、2翻。"

msgid "2 han if your hand contains only terminal and honor tiles."
msgstr "手牌が么九牌と字牌のみの場合、2翻。"

msgid "2 han if your hand contains the same number triplet in all three suits."
msgstr "手牌に同じ数字の刻子が3種類全てに含まれる場合、2翻。"

msgid "2 han if your hand contains three copies of the exact same kontsu. 3 han if closed."
msgstr "手牌に同じ混合刻子（コンツ）を3組持つ場合、2翻。門前なら3翻。"

msgid "2 han if your hand has three closed triplets. A triplet formed by a self-draw win counts as closed."
msgstr "手牌に暗刻が3組ある場合、2翻。自摸和了で完成した刻子は暗刻として扱う。"

msgid "2 han if your hand is all triplets."
msgstr "手牌がすべて刻子の場合、2翻。"

msgid "2 han if your hand is comprised of one suit plus honor tiles."
msgstr "手牌が一色と字牌のみで構成される場合、2翻。"

msgid "2 han if your hand is comprised of one suit plus honor tiles. 3 han if closed."
msgstr "手牌が一色と字牌のみで構成される場合、2翻。門前なら3翻。"

msgid "2 han on top of yakuhai if you have two dragon triplets/kans and a dragon pair."
msgstr "役牌に加えて、三元牌の刻子/槓を2組と三元牌の対子を持つ場合、+2翻。"

msgid "2 han ron"
msgstr "2翻ロン"

msgid "2 han tsumo"
msgstr "2翻ツモ"

msgid "2 嘴"
msgstr "2嘴"

msgid "2 嘴 for having two of the exact same sequence. If these sequences are hidden in hand, instead score Concealed Double Sequences (4 嘴)."
msgstr "同じ順子を2組持つと2嘴。これらの順子が手牌に隠されている場合、代わりに「暗刻一盃口」（4嘴）。"

msgid "2 嘴 for omitting one whole suit from your hand."
msgstr "手牌から一色全体を欠いた場合、2嘴。"

msgid "20"
msgstr "20"

msgid "20 Faan"
msgstr "20ファン"

msgid "20 Faan for having 123 123 456 456 or 456 456 789 789 of one suit."
msgstr "一色の123 123 456 456、または456 456 789 789で20ファン。"

msgid "20 Faan for having 123 123 789 789 in the same suit."
msgstr "同色の123 123 789 789で20ファン。"

msgid "20 Faan for having 123 345 567 789 in the same suit."
msgstr "同色の123 345 567 789で20ファン。"

msgid "20 Faan for having a pair of red dragons, plus a pure straight (123456789) of any suit, plus either a triplet of threes or a kong of fours."
msgstr "中の対子、任意の種類の一気通貫（123456789）、そして3の刻子または4の槓のいずれかで20ファン。"

msgid "20 Faan for having an open hand that contains 1112345678999 plus another number tile all in the same suit."
msgstr "副露した手で、同色の1112345678999に同種の数牌をもう1枚加えた形で20ファン。"

msgid "20 Faan for having both Three Pure Shifted Sequences and Three Pure Linked Sequences simulaneously."
msgstr "一色三順と一色三步高を同時に持つ場合、20ファン。"

msgid "20 Faan for having consecutive triplets in the pattern 111222333444555, except one of them is actually a pair. Their suits have to cycle: e.g. if it starts with characters, circles, bamboo, the next suit must be characters again, and the following suit must be circles again."
msgstr "111222333444555のパターンで、そのうち1つが実際には対子である連続刻子。種類は循環する必要がある: 例えば萬子、筒子、索子と始まった場合、次は萬子、その次は筒子でなければならない。"

msgid "20 Tai"
msgstr "20タイ"

msgid "20 Tai for having seven flowers and winning off of someone declaring an eighth."
msgstr "花牌を7枚持ち、他家が8枚目を宣言したのを槍槓して和了した場合、20タイ。"

msgid "20+2+8+2+8+4+2 is 46, so 50 fu."
msgstr "20+2+8+2+8+4+2は46なので、50符。"

msgid "20-24 Faan"
msgstr "20-24ファン"

msgid "200 嘴 for winning immediately with your initial hand as dealer."
msgstr "親として配牌で即座に和了した場合、200嘴。"

msgid "24+ Fan"
msgstr "24+ファン"

msgid "25-29 Faan"
msgstr "25-29ファン"

msgid "258"
msgstr "258"

msgid "3 Fan"
msgstr "3ファン"

msgid "3 Han"
msgstr "3翻"

msgid "3 Mủn"
msgstr "3ムン"

msgid "3 Phán"
msgstr "3ファン"

msgid "3 Phán if you win on a discarded tile with four called groups, leaving a single tile in your hand waiting to complete a pair. +1 Phán if no jokers."
msgstr "4回副露して、手牌に1枚残して対子を待ち、捨て牌で和了した場合、3ファン。ジョーカーがない場合+1ファン。"

msgid "3 Tai"
msgstr "3タイ"

msgid "3 Tai for having 5 sequences and a pair. If the hand also has No Honors or Flowers, this becomes All Sequences (Full) (10 Tai)."
msgstr "5順子と1対子で3タイ。さらに字牌と花牌がない場合は、全順子（完全）（10タイ）になる。"

msgid "3 Tai for having no honor tiles or flower tiles."
msgstr "字牌と花牌がない場合、3タイ。"

msgid "3 Tai for having two dragon triplets and a pair of the third. Does not stack with the 1 Tai from individual dragon triplets."
msgstr "2種類の三元牌の刻子と、残りの三元牌の対子で3タイ。個々の三元牌の刻子による1タイとは複合しない。"

msgid "3 Tai for winning by self-draw without calling any tiles besides concealed kong."
msgstr "暗槓以外の副露なしで自摸和了した場合、3タイ。"

msgid "3 fan if your final wait is exactly %{kanchan} and you won by drawing %{five}. Wildcards can be used for any part of this."
msgstr "最終待ちがちょうど%{kanchan}で、%{five}を自摸で和了した場合、3翻。ワイルドカードはこの一部として使用できる。"

msgid "3 han 60 fu and 4 han 30 fu are worth mangan."
msgstr "3翻60符と4翻30符は満貫。"

msgid "3 han dealer tsumo"
msgstr "3翻親ツモ"

msgid "3 han if you have two double sequences, each being two copies of the exact same sequence in one suit, like 123 123. Does not count as chiitoitsu (7 pairs)."
msgstr "同じ順子を同種で2組ずつ、合計4組持つ場合、3翻（例: 123 123）。七対子（チートイツ）とは数えない。"

msgid "3 han if your hand has three closed kontsu (mixed triplets) in hand, and you won by self-drawing the fourth."
msgstr "手牌に暗刻の混合刻子（コンツ）が3組あり、4つ目を自摸で和了した場合、3翻。"

msgid "3 han if your hand is comprised of one suit only (no honor tiles)."
msgstr "手牌が一色のみ（字牌なし）の場合、3翻。"

msgid "3 han ron"
msgstr "3翻ロン"

msgid "3 han tsumo"
msgstr "3翻ツモ"

msgid "3+ Fan → 8 pts"
msgstr "3+ファン → 8点"

msgid "3+ Han"
msgstr "3+翻"

msgid "3-4 Faan"
msgstr "3-4ファン"

msgid "30"
msgstr "30"

msgid "30 Faan"
msgstr "30ファン"

msgid "30 Faan for having four triplets of the same number. This requires some joker tomfoolery, since it must include 6 of the same tile in one of the three suits."
msgstr "同じ数字の刻子を4組持つ場合、30ファン。3種類のうち1種類で同じ牌を6枚含む必要があるため、ジョーカーのトリックが必要。"

msgid "30 Faan for having something like 11 22 33 44 55 66 77 in one suit in a seven-pair hand."
msgstr "七対子の手で、一色の11 22 33 44 55 66 77のような形で30ファン。"

msgid "30 Faan for having something like 123 234 345 456 in the same suit."
msgstr "同色の123 234 345 456のような形で30ファン。"

msgid "30 Faan if your hand (not calls) use up all twelve of three different tiles. Without jokers, you can only get this via the shape 111 123 33 345 555."
msgstr "手牌（副露は含まない）が3種類の異なる牌をそれぞれ4枚すべて使用している場合、30ファン。ジョーカーなしでは、111 123 33 345 555の形でのみ達成可能。"

msgid "30 Fu"
msgstr "30符"

msgid "30 Tai"
msgstr "30タイ"

msgid "30 Tai for having seven flowers and drawing the eighth yourself."
msgstr "花牌を7枚持ち、自分で8枚目を引いて和了した場合、30タイ。"

msgid "30 Tai for having seven pairs plus one triplet."
msgstr "七対子に1刻子を加えた形で30タイ。"

msgid "30 Tai for having three wind triplets and a pair of the fourth."
msgstr "3種類の風牌の刻子と、残りの風牌の対子で30タイ。"

msgid "30 Tai for having triplets of all three dragons."
msgstr "3種類の三元牌の刻子で30タイ。"

msgid "30-39 Faan"
msgstr "30-39ファン"

msgid "369"
msgstr "369"

msgid "37"
msgstr "37"

msgid "4 Fan"
msgstr "4ファン"

msgid "4 Han"
msgstr "4翻"

msgid "4 Mủn"
msgstr "4ムン"

msgid "4 Tai"
msgstr "4タイ"

msgid "4 Tai for 4 sequences and a pair, where the pair is not a dragon or valued wind, and either the winning tile was self-drawn or the final wait was not a single wait. Also, you have no flowers/seasons/animals. Not awarded if you have 4 open sequences."
msgstr "4順子と1対子で、対子が三元牌や役風牌ではなく、和了が自摸または最終待ちが単騎でなく、さらに花牌・季節牌・動物牌がない場合、4タイ。4つの明順子がある場合は与えられない。"

msgid "4 Tai for having only one suit in hand, with no honor tiles."
msgstr "字牌なしで一色のみの手牌で4タイ。"

msgid "4 Tai for having only one suit in hand."
msgstr "一色のみの手牌で4タイ。"

msgid "4 Tai for having only terminal tiles (1s and 9s) and honor tiles. Does not stack with the 1 Tai from individual dragon triplets or valued wind triplets."
msgstr "么九牌と字牌のみの手牌で4タイ。個々の三元牌の刻子や役風牌の刻子による1タイとは複合しない。"

msgid "4 Tai for three wind triplets plus a pair of the fourth wind. Does not stack with the 1 Tai from valued wind pungs, Half Flush, or Full Flush."
msgstr "3種類の風牌の刻子と、残りの風牌の対子で4タイ。役風牌の刻子による1タイ、混一色、清一色とは複合しない。"

msgid "4 fan if your winning hand contains the sequences 123 456 789 of any suit."
msgstr "和了手に任意の種類で123 456 789の順子が含まれる場合、4翻。"

msgid "4 嘴"
msgstr "4嘴"

msgid "4 嘴 for each concealed kong."
msgstr "各暗槓につき4嘴。"

msgid "4 嘴 for having all four of a tile in hand or calls (not declared as a kong)"
msgstr "手牌または副露で特定の牌を4枚すべて持っている場合（槓として宣言していない）、4嘴。"

msgid "4 嘴 for having two of the exact same sequence hidden in hand."
msgstr "手牌に同じ順子を2組隠している場合、4嘴。"

msgid "40"
msgstr "40"

msgid "40 Fu"
msgstr "40符"

msgid "40 Tai"
msgstr "40タイ"

msgid "40 Tai for having five triplets (hidden including concealed kongs) hidden in your winning hand."
msgstr "和了手に5組の刻子（暗槓を含む）が隠れている場合、40タイ。"

msgid "40 Tai for having only one suit in hand, with no honor tiles."
msgstr "字牌なしで一色のみの手牌で40タイ。"

msgid "40 Tai for having triplets of all four winds."
msgstr "4種類の風牌の刻子で40タイ。"

msgid "40 Tai for winning immediately with your initial hand and drawn tile."
msgstr "配牌と最初のツモで即座に和了した場合、40タイ。"

msgid "40 Tai for winning immediately with your initial hand and the dealer's first discard."
msgstr "配牌と親の最初の捨て牌で即座に和了した場合、40タイ。"

msgid "40+ Faan"
msgstr "40+ファン"

msgid "456"
msgstr "456"

msgid "46"
msgstr "46"

msgid "5 Faan"
msgstr "5ファン"

msgid "5 Faan for a hand that contains only number tiles numbered 13579."
msgstr "数字が13579のみの数牌で構成される手で5ファン。"

msgid "5 Faan for a hand that contains only number tiles numbered 2468."
msgstr "数字が2468のみの数牌で構成される手で5ファン。"

msgid "5 Faan for having 123 456 789, all of different suits."
msgstr "123 456 789がすべて異なる種類の場合、5ファン。"

msgid "5 Faan for having a hand consisting of 147 only, 258 only, or 369 only. Stacks with Three Number Hand (5 Faan)."
msgstr "手牌が147のみ、258のみ、または369のみで構成される場合、5ファン。三色同数（5ファン）と複合する。"

msgid "5 Faan for having a hand consisting of only three different numbers (of any suit)."
msgstr "手牌が任意の種類の3つの数字のみで構成される場合、5ファン。"

msgid "5 Faan for having consecutive triplets in the pattern 111222333, except one of them is actually a pair. The three can be of any suit. They do not have to be the same suit. If they are all the same suit, it's still 5 Faan."
msgstr "111222333のパターンで、そのうち1つが実際には対子である連続刻子。3つは任意の種類でよい。同種である必要はない。すべて同種の場合でも5ファン。"

msgid "5 Faan for having consecutive triplets in the pattern 111222333, except one of them is actually a pair. They must all be of different suits."
msgstr "111222333のパターンで、そのうち1つが実際には対子である連続刻子。3つはすべて異なる種類でなければならない。"

msgid "5 Faan for having the same number pair in three suits in a seven-pair hand."
msgstr "七対子の手で、同じ数字の対子を3種類で持つ場合、5ファン。"

msgid "5 Faan if all of your tiles are not connected, i.e. they are 3 away from each other or more. You also have a pair of one of the tiles. In addition, the suited tiles among them must form a partial Knitted Triplets (147 147 147) or a partial Knitted Straight (147 258 369); and you must have at least one tile of each suit, at least one wind, and at least one dragon. Does not stack with All Types."
msgstr "すべての牌が互いに3以上離れており、1組の対子がある場合、5ファン。さらに、数牌の中には部分的ニーデッド三暗刻（147 147 147）または部分的ニーデッド一気通貫（147 258 369）を形成する必要があり、各種類の数牌を最低1枚、風牌を最低1枚、三元牌を最低1枚持つ必要がある。全種類とは複合しない。"

msgid "5 Faan if three of your pairs in a seven-pair hand are are dragon pairs."
msgstr "七対子の手で、3つの対子が三元牌の対子の場合、5ファン。"

msgid "5 Faan if two of your sets in hand (not calls) overlap your pair, using up all four of a given tile. Does not stack with Tile Hog (2 Faan)."
msgstr "手牌（副露は含まない）の2つの面子が対子と重なり合い、特定の牌を4枚すべて使用している場合、5ファン。タイルホッグ（2ファン）とは複合しない。"

msgid "5 Faan if you have four calls and won on someone's discard (or by robbing a kong)."
msgstr "4回副露し、他家の捨て牌（または槍槓）で和了した場合、5ファン。"

msgid "5 Faan if you win before the eleventh tile is drawn."
msgstr "11枚目の牌が引かれる前に和了した場合、5ファン。"

msgid "5 Fan"
msgstr "5ファン"

msgid "5 Han"
msgstr "5翻"

msgid "5 Tai"
msgstr "5タイ"

msgid "5 Tai for declaring all 4 animal tiles (cat, mouse, chicken, centipede)."
msgstr "動物牌4枚（猫、鼠、鶏、蜈蚣）をすべて宣言した場合、5タイ。"

msgid "5 Tai for having all thirteen terminal/honor tiles plus one forming a pair. Always scored as self-drawn (so everyone pays), even when winning off a discard."
msgstr "么九牌と字牌をすべて1枚ずつ持ち、そのうち1枚で対子を作る場合、5タイ。ロン和了であっても常に自摸和了として計算される（全員が支払う）。"

msgid "5 Tai for having four triplets (including concealed kongs) hidden in your winning hand. Must be won by self-draw, even if you're waiting on the pair."
msgstr "和了手に4組の刻子（暗槓を含む）が隠れている場合、5タイ。対子を待っている場合でも、自摸和了でなければならない。"

msgid "5 Tai for having only 23468 of bamboo + green dragon."
msgstr "索子の23468と發のみの手牌で5タイ。"

msgid "5 Tai for having only honor tiles."
msgstr "字牌のみの手牌で5タイ。"

msgid "5 Tai for having only terminal tiles (1s and 9s)."
msgstr "么九牌のみの手牌で5タイ。"

msgid "5 Tai for having seven flowers and drawing the eighth yourself."
msgstr "花牌を7枚持ち、自分で8枚目を引いて和了した場合、5タイ。"

msgid "5 Tai for having seven flowers and winning off of someone declaring an eighth."
msgstr "花牌を7枚持ち、他家が8枚目を宣言したのを槍槓して和了した場合、5タイ。"

msgid "5 Tai for having the sequences 123 456 789 in one suit. If the hand is concealed, this becomes Closed Straight (10 Tai)."
msgstr "同色の123 456 789の順子がある場合、5タイ。門前なら、門前清一気通貫（10タイ）になる。"

msgid "5 Tai for having three triplets (including concealed kongs) hidden in your winning hand."
msgstr "和了手に3組の刻子（暗槓を含む）が隠れている場合、5タイ。"

msgid "5 Tai for having two triplets of wind tiles plus a pair of wind tiles."
msgstr "風牌の刻子2組と風牌の対子1組で5タイ。"

msgid "5 Tai for winning immediately with your initial hand + initial draw (as a non-dealer), or if you win off the dealer's first discard."
msgstr "子として配牌+最初のツモで即座に和了した場合、または親の最初の捨て牌で和了した場合、5タイ。"

msgid "5 Tai for winning immediately with your initial hand as dealer."
msgstr "親として配牌で即座に和了した場合、5タイ。"

msgid "5 Tai for winning when there are at most 10 discards on the table. Tiles claimed by calls do not count towards this total."
msgstr "場に捨て牌が10枚以下の時点で和了した場合、5タイ。副露で取られた牌はこの数に含まれない。"

msgid "5 Tai if you call a kong, then call kong on the replacement tile, then win on that second replacement tile."
msgstr "槓を宣言し、その補充牌でさらに槓を宣言し、2回目の補充牌で和了した場合、5タイ。"

msgid "5 Tai if you have four kongs."
msgstr "槓を4回した場合、5タイ。"

msgid "5 Tai if your hand is concealed and contains 1112345678999 in one suit plus one extra tile in that suit."
msgstr "門前で同色の1112345678999に同種の牌をもう1枚加えた形で5タイ。"

msgid "5 han if your hand contains the same number sequence in all four suits. 6 han if closed."
msgstr "手牌に同じ数字の順子が4種類全てに含まれる場合、5翻。門前なら6翻。"

msgid "5 han if your hand contains the same number triplet in all four suits. Stacks with toitoi."
msgstr "手牌に同じ数字の刻子が4種類全てに含まれる場合、5翻。対々和と複合する。"

msgid "5 han if your hand is comprised of one suit only (no honor tiles). 6 han if closed."
msgstr "手牌が一色のみ（字牌なし）の場合、5翻。門前なら6翻。"

msgid "5-6 Faan"
msgstr "5-6ファン"

msgid "50"
msgstr "50"

msgid "50 嘴 for winning with seven pairs, but one of your pairs is duplicated (you have 4 of a kind)."
msgstr "七対子で、1組の対子が重複している（4枚組が1つある）場合、50嘴。"

msgid "6 Fan"
msgstr "6ファン"

msgid "6 han if your hand has four closed kontsu (mixed triplets) in hand, and you won by completing your pair."
msgstr "手牌に暗刻の混合刻子（コンツ）が4組あり、対子を完成させて和了した場合、6翻。"

msgid "7 Fan"
msgstr "7ファン"

msgid "7-8 Faan"
msgstr "7-8ファン"

msgid "789"
msgstr "789"

msgid "8 Faan"
msgstr "8ファン"

msgid "8 Faan for having both Three Mixed Shifted Sequences and Three Mixed Linked Sequences simulaneously."
msgstr "三色順子（ミックスシフテッド）と三色連順（ミックスリンク）を同時に持つ場合、8ファン。"

msgid "8 Faan for having consecutive triplets in the pattern 111222333. They must all be of different suits."
msgstr "111222333のパターンの連続刻子。3つはすべて異なる種類でなければならない。"

msgid "8 Faan for having something like 123 234 345 456, and their suits cycle: e.g. if it starts with characters, circles, bamboo, the last sequence's suit must be characters again."
msgstr "123 234 345 456のような形で、種類が循環する: 例えば萬子、筒子、索子と始まった場合、最後の順子は萬子でなければならない。"

msgid "8 Faan for having something like 123 345 567 in the same suit."
msgstr "同色の123 345 567のような形で8ファン。"

msgid "8 Faan if all of your sets and your pair contain the same number."
msgstr "すべての面子と対子が同じ数字を含む場合、8ファン。"

msgid "8 Faan if you win before the eighth tile is drawn."
msgstr "8枚目の牌が引かれる前に和了した場合、8ファン。"

msgid "8 Faan if your hand (not calls) use up all eight of two different tiles."
msgstr "手牌（副露は含まない）が2種類の異なる牌をそれぞれ4枚すべて使用している場合、8ファン。"

msgid "8 Fan"
msgstr "8ファン"

msgid "8 Mủn"
msgstr "8ムン"

msgid "9 Fan"
msgstr "9ファン"

msgid "9-10 Faan"
msgstr "9-10ファン"

msgid "A"
msgstr "A"

msgid "A Space Mahjong variant with mixed triplets, more yaku, and more calls."
msgstr "混合刻子、追加の役、追加の副露を特徴とするスペース麻雀のバリアント。"

msgid "A discarded flower acts as an anything-joker, but can only be claimed for a win."
msgstr "捨てられた花牌は万能ジョーカーとして機能するが、和了のためだけに取ることができる。"

msgid "A discarded joker can also only be claimed for a win, but it acts as itself, not an anything-joker."
msgstr "捨てられたジョーカーも和了のためだけに取ることができるが、それは万能ジョーカーとしてではなく、それ自体として機能する。"

msgid "A game's log ID can also be found via the Copy Log button on the upper right."
msgstr "ゲームのログIDは、右上の「ログをコピー」ボタンからも確認できます。"

msgid "A hand with flowers declared cannot earn 1 fan from Concealed Hand."
msgstr "花牌を宣言した手は、門前清による1翻を得られない。"

msgid "A non-dealer player won on their first draw."
msgstr "子のプレイヤーが最初のツモで和了した。"

msgid "A nukidora declaration can be ponned or kanned by another player. The resulting pon/kan does not count as nukidora."
msgstr "抜きドラの宣言は、他家によってポンまたはカンされることがある。その結果のポン/カンは抜きドラとしては数えない。"

msgid "A pair of round+seat winds is worth 4 fu instead of 2 fu."
msgstr "場風と自風の両方である風牌の対子は、2符ではなく4符。"

msgid "A pattern is required to win; you cannot win without a pattern. You can browse these patterns in-game by clicking the tabs on the left."
msgstr "和了には役が必須であり、役なしでは和了できない。ゲーム内で左のタブをクリックしてこれらの役を閲覧できる。"

msgid "A round repeats if the dealer is tenpai at draw."
msgstr "親が流局時にテンパイしている場合、その局は連荘する。"

msgid "A round repeats if the dealer wins."
msgstr "親が和了した場合、その局は連荘する。"

msgid "A ton call is just like pon, but for a pair instead of a triplet. It's usually not useful to call a pair, but doing so is a valid way to rush chiitoitsu (1 han open) in cosmic riichi."
msgstr "トン（対子のポン）はポンと似ているが、刻子ではなく対子を取る。通常、対子を取るのは有用ではないが、コズミック立直では七対子（副露で1翻）を急ぐ有効な手段である。"

msgid "A triple ron ends the game in an abortive draw."
msgstr "三家和了（トリプルロン）が発生した場合、ゲームは途中流局となる。"

msgid "A triplet of blue dragons is yakuhai."
msgstr "青龍の刻子は役牌。"

msgid "A wind kontsu counts as 0.5 han if it contains both the round wind and seat wind. A dragon kontsu is always 0.5 han, and is called mini-sangen. Having two of the same kontsu in a closed hand is 1 han (ryandoukon), having three is 2 han open 3 han closed (sandoukon), and having four is yakuman (yondoukon)."
msgstr "場風と自風の両方を含む風牌の混合刻子（コンツ）は0.5翻。三元牌の混合刻子は常に0.5翻で、ミニ三原と呼ばれる。門前で同じ混合刻子を2組持つと1翻（両同刻）、3組で2翻（副露）3翻（門前）、4組で役満（四同刻）。"

msgid "A winning hand maxes out at 5 Tai, with the exception of the two 10 Tai hands. Riichi Advanced will still calculate all Tai patterns, but score is capped at 5."
msgstr "和了手のタイは最大5タイまで。ただし、2つの10タイ手は例外。リアーチ・アドバンスはすべてのタイパターンを計算するが、スコアは5で上限に達する。"

msgid "A winning hand must be worth at least 2 Tai, not counting flowers/seasons/animals."
msgstr "和了手は最低2タイ必要。花牌・季節牌・動物牌は数えない。"

msgid "A winning hand must be worth at least 4 Tai, which can include flowers/seasons/animals."
msgstr "和了手は最低4タイ必要。花牌・季節牌・動物牌も含めることができる。"

msgid "AMJFE Card (beta)"
msgstr "AMJFEカード（ベータ）"

msgid "AMJS 2026 Card"
msgstr "AMJS 2026カード"

msgid "ATF Card"
msgstr "ATFカード"

msgid "Abortive Draws"
msgstr "途中流局"

msgid "About"
msgstr "このゲームについて"

msgid "Achieving any of the following awards the limit score of 10 Fan (200 points)."
msgstr "以下のいずれかを達成すると、上限スコアの10ファン（200点）が与えられる。"

msgid "Add Blank Flowers"
msgstr "ブランク花牌を追加"

msgid "Add a win condition: start with all four Fei jokers."
msgstr "和了条件を追加: 配牌でフェイジョーカーを4枚持って開始する。"

msgid "Add mixed triplets, or kontsu. If you have the same number in three suits, that counts as one of your sets towards four sets and a pair. For example, 1m1s1p is a kontsu. Also considered kontsu: 3 different winds, or one of each dragon."
msgstr "混合刻子（コンツ）を追加。3種類で同じ数字の刻子を持つ場合、それは4面子1対子の1面子として数える。例: 1m1s1pはコンツ。また、3種類の異なる風牌、または三元牌を1枚ずつ持つ場合もコンツと見なす。"

msgid "Add more sets of jokers to the wall on top of the existing 8. It is recommended to enable No Seven Pairs when playing with extra jokers."
msgstr "既存の8枚に加えて、壁にジョーカーを追加する。追加のジョーカーでプレイする場合は、「七対子なし」を有効にすることを推奨。"

msgid "Add seven pairs as a possible winning hand, worth 4 fan."
msgstr "七対子を和了可能な手として追加。4ファン。"

msgid "Add seven pairs as a win condition, worth 1 Fan."
msgstr "七対子を和了条件として追加。1ファン。"

msgid "Add some UI that shows nearest hands."
msgstr "最も近い手を表示するUIを追加。"

msgid "Add some UI that shows waits."
msgstr "待ちを表示するUIを追加。"

msgid "Add the following calls: Ton (calls a pair), Chon (calls kontsu), and Fuun (calls a set of 4 different winds). The precedence is Ton < Chii < Chon < Fuun < Pon < Kan."
msgstr "以下の副露を追加: トン（対子を取る）、チョン（コンツを取る）、フーン（4種類の異なる風牌を取る）。優先順位はトン < チー < チョン < フーン < ポン < カン。"

msgid "Added Kong"
msgstr "加槓"

msgid "Additional Sevens"
msgstr "追加の7"

msgid "Adds 10m, 10p, and 10s."
msgstr "10m、10p、10sを追加。"

msgid "Adds 10m, 10p, and 10s. Changes dora accordingly (if dora is enabled). Tanyao now allows nines, and chanta/junchan/honroutou require tens instead. 13 Orphans now requires the ten instead of the nine of each suit."
msgstr "10m、10p、10sを追加。ドラもそれに応じて変更される（ドラが有効な場合）。断幺九は9を許可し、混全帯幺九/純全帯幺九/混老頭は10を要求する。国士無双は各色の9の代わりに10を要求する。"

msgid "Adds a copy of the 123 joker, which looks like 小 and can be used as any 1, 2, or 3."
msgstr "123ジョーカーを1枚追加。小のマークで、任意の1、2、3として使用できる。"

msgid "Adds a copy of the 147 joker, which can be used as any 1, 4, or 7."
msgstr "147ジョーカーを1枚追加。任意の1、4、7として使用できる。"

msgid "Adds a copy of the 19 joker, which can be used as any 1 or 9."
msgstr "19ジョーカーを1枚追加。任意の1または9として使用できる。"

msgid "Adds a copy of the 258 joker, which can be used as any 2, 5, or 8."
msgstr "258ジョーカーを1枚追加。任意の2、5、8として使用できる。"

msgid "Adds a copy of the 369 joker, which can be used as any 3, 6, or 9."
msgstr "369ジョーカーを1枚追加。任意の3、6、9として使用できる。"

msgid "Adds a copy of the 37 joker, which can be used as any 3 or 7."
msgstr "37ジョーカーを1枚追加。任意の3または7として使用できる。"

msgid "Adds a copy of the 456 joker, which looks like 中 and can be used as any 4, 5, or 6. Don't confuse it with the red dragon!"
msgstr "456ジョーカーを1枚追加。中のマークで、任意の4、5、6として使用できる。赤中と混同しないように！"

msgid "Adds a copy of the 46 joker, which can be used as any 4 or 6."
msgstr "46ジョーカーを1枚追加。任意の4または6として使用できる。"

msgid "Adds a copy of the 789 joker, which looks like 大 and can be used as any 7, 8, or 9."
msgstr "789ジョーカーを1枚追加。大のマークで、任意の7、8、9として使用できる。"

msgid "Adds a copy of the even joker, which looks like 雙 and can be used as any even number tile."
msgstr "偶数ジョーカーを1枚追加。雙のマークで、任意の偶数牌として使用できる。"

msgid "Adds a copy of the five/honors joker, which looks like 伍番 and can be used as any five or any honor tile."
msgstr "5/字牌ジョーカーを1枚追加。伍番のマークで、任意の5または任意の字牌として使用できる。"

msgid "Adds a copy of the kanchan/honors joker, which looks like 卡番 and can be used as any honor tile, but can also be used as the middle tile in any sequence."
msgstr "嵌張/字牌ジョーカーを1枚追加。卡番のマークで、任意の字牌として機能し、任意の順子の中間牌としても使用できる。"

msgid "Adds a copy of the odd joker, which looks like 單 and can be used as any odd number tile."
msgstr "奇数ジョーカーを1枚追加。單のマークで、任意の奇数牌として使用できる。"

msgid "Adds a fifth copy of every standard tile."
msgstr "すべての標準牌に5枚目を追加。"

msgid "Adds a fixed undoubled bonus of 5 or 6 points for each quad."
msgstr "各槓に対して、倍付けされない固定ボーナス5または6点を追加。"

msgid "Adds a fixed undoubled bonus of 6 or 10 points for each mủn."
msgstr "各ムンに対して、倍付けされない固定ボーナス6または10点を追加。"

msgid "Adds a fourth suit (stars)."
msgstr "4番目の種類（星牌）を追加。"

msgid "Adds a fourth suit (stars). Can combine with Ten mod."
msgstr "4番目の種類（星牌）を追加。テンモッドと組み合わせることができる。"

msgid "Adds a requirement of having 5 points in hand in order to win."
msgstr "和了するために、手牌に5点必要という条件を追加。"

msgid "Adds a single manzu joker to the game. The manzu joker looks like 萬 and can represent any character tile."
msgstr "萬子ジョーカーを1枚追加。萬のマークで、任意の萬子を表す。"

msgid "Adds a single pinzu joker to the game. The pinzu joker looks like 筒 and can represent any character tile."
msgstr "筒子ジョーカーを1枚追加。筒のマークで、任意の筒子を表す。"

msgid "Adds a single souzu joker to the game. The souzu joker looks like 索 and can represent any character tile."
msgstr "索子ジョーカーを1枚追加。索のマークで、任意の索子を表す。"

msgid "Adds aka nines, worth 1 han each."
msgstr "赤9を追加。各1翻。"

msgid "Adds aka ones, worth 1 han each."
msgstr "赤1を追加。各1翻。"

msgid "Adds aka sevens, worth 1 han each."
msgstr "赤7を追加。各1翻。"

msgid "Adds aka threes, worth 1 han each."
msgstr "赤3を追加。各1翻。"

msgid "Adds bonuses for obtaining 7 or 8 flowers. You can also allow instant win upon obtaining 7 or 8 flowers."
msgstr "花牌を7枚または8枚集めた場合のボーナスを追加。7枚または8枚集めた時点で即座に和了を許可することもできる。"

msgid "Adds eight jokers to the game. See the Vietnamese ruleset to learn how they work. Note that this mod adds a honors joker instead of a flower joker."
msgstr "ゲームにジョーカーを8枚追加。その機能についてはベトナムのルールセットを参照。このモッドは花ジョーカーの代わりに字牌ジョーカーを追加することに注意。"

msgid "Adds flower tiles to the game. Declaring flowers that match your seat is worth 4 points each, otherwise it's 2 points each. Completing a full set (1234) of either the flowers or the searcons is worth 10 points."
msgstr "花牌をゲームに追加。自風に対応する花牌の宣言は各4点、それ以外は各2点。花牌または季節牌の完全なセット（1234）を完成させると10点。"

msgid "Adds some \\\"Zombie Blanks\\\" to the wall, which may be swapped out for already-discarded tiles."
msgstr "壁に「ゾンビブランク」を追加。既に捨てられた牌と交換できる。"

msgid "Adds the Chinese blue-framed white dragon as a fourth dragon tile (hakuban). Yaku treats it as an honor tile. Shousangen is reduced to 1 han (+2 from dragons) and Daisangen is reduced to 2 han (+3 from dragons). Adds Shousuugen (3 dragons + dragon pair) as yakuman and Daisuugen (4 dragons) as double yakuman."
msgstr "中国の青枠の白板を4番目の三元牌（白版）として追加。役はこれを字牌として扱う。小三元は1翻（三元牌から+2翻）に、大三元は2翻（三元牌から+3翻）に減少。小四喜（3種類の三元牌+三元牌の対子）を役満として、大四喜（4種類の三元牌）をダブル役満として追加。"

msgid "Adds the requirement that Seven Pairs is completed by self-draw. (Useful when playing with more than 8 jokers.)"
msgstr "七対子を自摸和了のみで完成させるという条件を追加。（8枚以上のジョーカーでプレイする場合に有用。）"

msgid "After 1 or more repeats, winning requires a minimum of 1 han."
msgstr "1回以上の連荘後は、和了に最低1翻が必要。"

msgid "After Multiple Gongs"
msgstr "複数回の槓の後"

msgid "After Multiple Kongs"
msgstr "複数回の槓の後"

msgid "After a Flower"
msgstr "花牌の後"

msgid "After a Gong"
msgstr "槓の後"

msgid "After a Kong"
msgstr "槓の後"

msgid "After a concealed win, flip tiles on the wall starting from the visible dora indicator, and gain chips for each matching tile. Repeat until you get no match. Not recommended with joker mods, since it will flip tiles forever."
msgstr "門前での和了後、表示されているドラ表示牌から始めて壁の牌をめくり、一致する牌ごとにチップを獲得する。一致がなくなるまで繰り返す。ジョーカーモッドとは相性が悪い。無限にめくれてしまうため。"

msgid "After a player wins, the remaining players at the table continue to play. The game ends either when three players have won, or there are no more tiles in the wall."
msgstr "プレイヤーが和了した後、残りのプレイヤーはゲームを続行する。ゲームは3人のプレイヤーが和了した時点、または壁に牌がなくなった時点で終了する。"

msgid "After a round, if anyone has less than %{below} points, the game ends."
msgstr "局終了後、いずれかのプレイヤーが%{below}点未満の場合、ゲームは終了する。"

msgid "After a round, if anyone has more than %{above} points, the game ends."
msgstr "局終了後、いずれかのプレイヤーが%{above}点を超えた場合、ゲームは終了する。"

msgid "After a win, you can hover over (or tap) players and arrows in the point exchange screen to view a detailed summary of that transaction."
msgstr "和了後、点数交換画面でプレイヤーや矢印にカーソルを合わせる（またはタップする）と、その取引の詳細な要約を表示できます。"

msgid "After all flowers have been declared, the \\\"gold tile\\\" is revealed (top left)."
msgstr "すべての花牌が宣言された後、「金の牌」が公開される（左上）。"

msgid "After issuing a challenge (or passing), you can see your hand and the game begins."
msgstr "チャレンジを発行（またはパス）した後、手牌を見てゲームが始まる。"

msgid "After someone calls a win, hover over the winning hand to see how it breaks into sets. (On mobile: tap the winning hand.)"
msgstr "誰かが和了した後、和了手にカーソルを合わせると、面子への分解が表示される。（モバイル: 和了手をタップ）"

